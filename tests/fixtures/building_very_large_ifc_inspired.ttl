@prefix fbo: <http://example.org/fbo/1.0/> .
@prefix ex: <https://firebim.org/examples/buildings/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:site-vlarge a fbo:Site ;
    fbo:Name "Very Large Test Site" ;
    fbo:FireExit true ;
    fbo:hasBuilding ex:building-vlarge-1, ex:building-vlarge-2, ex:building-vlarge-3, ex:building-vlarge-4, ex:building-vlarge-5, ex:building-vlarge-6 .

ex:building-vlarge-1 a fbo:Building ;
    fbo:Name "Very Large Building 1" ;
    fbo:FireRating "R60" ;
    fbo:BuildingHeight "24.0"^^xsd:decimal ;
    fbo:hasStorey ex:storey-vlarge-1-01, ex:storey-vlarge-1-02, ex:storey-vlarge-1-03, ex:storey-vlarge-1-04, ex:storey-vlarge-1-05, ex:storey-vlarge-1-06 .

ex:storey-vlarge-1-01 a fbo:Storey ;
    fbo:Name "Building 1 Storey 1" ;
    fbo:StoreyNumber 1 ;
    fbo:hasZone ex:zone-vlarge-1-01-a, ex:zone-vlarge-1-01-b, ex:zone-vlarge-1-01-c ;
    fbo:hasStair ex:stair-vlarge-1-main, ex:stair-vlarge-1-escape ;
