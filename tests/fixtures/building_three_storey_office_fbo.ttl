# Six fire compartments and one representative boundary for each compartment.
ex:fc-g-west
    a fbo:FireCompartment, fbo-dk:FireCompartment ;
    rdfs:label "Ground west fire compartment"@en ;
    fbo-dk:AreaFireCompartment "180.0"^^xsd:float ;
    fbo-dk:NumberOccupantsSpaceCompartment "56"^^xsd:float ;
    fbo-dk:UseCategory "AK2" ;
    fbo-dk:SeparationFire ex:wall-g-west ;
    fbo:hasSubitem ex:g-corridor, ex:g-stair, ex:g-printer, ex:g-open-office .

ex:fc-g-east
    a fbo:FireCompartment, fbo-dk:FireCompartment ;
    rdfs:label "Ground east fire compartment"@en ;
    fbo-dk:AreaFireCompartment "98.0"^^xsd:float ;
    fbo-dk:NumberOccupantsSpaceCompartment "44"^^xsd:float ;
    fbo-dk:UseCategory "AK3" ;
    fbo-dk:SeparationFire ex:wall-g-east ;
    fbo:hasSubitem ex:g-lift, ex:g-toilet, ex:g-reception, ex:g-meeting .

ex:fc-f-west
    a fbo:FireCompartment, fbo-dk:FireCompartment ;
    rdfs:label "First west fire compartment"@en ;
    fbo-dk:AreaFireCompartment "123.0"^^xsd:float ;
    fbo-dk:NumberOccupantsSpaceCompartment "45"^^xsd:float ;
    fbo-dk:UseCategory "AK2" ;
    fbo-dk:SeparationFire ex:wall-f-west ;
    fbo:hasSubitem ex:f-corridor, ex:f-stair, ex:f-printer, ex:f-private-office, ex:f-meeting .

ex:fc-f-east
    a fbo:FireCompartment, fbo-dk:FireCompartment ;
    rdfs:label "First east fire compartment"@en ;
    fbo-dk:AreaFireCompartment "174.0"^^xsd:float ;
    fbo-dk:NumberOccupantsSpaceCompartment "50"^^xsd:float ;
    fbo-dk:UseCategory "AK2" ;
    fbo-dk:SeparationFire ex:wall-f-east ;
    fbo:hasSubitem ex:f-lift, ex:f-toilet, ex:f-open-office .

ex:fc-s-office
    a fbo:FireCompartment, fbo-dk:FireCompartment ;
    rdfs:label "Second office fire compartment"@en ;
    fbo-dk:AreaFireCompartment "138.0"^^xsd:float ;
    fbo-dk:NumberOccupantsSpaceCompartment "110"^^xsd:float ;
    fbo-dk:UseCategory "AK3" ;
    fbo-dk:SeparationFire ex:wall-s-office ;
    fbo:hasSubitem ex:s-corridor, ex:s-stair, ex:s-lift, ex:s-toilet, ex:s-printer, ex:s-boardroom .

ex:fc-s-canteen
    a fbo:FireCompartment, fbo-dk:FireCompartment ;
    rdfs:label "Second canteen fire compartment"@en ;
    fbo-dk:AreaFireCompartment "265.0"^^xsd:float ;
    fbo-dk:NumberOccupantsSpaceCompartment "110"^^xsd:float ;
    fbo-dk:UseCategory "AK3" ;
    fbo-dk:FireHazardSpecial ex:hazard-cooking-oil ;
    fbo-dk:SeparationFire ex:wall-s-canteen ;
    fbo:hasSubitem ex:s-canteen, ex:s-kitchen, ex:s-storage .

ex:wall-g-west
    a fbo:BoundaryFireCompartment, fbo-dk:BoundaryFireCompartment ;
    fbo-dk:FireResistance "60.0"^^xsd:float ;
    fbo-dk:WalltypeCompartmentFirewall ex:wall-type-ei60 ;
    fbo-dk:PassiveFireProtection ex:passive-protection-package .

ex:wall-g-east
    a fbo:BoundaryFireCompartment, fbo-dk:BoundaryFireCompartment ;
    fbo-dk:FireResistance "60.0"^^xsd:float ;
    fbo-dk:WalltypeCompartmentFirewall ex:wall-type-ei60 ;
    fbo-dk:PassiveFireProtection ex:passive-protection-package .

ex:wall-f-west
    a fbo:BoundaryFireCompartment, fbo-dk:BoundaryFireCompartment ;
    fbo-dk:FireResistance "60.0"^^xsd:float ;
    fbo-dk:WalltypeCompartmentFirewall ex:wall-type-ei60 ;
    fbo-dk:PassiveFireProtection ex:passive-protection-package .

ex:wall-f-east
    a fbo:BoundaryFireCompartment, fbo-dk:BoundaryFireCompartment ;
    fbo-dk:FireResistance "60.0"^^xsd:float ;
    fbo-dk:WalltypeCompartmentFirewall ex:wall-type-ei60 ;
    fbo-dk:PassiveFireProtection ex:passive-protection-package .

ex:wall-s-office
    a fbo:BoundaryFireCompartment, fbo-dk:BoundaryFireCompartment ;
    fbo-dk:FireResistance "60.0"^^xsd:float ;
    fbo-dk:WalltypeCompartmentFirewall ex:wall-type-ei60 ;
