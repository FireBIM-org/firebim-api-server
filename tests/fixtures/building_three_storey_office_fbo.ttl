# Second storey: nine spaces, including canteen and production kitchen.
ex:s-corridor
    rdfs:label "S01 Central corridor"@en ;
    fbo:hasRemarks "Runs along the centre line from the west stair to the east lift."@en ;
    fbo-dk:AreaFloorRoom "34.0"^^xsd:float ;
    fbo-dk:AreaFreespace "28.0"^^xsd:float ;
    fbo-dk:RoomfunctionEscaperouteCorridor true ;
    fbo-dk:RoomOccupancy false ;
