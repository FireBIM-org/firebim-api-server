ex:wall-s-canteen
    a fbo:BoundaryFireCompartment, fbo-dk:BoundaryFireCompartment ;
    fbo-dk:FireResistance "60.0"^^xsd:float ;
    fbo-dk:WalltypeCompartmentFirewall ex:wall-type-ei60 ;
    fbo-dk:PassiveFireProtection ex:passive-protection-package .

ex:wall-type-ei60 rdfs:label "EI 60 compartment wall"@en .
ex:hazard-cooking-oil rdfs:label "Commercial cooking oil fire hazard"@en .
ex:kitchen-suppression rdfs:label "Wet-chemical cooking hood suppression"@en .

# Egress resources.
ex:stair-core-west
    rdfs:label "Protected west stair core"@en ;
    fbo-dk:RoomfunctionEscapestaircase true ;
    fbo-dk:FireResistance "60.0"^^xsd:float .

ex:route-ground
    rdfs:label "Primary route to the protected west stair and ground exit"@en ;
    fbo-dk:EscapeRoute true ;
    fbo-dk:EvacuationRoutePrimary true ;
    fbo-dk:WidthFreeEvacuationroutes ex:route-width ;
    fbo-dk:SystemIndependentEvacuationRoute ex:stair-core-west ;
    fbo-dk:DoorIndependentExitdoors ex:door-west-exit .

ex:route-first
    rdfs:label "Primary route to the protected west stair and ground exit"@en ;
    fbo-dk:EscapeRoute true ;
    fbo-dk:EvacuationRoutePrimary true ;
    fbo-dk:WidthFreeEvacuationroutes ex:route-width ;
    fbo-dk:SystemIndependentEvacuationRoute ex:stair-core-west ;
    fbo-dk:DoorIndependentExitdoors ex:door-west-exit .

ex:route-second
    rdfs:label "Primary route to the protected west stair and ground exit"@en ;
    fbo-dk:EscapeRoute true ;
    fbo-dk:EvacuationRoutePrimary true ;
    fbo-dk:WidthFreeEvacuationroutes ex:route-width ;
    fbo-dk:SystemIndependentEvacuationRoute ex:stair-core-west ;
    fbo-dk:DoorIndependentExitdoors ex:door-west-exit .

ex:route-width
    rdfs:label "Route clear width"@en ;
    fbo:UsefulWidth "1.8"^^xsd:float .

ex:door-west-exit
    a fbo:DoorExit, fbo:DoorEscaperoute, fbo-dk:DoorExit, fbo-dk:DoorEscaperoute ;
    rdfs:label "West protected-stair exit door"@en ;
    fbo-dk:WidthFreeDoors "1.2"^^xsd:float ;
    fbo:SelfClosing true ;
    fbo:SwingDirection "outward" ;
    fbo-dk:FireResistance "60.0"^^xsd:float .

ex:ground-exit
    a fbo:Exit, fbo-dk:Exit ;
    rdfs:label "Ground-floor final exit"@en ;
    fbo-dk:SystemIndependentExit ex:door-west-exit .

ex:exit-lighting
    rdfs:label "Maintained escape-route lighting"@en ;
    fbo-dk:ActiveFireProtection ex:alarm-system .

ex:panic-lighting
    rdfs:label "Anti-panic lighting"@en ;
    fbo-dk:ActiveFireProtection ex:alarm-system .
