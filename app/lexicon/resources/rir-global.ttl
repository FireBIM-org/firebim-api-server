    skos:definition "A reflux valve, also known as a check valve or non-return valve, allows fluid (liquid or gas) to flow through it in only one direction." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "Valve.REFLUXVALVE" ;
    meta:versionDateUtc "2026-03-25" .

