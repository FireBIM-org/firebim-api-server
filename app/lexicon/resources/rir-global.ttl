    rdfs:subClassOf <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcDistributionSystem> ;
    skos:definition "A smoke purging system is designed to extract smoke from indoor areas after a fire has been extinguished. Unlike active fire control systems, it doesn’t fight the fire directly. Instead, its purpose is to quickly clear smoke, which can be as dangerous as the fire itself." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "DistributionSystem.SMOKEPURGING" ;
    meta:versionDateUtc "2026-03-25" .

