rir:Alarm_FIREALARMPANEL a owl:Class ;
    rdfs:label "Fire alarm panel" ;
    rdfs:comment "This is a subclass (PredefinedType) of IfcAlarm." ;
    rdfs:subClassOf <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcAlarm> ;
    skos:definition "A fire alarm control panel (FACP), also known as a fire alarm control unit (FACU), fire indicator panel (FIP), or simply a fire alarm panel, serves as the central command hub of a fire alarm system." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "Alarm.FIREALARMPANEL" ;
    meta:versionDateUtc "2026-03-25" .

rir:Alarm_HOMEFIREALARMDEVICE a owl:Class ;
    rdfs:label "Home fire alarm device" ;
    rdfs:comment "This is a subclass (PredefinedType) of IfcAlarm." ;
    rdfs:subClassOf <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcAlarm> ;
    skos:definition "A Home Fire Alarm Device (HFAD) is an automatic smoke or heat detector designed to provide early warning of a fire by sounding an alarm and alerting the occupants." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "Alarm.HOMEFIREALARMDEVICE" ;
    meta:versionDateUtc "2026-03-25" .

rir:Alarm_MANUALALARMCALLPOINT a owl:Class ;
    rdfs:label "Manual alarm call point" ;
    rdfs:comment "This is a subclass (PredefinedType) of IfcAlarm." ;
    rdfs:subClassOf <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcAlarm> ;
    skos:definition "An Manual Call Point is essentially a small box mounted on a wall. It contains a button or lever that allows you to manually trigger the fire alarm." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "Alarm.MANUALALARMCALLPOINT" ;
    meta:versionDateUtc "2026-03-25" .

rir:Alarm_SOUNDER a owl:Class ;
    rdfs:label "Sounder" ;
    rdfs:comment "This is a subclass (PredefinedType) of IfcAlarm." ;
    rdfs:subClassOf <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcAlarm> ;
    skos:definition "A fire alarm sounder is an essential safety device designed to alert occupants of a building in the event of a fire or other emergency. Its primary function is to produce a loud sound to warn people to evacuate the building. It can be bell, horn, siren, etc." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "Alarm.SOUNDER" ;
    meta:versionDateUtc "2026-03-25" .

rir:Alarm_VISUALALARM a owl:Class ;
    rdfs:label "Visual alarm" ;
    rdfs:comment "This is a subclass (PredefinedType) of IfcAlarm." ;
    rdfs:subClassOf <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/IfcAlarm> ;
    skos:definition "A visual alarm is a safety device designed to provide visual alerts during emergencies. Unlike traditional audible alarms that rely on sound, visual alarms use flashing lights to convey critical information. It can be flashing strobes, LED lights, or illuminated signs." ;
    meta:activationDateUtc "2024-11-11" ;
    meta:classType "Class" ;
    meta:sourceCode "Alarm.VISUALALARM" ;
    meta:versionDateUtc "2026-03-25" .

