ifc:ThresholdDepth a owl:DatatypeProperty ;
    rdfs:label "Threshold Depth" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Depth]] (dimension in plane perpendicular to door leaf) of the door threshold. Only given if the door lining includes a threshold. If omitted (and with a given value to threshold thickness) it indicates an adjustable depth (i.e. a depth that adjusts to the thickness of the wall into which the occurrence of this door style is inserted)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ThresholdDepth" .

ifc:ThresholdOffset a owl:DatatypeProperty ;
    rdfs:label "Threshold Off Set" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Offset (dimension in plane perpendicular to door leaf) of the door threshold. The offset is given as distance to the x axis of the local placement. Only given if the door lining includes a threshold and the parameter is known." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ThresholdOffset" .

ifc:ThresholdThickness a owl:DatatypeProperty ;
    rdfs:label "Threshold Thickness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNonNegativeLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition ". If [[ThresholdThickness]] value is 0. (zero) it denotes a door without a threshold ([[ThresholdDepth]] shall be set to NIL in this case). If the [[ThresholdThickness]] is NIL it denotes that the information about a threshold is not available." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ThresholdThickness" .

ifc:Throw a owl:ObjectProperty ;
    rdfs:label "Throw" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Distance cooled beam throws the air." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Throw" .

ifc:ThrowLength a owl:DatatypeProperty ;
    rdfs:label "Throw Length" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The horizontal or vertical axial distance an airstream travels after leaving an AirTerminal before the maximum stream velocity is reduced to a specified terminal velocity under isothermal conditions at the upper value of the AirFlowrateRange." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ThrowLength" .

