    rdfs:label "Pile" ;
    rdfs:subClassOf ifc:IfcDeepFoundation ;
    skos:definition "A pile is a slender timber, concrete, or steel structural element, driven, jetted, or otherwise embedded on end in the ground for the purpose of supporting a load. A pile is also characterized as deep foundation, where the loads are transferred to deeper subsurface layers." ;
