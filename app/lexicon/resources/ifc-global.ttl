ifc:IfcDuctSilencer a owl:Class ;
    rdfs:label "Duct Silencer" ;
    rdfs:subClassOf ifc:IfcFlowTreatmentDevice ;
    skos:definition "A duct silencer is a device that is typically installed inside a duct distribution system for the purpose of reducing the noise levels from air movement, fan noise, etc. in the adjacent space or downstream of the duct silencer device." ;
