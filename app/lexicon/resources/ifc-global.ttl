    rdfs:range xsd:integer ;
    skos:definition "The total number of through lanes on the segment. This excludes auxiliary lanes, parking and turning lanes, acceleration/deceleration lanes, toll collection lanes, shoulders etc." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "NumberOfThroughLanes" .

ifc:NumberOfTrackCenters a owl:DatatypeProperty ;
