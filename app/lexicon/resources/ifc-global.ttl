ifc:IfcRailwayPartSUBSTRUCTURE a owl:Class ;
    rdfs:label "Sub Structure" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
