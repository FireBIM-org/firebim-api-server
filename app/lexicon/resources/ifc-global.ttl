ifc:IfcCableCarrierFitting a owl:Class ;
    rdfs:label "Cable Carrier Fitting" ;
    rdfs:subClassOf ifc:IfcFlowFitting ;
    skos:definition "A cable carrier fitting is a fitting that is placed at junction or transition in a cable carrier system." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:AcceptanceDate_from_InstallationOccurrence,
        ifc:AccidentResponse_from_MaintenanceStrategy,
        ifc:AcquisitionDate_from_ManufacturerOccurrence,
        ifc:ArticleNumber_from_ManufacturerTypeInformation,
        ifc:AssemblyPlace_from_ManufacturerOccurrence,
        ifc:AssemblyPlace_from_ManufacturerTypeInformation,
        ifc:AssessmentCondition_from_Condition,
        ifc:AssessmentDate_from_Condition,
