    rdfs:comment "Technical note: in IFC this property takes 'IfcThermodynamicTemperatureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Temperature]] rating." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TemperatureRating" .

ifc:TemperatureSensorType a owl:DatatypeProperty ;
    rdfs:label "Temperature Sensor Type" ;
    rdfs:range xsd:string ;
    skos:definition "Enumeration that Identifies the types of temperature sensor that can be specified." ;
    meta:allowedValue "{'Code': 'HIGHLIMIT', 'Value': 'HIGHLIMIT', 'Description': 'High Limit'}",
        "{'Code': 'LOWLIMIT', 'Value': 'LOWLIMIT', 'Description': 'Lowlimit'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OPERATINGTEMPERATURE', 'Value': 'OPERATINGTEMPERATURE', 'Description': 'Operating [[Temperature]]'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'OUTSIDETEMPERATURE', 'Value': 'OUTSIDETEMPERATURE', 'Description': 'Out [[Side]] [[Temperature]]'}",
        "{'Code': 'ROOMTEMPERATURE', 'Value': 'ROOMTEMPERATURE', 'Description': 'Room [[Temperature]]'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TemperatureSensorType" .

