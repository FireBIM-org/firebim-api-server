ifc:I1 a owl:DatatypeProperty ;
    rdfs:label "I1" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The (thermal) lower testing current limit in x In, indicating that for currents lower than I1, the tripping time shall be longer than the associated tripping time, T2." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "I1" .

ifc:I2 a owl:DatatypeProperty ;
    rdfs:label "I2" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The (thermal) upper testing current limit in x In, indicating that for currents larger than I2, the tripping time shall be shorter than the associated tripping time, T2." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "I2" .

ifc:I2TApplicability a owl:DatatypeProperty ;
    rdfs:label "I2Tapplicability" ;
    rdfs:range xsd:string ;
    skos:definition "The applicability of the time adjustment related to the tripping function." ;
    meta:allowedValue "{'Code': 'LIST', 'Value': 'LIST', 'Description': 'List'}",
        "{'Code': 'RANGE', 'Value': 'RANGE', 'Description': '[[Range]]'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "I2TApplicability" .

ifc:I4 a owl:DatatypeProperty ;
    rdfs:label "I4" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The lower electromagnetic testing current limit in x In, indicating that for currents lower than I4, the tripping time shall be longer than the associated tripping time, T5, i.e. the device shall not trip instantaneous." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "I4" .

ifc:I5 a owl:DatatypeProperty ;
    rdfs:label "I5" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The upper electromagnetic testing current limit in x In, indicating that for currents larger than I5, the tripping time shall be shorter than or equal to the associated tripping time, T5, i.e. the device shall trip instantaneous." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "I5" .

