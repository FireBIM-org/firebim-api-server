ifc:IfcFlowMovingDevice a owl:Class ;
    rdfs:label "Flow Moving Device" ;
    rdfs:subClassOf ifc:IfcDistributionFlowElement ;
    skos:definition "The distribution flow element [[IfcFlowMovingDevice]] defines the occurrence of an apparatus used to distribute, circulate or perform conveyance of fluids, including liquids and gases (such as a pump or fan), and typically participates in a flow distribution system. Its type is defined by IfcFlowMovingDeviceType or its subtypes." ;
