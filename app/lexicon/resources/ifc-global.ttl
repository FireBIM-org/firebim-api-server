        "{'Code': 'SINGLE', 'Value': 'SINGLE', 'Description': 'Single'}",
        "{'Code': 'SYSTEM_SEPARATION_CANTILEVER', 'Value': 'SYSTEM_SEPARATION_CANTILEVER', 'Description': '[[System]] Separation Cantilever'}",
