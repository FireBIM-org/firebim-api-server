    skos:definition "[[Power]] factor of the minimum 1 pole short circuit current provided at the point of supply i.e. the fault between 1 phase and N." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ShortCircuit1PolePowerFactorMinimumState" .

