ifc:LampBallastType a owl:DatatypeProperty ;
    rdfs:label "Lamp Ballast Type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of ballast used to stabilise gas discharge by limiting the current during operation and to deliver the necessary striking voltage for starting. Ballasts are needed to operate Discharge Lamps such as Fluorescent, Compact Fluorescent, High-pressure Mercury, Metal Halide and High-pressure Sodium Lamps.; Magnetic ballasts are chokes which limit the current passing through a lamp connected in series on the principle of self-induction. The resultant current and power are decisive for the efficient operation of the lamp. A specially designed ballast is required for every type of lamp to comply with lamp rating in terms of Luminous Flux, Color Appearance and service life. The two types of magnetic ballasts for fluorescent lamps are KVG Conventional (EC-A series) and VVG Low-loss ballasts (EC-B series). Low-loss ballasts have a higher efficiency, which means reduced ballast losses and a lower thermal load. Electronic ballasts are used to run fluorescent lamps at high frequencies (approx. 35 - 40 kHz)." ;
    meta:allowedValue "{'Code': 'CONVENTIONAL', 'Value': 'CONVENTIONAL', 'Description': 'The two types of magnetic ballasts for fluorescent lamps are KVG Conventional (EC-A series) and VVG Low-loss ballasts (EC-B series)'}",
        "{'Code': 'ELECTRONIC', 'Value': 'ELECTRONIC', 'Description': 'Electronic ballasts are used to run fluorescent lamps at high frequencies (approx'}",
        "{'Code': 'LOWLOSS', 'Value': 'LOWLOSS', 'Description': 'Low Loss'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RESISTOR', 'Value': 'RESISTOR', 'Description': 'Resistor'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LampBallastType" .

ifc:LampCompensationType a owl:DatatypeProperty ;
    rdfs:label "Lamp Compensation Type" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the form of compensation used for power factor correction and radio suppression." ;
    meta:allowedValue "{'Code': 'CAPACITIVE', 'Value': 'CAPACITIVE', 'Description': 'Capacitive'}",
        "{'Code': 'INDUCTIVE', 'Value': 'INDUCTIVE', 'Description': 'Inductive'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LampCompensationType" .

ifc:LampMaintenanceFactor a owl:DatatypeProperty ;
    rdfs:label "Lamp Maintenance Factor" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Non recoverable losses of luminous flux of a lamp due to lamp depreciation; i.e. the decreasing of light output of a luminaire due to aging and dirt." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LampMaintenanceFactor" .

