ifc:IfcControl a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf ifc:IfcObject ;
    skos:definition "[[IfcControl]] is the abstract generalization of all concepts that control or constrain the utilization of products, processes, or resources in general. It can be seen as a regulation, cost schedule, request or order, or other requirements applied to a product, process or resource whose requirements and provisions must be fulfilled." ;
    meta:classType "Class" ;
