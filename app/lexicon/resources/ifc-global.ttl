ifc:FaucetFunction a owl:DatatypeProperty ;
    rdfs:label "Faucet Function" ;
    rdfs:range xsd:string ;
    skos:definition "Defines the operating temperature of a faucet that may be specified." ;
    meta:allowedValue "{'Code': 'COLD', 'Value': 'COLD', 'Description': 'Cold'}",
        "{'Code': 'HOT', 'Value': 'HOT', 'Description': 'Hot'}",
        "{'Code': 'MIXED', 'Value': 'MIXED', 'Description': 'Mixed'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FaucetFunction" .

ifc:FaucetOperation a owl:DatatypeProperty ;
    rdfs:label "Faucet Operation" ;
    rdfs:range xsd:string ;
    skos:definition "Quick action faucet with a ceramic seal to open or close the orifice; .;Quick action faucet that is operated by a lever handle; .; Self closing faucet that does not induce surge pressure; .;Quick action faucet that can be fully opened or shut by turning the operating mechanism through 90 degrees.;Faucet that can be opened or closed fully with a single small movement of the operating mechanism; .;Faucet in which a plate or disc is moved, by the rotation of a screwed spindle, to close or open the orifice.;Faucet that is opened by pressure of the top of an operating spindle and is closed under the action of a spring or weight when the pressure is released.; Self closing faucet that discharges for a predetermined period of time; ." ;
    meta:allowedValue "{'Code': 'CERAMICDISC', 'Value': 'CERAMICDISC', 'Description': 'Quick action faucet with a ceramic seal to open or close the orifice'}",
        "{'Code': 'LEVERHANDLE', 'Value': 'LEVERHANDLE', 'Description': 'Quick action faucet that is operated by a lever handle'}",
        "{'Code': 'NONCONCUSSIVESELFCLOSING', 'Value': 'NONCONCUSSIVESELFCLOSING', 'Description': 'Self closing faucet that does not induce surge pressure'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'QUARTERTURN', 'Value': 'QUARTERTURN', 'Description': 'Quick action faucet that can be fully opened or shut by turning the operating mechanism through 90 degrees'}",
        "{'Code': 'QUICKACTION', 'Value': 'QUICKACTION', 'Description': 'Faucet that can be opened or closed fully with a single small movement of the operating mechanism'}",
        "{'Code': 'SCREWDOWN', 'Value': 'SCREWDOWN', 'Description': 'Faucet in which a plate or disc is moved'}",
        "{'Code': 'SELFCLOSING', 'Value': 'SELFCLOSING', 'Description': 'Self closing faucet that does not induce surge pressure'}",
        "{'Code': 'TIMEDSELFCLOSING', 'Value': 'TIMEDSELFCLOSING', 'Description': 'Self closing faucet that discharges for a predetermined period of time'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FaucetOperation" .

ifc:FaucetTopDescription a owl:DatatypeProperty ;
    rdfs:label "Faucet Top Description" ;
    rdfs:range xsd:string ;
    skos:definition "[[Description]] of the operating mechanism/top of the faucet." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FaucetTopDescription" .

ifc:FaucetType a owl:DatatypeProperty ;
    rdfs:label "Faucet Type" ;
    rdfs:range xsd:string ;
    skos:definition "Faucet with a horizontal inlet and a nozzle that discharges downwards.; Faucet fitted through the end of a bath, with a horizontal inlet, a partially spherical body and a vertical nozzle.; Combination faucet assembly with a valve to enable the flow of mixed water to be transferred to a showerhead.; Combination faucet assembly in which hot and cold water are kept separate until emerging from a common nozzle; .; Faucet that has a vertical inlet and a nozzle that discharges downwards; .; SingleOutletCombination = Combination faucet assembly in which hot and cold water mix before emerging from a common nozzle; .; Faucet with a spray outlet; .; Spray faucet connected to hot and cold water supplies that delivers water at a temperature determined during use." ;
    meta:allowedValue "{'Code': 'BIB', 'Value': 'BIB', 'Description': 'Faucet with a horizontal inlet and a nozzle that discharges downwards'}",
        "{'Code': 'DIVERTER', 'Value': 'DIVERTER', 'Description': 'Combination faucet assembly with a valve to enable the flow of mixed water to be transferred to a showerhead'}",
        "{'Code': 'DIVIDEDFLOWCOMBINATION', 'Value': 'DIVIDEDFLOWCOMBINATION', 'Description': 'Combination faucet assembly in which hot and cold water are kept separate until emerging from a common nozzle'}",
        "{'Code': 'GLOBE', 'Value': 'GLOBE', 'Description': 'Faucet fitted through the end of a bath'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PILLAR', 'Value': 'PILLAR', 'Description': 'Faucet that has a vertical inlet and a nozzle that discharges downwards'}",
        "{'Code': 'SINGLEOUTLETCOMBINATION', 'Value': 'SINGLEOUTLETCOMBINATION', 'Description': 'SingleOutletCombination = Combination faucet assembly in which hot and cold water mix before emerging from a common nozzle'}",
        "{'Code': 'SPRAY', 'Value': 'SPRAY', 'Description': 'Faucet with a spray outlet'}",
        "{'Code': 'SPRAYMIXING', 'Value': 'SPRAYMIXING', 'Description': 'Spray faucet connected to hot and cold water supplies that delivers water at a temperature determined during use'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FaucetType" .

ifc:FaultPriorityType a owl:DatatypeProperty ;
    rdfs:label "Fault Priority Type" ;
    rdfs:range xsd:string ;
    skos:definition "action is required urgently.;action can occur within a reasonable period of time.;action can occur when convenient." ;
    meta:allowedValue "{'Code': 'HIGH', 'Value': 'HIGH', 'Description': 'action is required urgently'}",
        "{'Code': 'LOW', 'Value': 'LOW', 'Description': 'action can occur when convenient'}",
        "{'Code': 'MEDIUM', 'Value': 'MEDIUM', 'Description': 'action can occur within a reasonable period of time'}",
