ifc:StarterType a owl:DatatypeProperty ;
    rdfs:label "Starter Type" ;
    rdfs:range xsd:string ;
    skos:definition "A starter for an induction motor which uses for starting one or more reduced voltages derived from an auto transformer. (IEC 441-14-45);A starter in which the force for closing the main contacts is provided exclusively by manual energy. (IEC 441-14-39);A starter which connects the line voltage across the motor terminals in one step. (IEC 441-14-40);A starter in which the frequency of the power supply is progressively increased until the normal operation frequency is attained.;A starter in which there are (n-1) intermediate accelerating positions between the off and full on positions. (IEC 441-14-41);A starter using one or several resistors for obtaining, during starting, stated motor torque characteristics and for limiting the current. (IEC 441-14-425);A starter for a 3 phase induction motor such that in the starting position the stator windings are connected in star and in the final running position they are connected in delta. (IEC 441-14-44)" ;
    meta:allowedValue "{'Code': 'AUTOTRANSFORMER', 'Value': 'AUTOTRANSFORMER', 'Description': 'A starter for an induction motor which uses for starting one or more reduced voltages derived from an auto transformer'}",
        "{'Code': 'DIRECTONLINE', 'Value': 'DIRECTONLINE', 'Description': '(IEC 441-14-39);A starter which connects the line voltage across the motor terminals in one step'}",
        "{'Code': 'FREQUENCY', 'Value': 'FREQUENCY', 'Description': '(IEC 441-14-40);A starter in which the frequency of the power supply is progressively increased until the normal operation frequency is attained'}",
        "{'Code': 'MANUAL', 'Value': 'MANUAL', 'Description': '(IEC 441-14-45);A starter in which the force for closing the main contacts is provided exclusively by manual energy'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'NSTEP', 'Value': 'NSTEP', 'Description': 'A starter in which there are (n-1) intermediate accelerating positions between the off and full on positions'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RHEOSTATIC', 'Value': 'RHEOSTATIC', 'Description': '(IEC 441-14-41);A starter using one or several resistors for obtaining'}",
        "{'Code': 'STARDELTA', 'Value': 'STARDELTA', 'Description': '(IEC 441-14-425);A starter for a 3 phase induction motor such that in the starting position the stator windings are connected in star and in the final running position they are connected in delta'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "StarterType" .

ifc:StartingTime a owl:DatatypeProperty ;
    rdfs:label "Starting Time" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcTimeMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The time (in s) needed for the motor to reach its rated speed with its driven equipment attached, starting from standstill and at the nominal voltage applied at its terminals." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "StartingTime" .

ifc:StartingWindSpeed a owl:DatatypeProperty ;
    rdfs:label "Starting Wind Speed" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLinearVelocityMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the starting wind speed of the wind sensor." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "StartingWindSpeed" .

ifc:Station a owl:DatatypeProperty ;
    rdfs:label "Station" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The station value at this location." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Station" .

ifc:Status a owl:DatatypeProperty ;
    rdfs:label "Status" ;
    rdfs:range xsd:string ;
    skos:definition "[[Status]] of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as 'New' - element designed as new addition, 'Existing' - element exists and remains, 'Demolish' - element existed but is to be demolished, 'Temporary' - element will exists only temporary (like a temporary support structure)." ;
    meta:allowedValue "{'Code': 'DEMOLISH', 'Value': 'DEMOLISH', 'Description': \"'Demolish' - element existed but is to be demolished\"}",
        "{'Code': 'EXISTING', 'Value': 'EXISTING', 'Description': \"'Existing' - element exists and remains\"}",
        "{'Code': 'NEW', 'Value': 'NEW', 'Description': \"The status can be assigned to as 'New' - element designed as new addition\"}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TEMPORARY', 'Value': 'TEMPORARY', 'Description': \"'Temporary' - element will exists only temporary (like a temporary support structure)\"}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Status" .

ifc:StatusHistory a owl:ObjectProperty ;
