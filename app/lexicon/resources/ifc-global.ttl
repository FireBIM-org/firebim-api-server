ifc:AirParticleFilterType a owl:DatatypeProperty ;
    rdfs:label "Air Particle Filter Type" ;
    rdfs:range xsd:string ;
    skos:definition "A panel dry type extended surface filter is a dry-type air filter with random fiber mats or blankets in the forms of pockets, V-shaped or radial pleats,Filter with a efficiency lower than 30% for atmosphere dust-spot.;Filter made of metal screen.;Filter made of cell foams.;Filter made of spun glass.;Filter with an efficiency between 30-98% for atmosphere dust-spot.;Filter with fine electret synthetic fibers.;Filter with natural fibers.;High efficiency particulate air filter.;Ultra low penetration air filter.;Filter made of membrane for certain pore diameters in flat sheet and pleated form.;;Viscous filter used in roll form.;Viscous filter used in moving curtain form.; A renewable moving curtain dry media filter is a random-fiber dry media of relatively high porosity used in moving-curtain(roll) filters.; An electrical filter uses electrostatic precipitation to remove and collect particulate contaminants." ;
    meta:allowedValue "{'Code': 'ADHESIVERESERVOIR', 'Value': 'ADHESIVERESERVOIR', 'Description': 'Viscous filter used in moving curtain form'}",
        "{'Code': 'COARSECELLFOAMS', 'Value': 'COARSECELLFOAMS', 'Description': 'Filter made of cell foams'}",
        "{'Code': 'COARSEMETALSCREEN', 'Value': 'COARSEMETALSCREEN', 'Description': 'Filter made of metal screen'}",
        "{'Code': 'COARSESPUNGLASS', 'Value': 'COARSESPUNGLASS', 'Description': 'Filter made of spun glass'}",
        "{'Code': 'ELECTRICALFILTER', 'Value': 'ELECTRICALFILTER', 'Description': 'Electrical Filter'}",
        "{'Code': 'HEPAFILTER', 'Value': 'HEPAFILTER', 'Description': 'High efficiency particulate air filter'}",
        "{'Code': 'MEDIUMELECTRETFILTER', 'Value': 'MEDIUMELECTRETFILTER', 'Description': 'Filter with fine electret synthetic fibers'}",
        "{'Code': 'MEDIUMNATURALFIBERFILTER', 'Value': 'MEDIUMNATURALFIBERFILTER', 'Description': 'Filter with natural fibers'}",
        "{'Code': 'MEMBRANEFILTERS', 'Value': 'MEMBRANEFILTERS', 'Description': 'Filter made of membrane for certain pore diameters in flat sheet and pleated form'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RENEWABLEMOVINGCURTIANDRYMEDIAFILTER', 'Value': 'RENEWABLEMOVINGCURTIANDRYMEDIAFILTER', 'Description': 'Renewable Moving Curtian Dry Media Filter'}",
        "{'Code': 'ROLLFORM', 'Value': 'ROLLFORM', 'Description': ';Viscous filter used in roll form'}",
        "{'Code': 'ULPAFILTER', 'Value': 'ULPAFILTER', 'Description': 'Ultra low penetration air filter'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AirParticleFilterType" .

