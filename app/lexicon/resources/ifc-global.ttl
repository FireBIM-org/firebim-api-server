    meta:allowedValue "{'Code': 'ACQUISITION', 'Value': 'ACQUISITION', 'Description': 'Acquisition'}",
        "{'Code': 'CRADLETOSITE', 'Value': 'CRADLETOSITE', 'Description': 'Cradle to Site'}",
        "{'Code': 'DECONSTRUCTION', 'Value': 'DECONSTRUCTION', 'Description': 'De [[Construction]]'}",
        "{'Code': 'DISPOSAL', 'Value': 'DISPOSAL', 'Description': 'Disposal'}",
        "{'Code': 'DISPOSALTRANSPORT', 'Value': 'DISPOSALTRANSPORT', 'Description': 'Disposal Transport'}",
        "{'Code': 'GROWTH', 'Value': 'GROWTH', 'Description': 'Growth'}",
        "{'Code': 'INSTALLATION', 'Value': 'INSTALLATION', 'Description': 'Installation'}",
        "{'Code': 'MAINTENANCE', 'Value': 'MAINTENANCE', 'Description': 'Maintenance'}",
        "{'Code': 'MANUFACTURE', 'Value': 'MANUFACTURE', 'Description': 'Manufacture'}",
        "{'Code': 'NOTDEFINED', 'Value': 'NOTDEFINED', 'Description': 'Not Defined'}",
        "{'Code': 'OCCUPANCY', 'Value': 'OCCUPANCY', 'Description': 'Occupancy'}",
        "{'Code': 'OPERATION', 'Value': 'OPERATION', 'Description': '[[Operation]]'}",
        "{'Code': 'PROCUREMENT', 'Value': 'PROCUREMENT', 'Description': 'Procurement'}",
        "{'Code': 'PRODUCTION', 'Value': 'PRODUCTION', 'Description': 'Production'}",
        "{'Code': 'PRODUCTIONTRANSPORT', 'Value': 'PRODUCTIONTRANSPORT', 'Description': 'Production Transport'}",
        "{'Code': 'RECOVERY', 'Value': 'RECOVERY', 'Description': 'Recovery'}",
        "{'Code': 'REFURBISHMENT', 'Value': 'REFURBISHMENT', 'Description': 'Refurbishment'}",
        "{'Code': 'REPAIR', 'Value': 'REPAIR', 'Description': 'Repair'}",
        "{'Code': 'REPLACEMENT', 'Value': 'REPLACEMENT', 'Description': 'Re Placement'}",
        "{'Code': 'TRANSPORT', 'Value': 'TRANSPORT', 'Description': 'Transport'}",
        "{'Code': 'USAGE', 'Value': 'USAGE', 'Description': 'Usage'}",
        "{'Code': 'USERDEFINED', 'Value': 'USERDEFINED', 'Description': 'User Defined'}",
        "{'Code': 'WASTE', 'Value': 'WASTE', 'Description': 'Waste'}",
        "{'Code': 'WHOLELIFECYCLE', 'Value': 'WHOLELIFECYCLE', 'Description': 'Whole Lifecycle'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LifeCyclePhase" .

