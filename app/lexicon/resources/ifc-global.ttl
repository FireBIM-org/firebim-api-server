ifc:IfcTankFEEDANDEXPANSION a owl:Class ;
    rdfs:label "Feed and Expansion" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcTank ;
    skos:definition "An open tank that is used for both storage and thermal expansion. A typical example is a tank used to store make-up water at ambient pressure for supply to a hot water system, simultaneously accommodating increases in volume of the water when heated." ;
