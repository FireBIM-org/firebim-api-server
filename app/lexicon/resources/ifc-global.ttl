ifc:Pset_EnvironmentalImpactIndicators a owl:Class ;
    rdfs:label "Property Set: Environmental Impact Indicators" ;
    skos:definition "Environmental impact indicators are related to a given functional unit (ISO 14040 concept). An example of functional unit is a 'Double glazing window with PVC frame' and the unit to consider is 'one square meter of opening elements filled by this product.; Indicators values are valid for the whole life cycle or only a specific phase (see [[LifeCyclePhase]] property). Values of all the indicators are expressed per year according to the expected service life. The first five properties capture the characteristics of the functional unit. The following properties are related to environmental indicators.; There is a consensus agreement international for the five one. Last ones are not yet fully and formally agreed at the international level." ;
    meta:classType "GroupOfProperties" ;
    meta:groupOfProperties true ;
    meta:hasProperty ifc:AtmosphericAcidificationPerUnit_from_Envir___ators,
        ifc:ClimateChangePerUnit_from_Environmen___Indicators,
        ifc:EutrophicationPerUnit_from_Environmen___Indicators,
        ifc:ExpectedServiceLife_from_Environment___tIndicators,
        ifc:FunctionalUnitReference_from_Environme___ndicators,
        ifc:HazardousWastePerUnit_from_Environmen___Indicators,
        ifc:IndicatorsUnit_from_EnvironmentalImpactIndicators,
        ifc:InertWastePerUnit_from_Environmenta___ctIndicators,
        ifc:LifeCyclePhase_from_EnvironmentalImpactIndicators,
        ifc:NonHazardousWastePerUnit_from_Environm___dicators,
        ifc:NonRenewableEnergyConsumptionPerUnit_from_En___rs,
        ifc:PhotochemicalOzoneFormationPerUnit_from_Env___ors,
        ifc:RadioactiveWastePerUnit_from_Environme___ndicators,
        ifc:RenewableEnergyConsumptionPerUnit_from_Envi___tors,
        ifc:ResourceDepletionPerUnit_from_Environm___dicators,
        ifc:StratosphericOzoneLayerDestructionPerUnit_from,
        ifc:TotalPrimaryEnergyConsumptionPerUnit_from_En___rs,
        ifc:WaterConsumptionPerUnit_from_Environme___ndicators ;
    meta:sourceCode "Pset_EnvironmentalImpactIndicators" .

ifc:Pset_EnvironmentalImpactValues a owl:Class ;
    rdfs:label "Property Set: Environmental Impact Values" ;
    skos:definition "The following properties capture environmental impact values of an element. They correspond to the indicators defined into [[Pset_EnvironmentalImpactIndicators]].; Environmental impact values are obtained multiplying indicator value per unit by the relevant quantity of the element." ;
