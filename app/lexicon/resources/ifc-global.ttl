        "{'Code': 'PASSIVEBALISE', 'Value': 'PASSIVEBALISE', 'Description': 'Passivebalise'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RailwayBaliseType" .

ifc:RailwayCommunicationTerminalType a owl:DatatypeProperty ;
    rdfs:label "Railway Communication Terminal Type" ;
