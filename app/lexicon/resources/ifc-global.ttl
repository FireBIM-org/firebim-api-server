ifc:IfcChiller a owl:Class ;
    rdfs:label "Chiller" ;
    rdfs:subClassOf ifc:IfcEnergyConversionDevice ;
    skos:definition "A chiller is a device used to remove heat from a liquid via a vapor-compression or absorption refrigeration cycle to cool a fluid, typically water or a mixture of water and glycol. The chilled fluid is then used to cool and dehumidify air in a building." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:AcceptanceDate_from_InstallationOccurrence,
        ifc:AccidentResponse_from_MaintenanceStrategy,
        ifc:AcquisitionDate_from_ManufacturerOccurrence,
        ifc:ArticleNumber_from_ManufacturerTypeInformation,
        ifc:AssemblyPlace_from_ManufacturerOccurrence,
        ifc:AssemblyPlace_from_ManufacturerTypeInformation,
