        "{'Code': 'LOCOMOTIVESERVICETRACK', 'Value': 'LOCOMOTIVESERVICETRACK', 'Description': 'Locomotiveservicetrack'}",
        "{'Code': 'MAINTRACK', 'Value': 'MAINTRACK', 'Description': 'Maintrack'}",
        "{'Code': 'MULTIPLEUNITRUNNINGTRACK', 'Value': 'MULTIPLEUNITRUNNINGTRACK', 'Description': 'Multiple Unit Running Track'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RECEIVINGDEPARTURETRACK', 'Value': 'RECEIVINGDEPARTURETRACK', 'Description': 'Receiving Departure Track'}",
        "{'Code': 'REFUGESIDING', 'Value': 'REFUGESIDING', 'Description': 'Refugesiding'}",
        "{'Code': 'REPAIRSIDING', 'Value': 'REPAIRSIDING', 'Description': 'Repair Siding'}",
        "{'Code': 'ROLLINGFORBIDDENTRACK', 'Value': 'ROLLINGFORBIDDENTRACK', 'Description': 'Rollingforbiddentrack'}",
