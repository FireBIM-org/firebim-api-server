ifc:Severity a owl:ObjectProperty ;
    rdfs:label "Severity" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates alarm severity over time, where the scale of values is determined by the control system configuration. A zero value indicates no present alarm." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Severity" .

ifc:ShadingCoefficient a owl:DatatypeProperty ;
    rdfs:label "Shading Coefficient" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The measure of the ability of a glazing to transmit solar heat, relative to that ability for 3 mm (1/8-inch) clear, double-strength, single glass. Shading coefficient is being phased out in favor of the solar heat gain coefficient (SHGC), and is approximately equal to the SHGC multiplied by 1.15. The shading coefficient is expressed as a number without units between 0 and 1." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ShadingCoefficient" .

ifc:ShadingDeviceType a owl:DatatypeProperty ;
    rdfs:label "Shading Device Type" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the type of shading device." ;
    meta:allowedValue "{'Code': 'FIXED', 'Value': 'FIXED', 'Description': 'Fixed'}",
        "{'Code': 'MOVABLE', 'Value': 'MOVABLE', 'Description': 'Movable'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'OVERHANG', 'Value': 'OVERHANG', 'Description': 'Overhang'}",
        "{'Code': 'SIDEFIN', 'Value': 'SIDEFIN', 'Description': '[[Side]] Fin'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ShadingDeviceType" .

