ifc:LowerCurrent1 a owl:DatatypeProperty ;
    rdfs:label "Lower Current1" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricCurrentMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The current in x In, indicating that for currents smaller than [[LowerCurrent1]] the I2t part of the L-function will not trip the current," ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LowerCurrent1" .

ifc:LowerCurrent2 a owl:DatatypeProperty ;
    rdfs:label "Lower Current2" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricCurrentMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The current in x In, indicating the upper current limit of the lower time/current curve of the I2t part of the L-function." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LowerCurrent2" .

ifc:LowerHeatingValue a owl:DatatypeProperty ;
    rdfs:label "Lower Heating Value" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcHeatingValueMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Lower Heating [[Value]] is defined as the amount of energy released (MJ/kg) when a fuel is burned completely, and H2O is in vapor form in the combustion products." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LowerHeatingValue" .

ifc:LowerTime1 a owl:DatatypeProperty ;
    rdfs:label "Lower Time 1" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcTimeMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The time in s, indicating that tripping times of the lower time/current curve lower than [[LowerTime1]] is determined by the I2t part of the L-function." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LowerTime1" .

ifc:LowerTime2 a owl:DatatypeProperty ;
    rdfs:label "Lower Time 2" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcTimeMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The time in s, indicating the tripping times of the upper time/current curve at the [[LowerCurrent2]]." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LowerTime2" .

ifc:LowerVaporResistanceFactor a owl:DatatypeProperty ;
    rdfs:label "Lower Vapor Resistance Factor" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The vapor permeability relationship of air/material (typically value > 1), measured in low relative humidity (typically in 0/50 % RH)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LowerVaporResistanceFactor" .

ifc:LowestSeatingHeight a owl:DatatypeProperty ;
