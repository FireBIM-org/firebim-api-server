ifc:IfcReinforcingMesh a owl:Class ;
    rdfs:label "Reinforcing Mesh" ;
    rdfs:subClassOf ifc:IfcReinforcingElement ;
    skos:definition "A reinforcing mesh is a series of longitudinal and transverse wires or bars of various gauges, arranged at right angles to each other and welded at all points of intersection; usually used for concrete slab reinforcement. It is also known as welded wire fabric. In scope are plane meshes as well as bent meshes." ;
