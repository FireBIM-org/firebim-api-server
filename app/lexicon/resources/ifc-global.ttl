    meta:sourceCode "ShearModulus" .

ifc:ShearModulusMin a owl:DatatypeProperty ;
    rdfs:label "Shear Modulus Min" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcModulusOfElasticityMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
