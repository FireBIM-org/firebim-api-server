ifc:IfcVibrationDamper a owl:Class ;
    rdfs:label "Vibration Damper" ;
    rdfs:subClassOf ifc:IfcElementComponent ;
    skos:definition "A vibration damper is a device used to minimize the effects of vibration in a structure by dissipating kinetic energy. The damper may be passive (elastic, frictional, inertia) or active (in a system using sensors and actuators)." ;
