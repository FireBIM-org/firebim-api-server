ifc:LongTimeCurrentSetValue a owl:DatatypeProperty ;
    rdfs:label "Long Time Current Set Value" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricCurrentMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Long time current set value. The set value of the long time tripping current if adjustable." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LongTimeCurrentSetValue" .

ifc:LongTimeDelay a owl:DatatypeProperty ;
    rdfs:label "Long Time Delay" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcTimeMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Long time delay. The set value of the long time time-delay if adjustable." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LongTimeDelay" .

ifc:LongTimeFunction a owl:DatatypeProperty ;
    rdfs:label "Long Time Function" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "Applying long time function; A flag indicating that the long time function (i.e. the thermal tripping) of the device is used. The value should be set to TRUE for all devices except those that allows the Long time function of the device not to be used." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LongTimeFunction" .

