    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricCurrentMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Sensitivity]]." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Sensitivity" .

ifc:SeparationType a owl:DatatypeProperty ;
    rdfs:label "Separation Type" ;
    rdfs:range xsd:string ;
    skos:definition "Air particulate filter media separation type." ;
    meta:allowedValue "{'Code': 'BAG', 'Value': 'BAG', 'Description': 'Bag'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PLEAT', 'Value': 'PLEAT', 'Description': 'Pleat'}",
        "{'Code': 'TREADSEPARATION', 'Value': 'TREADSEPARATION', 'Description': 'Treadseparation'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SeparationType" .

ifc:SequenceInTrackPanel a owl:DatatypeProperty ;
    rdfs:label "Sequence In Track Panel" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcInteger' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
