ifc:WashHandBasinType a owl:DatatypeProperty ;
    rdfs:label "Wash Hand Basin Type" ;
    rdfs:range xsd:string ;
    skos:definition "Waste water appliance that receives and flushes away mouth washings; .;Wall mounted wash hand basin that has an overall width of 500mm or less; .;Wash hand basin that has a smooth easy clean surface without tapholes or overflow slot for use where hygiene is of prime importance.Wash hand basin mounted on pivots so that it can be emptied by tilting.Wash hand basin for installation into a horizontal surface.Wash hand basin that is circular, semi-circular or polygonal on plan, at which more than one person can wash at the same time.;Wash hand basin of elongated rectangular shape in plan, at which more than one person can wash at the same time." ;
    meta:allowedValue "{'Code': 'DENTALCUSPIDOR', 'Value': 'DENTALCUSPIDOR', 'Description': 'Waste water appliance that receives and flushes away mouth washings'}",
        "{'Code': 'HANDRINSE', 'Value': 'HANDRINSE', 'Description': 'Wall mounted wash hand basin that has an overall width of 500mm or less'}",
        "{'Code': 'HOSPITAL', 'Value': 'HOSPITAL', 'Description': 'Wash hand basin that has a smooth easy clean surface without tapholes or overflow slot for use where hygiene is of prime importance'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TIPUP', 'Value': 'TIPUP', 'Description': 'Wash hand basin mounted on pivots so that it can be emptied by tilting'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WASHFOUNTAIN', 'Value': 'WASHFOUNTAIN', 'Description': 'Wash hand basin that is circular'}",
        "{'Code': 'WASHINGTROUGH', 'Value': 'WASHINGTROUGH', 'Description': 'Wash hand basin of elongated rectangular shape in plan'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WashHandBasinType" .

