    meta:parentClassCode "IfcDamper" ;
    meta:sourceCode "IfcDamperGRAVITYRELIEFDAMPER" .

ifc:IfcDamperRELIEFDAMPER a owl:Class ;
    rdfs:label "Relief Damper" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcDamper ;
    skos:definition "Relief damper used to allow air to move upon a buildup of a specified pressure differential. Commonly operated by mechanical spring." ;
    meta:classType "Class" ;
