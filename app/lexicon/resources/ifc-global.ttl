ifc:IfcActionRequest a owl:Class ;
    rdfs:label "Action Request" ;
    rdfs:subClassOf ifc:IfcControl ;
    skos:definition "A request is the act or instance of asking for something, such as a request for information, bid submission, or performance of work." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:Description_from_Attributes,
        ifc:GlobalId_from_Attributes,
        ifc:Identification_from_Attributes,
        ifc:LongDescription_from_Attributes,
        ifc:Name_from_Attributes,
        ifc:ObjectType_from_Attributes,
        ifc:RequestComments_from_ActionRequest,
        ifc:RequestSourceLabel_from_ActionRequest,
        ifc:RequestSourceName_from_ActionRequest,
        ifc:Status_from_Attributes ;
    meta:parentClassCode "IfcControl" ;
    meta:sourceCode "IfcActionRequest" ;
    meta:uid "7045cc64-c05a-4a43-aaa5-b5b4d849f3f5" .

