        "{'Code': 'GLAZED', 'Value': 'GLAZED', 'Description': 'Glazed'}",
        "{'Code': 'HORZ_SEG', 'Value': 'HORZ_SEG', 'Description': 'Horz Seg'}",
        "{'Code': 'MONOLITHIC', 'Value': 'MONOLITHIC', 'Description': 'Monolithic'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OPEN', 'Value': 'OPEN', 'Description': 'Open'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SCREEN', 'Value': 'SCREEN', 'Description': 'Screen'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
