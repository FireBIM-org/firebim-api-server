    meta:sourceCode "ConditionReplacementLevel" .

ifc:ConditionTargetPerformance a owl:DatatypeProperty ;
    rdfs:label "Condition Target Performance" ;
    rdfs:range xsd:string ;
    skos:definition "Target condition of the asset" ;
