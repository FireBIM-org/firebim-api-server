    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Designation of the standard table to which the flange conforms." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlangeTable" .

ifc:FlangeThickness a owl:DatatypeProperty ;
    rdfs:label "Flange Thickness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Thickness]] of the material from which the pipe bend is constructed." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlangeThickness" .

ifc:FloorAreaRatio a owl:DatatypeProperty ;
    rdfs:label "Floor Area Ratio" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of all floor areas to the buildable area as the maximum floor area utilization of the site as a maximum value according to local building codes." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FloorAreaRatio" .

ifc:FloorCovering a owl:DatatypeProperty ;
    rdfs:label "Floor Covering" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Label to indicate the material or finish of the space flooring. The label is used for room book information and often displayed in room stamp.The material information is provided in absence of an [[IfcCovering]] (type=FLOORING) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FloorCovering" .

ifc:FloorCoveringThickness a owl:DatatypeProperty ;
    rdfs:label "Floor Covering Thickness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Thickness]] of the material layer(s) for the space flooring.The thickness information is provided in absence of an [[IfcCovering]] (type=FLOORING) object with own shape representation. In cases of inconsistency between the geometric parameters of an assigned [[IfcCovering]] and this attached property, the geometric parameters take precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FloorCoveringThickness" .

ifc:FlowArrangement a owl:DatatypeProperty ;
    rdfs:label "Flow Arrangement" ;
    rdfs:range xsd:string ;
    skos:definition "Air and water flow enter in different directions.;Air and water flow are perpendicular.;Air and water flow enter in same directions.;Multipass flow heat exchanger arrangement. ;Other type of heat exchanger flow arrangement not defined above." ;
    meta:allowedValue "{'Code': 'COUNTERFLOW', 'Value': 'COUNTERFLOW', 'Description': 'Air and water flow enter in different directions'}",
        "{'Code': 'CROSSFLOW', 'Value': 'CROSSFLOW', 'Description': 'Air and water flow are perpendicular'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other type of heat exchanger flow arrangement not defined above'}",
        "{'Code': 'PARALLELFLOW', 'Value': 'PARALLELFLOW', 'Description': 'Air and water flow enter in same directions'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowArrangement" .

ifc:FlowClass a owl:DatatypeProperty ;
    rdfs:label "Flow Class" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Alphanumeric indication of the flow class of a hydrant (may be used in connection with or instead of the FlowRate property)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowClass" .

ifc:FlowCoefficient a owl:DatatypeProperty ;
    rdfs:label "Flow Coefficient" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Flow coefficient (the quantity of fluid that passes through a fully open valve at unit pressure drop), typically expressed as the Kv or Cv value for the valve." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowCoefficient" .

ifc:FlowCondition a owl:DatatypeProperty ;
    rdfs:label "Flow Condition" ;
    rdfs:range xsd:decimal ;
    skos:definition "Defines the flow condition as a percentage of the cross-sectional area." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "FlowCondition" .

ifc:FlowConditionHistory a owl:ObjectProperty ;
    rdfs:label "Flow Condition History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Defines the flow condition as a percentage of the cross-sectional area." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "FlowConditionHistory" .

ifc:FlowControlType a owl:DatatypeProperty ;
    rdfs:label "Flow Control Type" ;
    rdfs:range xsd:string ;
    skos:definition "[[Type]] of flow control element that may be included as a part of the construction of the air terminal." ;
    meta:allowedValue "{'Code': 'BELLOWS', 'Value': 'BELLOWS', 'Description': 'Bellows'}",
        "{'Code': 'DAMPER', 'Value': 'DAMPER', 'Description': 'Damper'}",
        "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowControlType" .

ifc:FlowDirection a owl:DatatypeProperty ;
    rdfs:label "Flow Direction" ;
    rdfs:range xsd:string ;
    skos:definition "Enumeration that identifies if this port is a Sink (inlet), a Source (outlet) or both a SinkAndSource." ;
    meta:allowedValue "{'Code': 'NOTDEFINED', 'Value': 'NOTDEFINED', 'Description': 'Not Defined'}",
        "{'Code': 'SINK', 'Value': 'SINK', 'Description': 'Enumeration that identifies if this port is a Sink (inlet)'}",
        "{'Code': 'SOURCE', 'Value': 'SOURCE', 'Description': 'a Source (outlet) or both a SinkAndSource'}",
        "{'Code': 'SOURCEANDSINK', 'Value': 'SOURCEANDSINK', 'Description': 'Source and Sink'}" ;
    meta:sourceCode "FlowDirection" .

ifc:FlowLoading a owl:DatatypeProperty ;
    rdfs:label "Flow Loading" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcForceMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Flow loading force" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowLoading" .

ifc:FlowMeterOurpose a owl:DatatypeProperty ;
    rdfs:label "Flow Meter Ourpose" ;
    rdfs:range xsd:string ;
    skos:definition "Enumeration defining the purpose of the flow meter occurrence." ;
    meta:allowedValue "{'Code': 'MASTER', 'Value': 'MASTER', 'Description': 'Master'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SUBMASTER', 'Value': 'SUBMASTER', 'Description': 'Submaster'}",
        "{'Code': 'SUBMETER', 'Value': 'SUBMETER', 'Description': 'Sub Meter'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowMeterOurpose" .

ifc:FlowPattern a owl:DatatypeProperty ;
    rdfs:label "Flow Pattern" ;
    rdfs:range xsd:string ;
    skos:definition "Flow pattern." ;
    meta:allowedValue "{'Code': 'COMPACTJET', 'Value': 'COMPACTJET', 'Description': 'Compactjet'}",
        "{'Code': 'DISPLACMENT', 'Value': 'DISPLACMENT', 'Description': 'Displacment'}",
        "{'Code': 'LINEARDOUBLE', 'Value': 'LINEARDOUBLE', 'Description': 'Linear Double'}",
        "{'Code': 'LINEARFOURWAY', 'Value': 'LINEARFOURWAY', 'Description': 'Linearfourway'}",
        "{'Code': 'LINEARSINGLE', 'Value': 'LINEARSINGLE', 'Description': 'Linear Single'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RADIAL', 'Value': 'RADIAL', 'Description': 'Radial'}",
        "{'Code': 'SWIRL', 'Value': 'SWIRL', 'Description': 'Swirl'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlowPattern" .

ifc:FlowRateRange a owl:DatatypeProperty ;
    rdfs:label "Flow Rate Range" ;
    rdfs:range xsd:decimal ;
    skos:definition "Allowable range of volume of fluid being pumped against the resistance specified." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "FlowRateRange" .

ifc:FlowRating a owl:DatatypeProperty ;
    rdfs:label "Flow Rating" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcVolumetricFlowRateMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Actual flow capacity for the gutter. [[Value]] of 0.00 means this value has not been set." ;
