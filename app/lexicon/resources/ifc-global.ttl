ifc:CoefficientOfPerformance a owl:ObjectProperty ;
    rdfs:label "Coefficient of Performance" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "The [[Coefficient]] of performance (COP) is the ratio of heat removed to energy input.; The energy input may be obtained by multiplying; Pset_DistributionPortPHistoryGas.FlowRate on the '[[Fuel]]' port of the [[IfcChiller]] by [[Pset_MaterialFuel]].[[LowerHeatingValue]].; The [[IfcDistributionPort]] for fuel has an associated [[IfcMaterial]] with fuel properties and is assigned to an [[IfcPerformanceHistory]] object nested within this [[IfcPerformanceHistory]] object." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CoefficientOfPerformance" .

ifc:CoefficientOfPerformanceCurve a owl:ObjectProperty ;
    rdfs:label "Coefficient of Performance Curve" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Chiller coefficient of performance (COP) is function of condensing temperature and evaporating temperature, data is in table form, COP= f (TempCon, TempEvp), COP = a2+b2*Tei+c2*Tei\\2+d2*Tci+e2*Tci\\2+f2*Tei*Tci.; This table uses multiple input variables; to represent, both DefiningValues and DefinedValues lists are null and IfcTable is attached using IfcResourceConstraintRelationship and IfcMetric.; 1.[[CoefficientOfPerformance]]; 2.[[CondensingTemperature]]; 3.[[EvaporatingTemperature]]" ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CoefficientOfPerformanceCurve" .

ifc:CohesionBehaviour a owl:DatatypeProperty ;
    rdfs:label "Cohesion Behaviour" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPressureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Cohesive shear strength of a rock or soil that is independent of interparticle friction." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CohesionBehaviour" .

ifc:CoilConnectionDirection a owl:DatatypeProperty ;
    rdfs:label "Coil Connection Direction" ;
    rdfs:range xsd:string ;
    skos:definition "Coil connection direction (facing into the air stream)." ;
    meta:allowedValue "{'Code': 'LEFT', 'Value': 'LEFT', 'Description': 'Left'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RIGHT', 'Value': 'RIGHT', 'Description': 'Right'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilConnectionDirection" .

ifc:CoilCoolant a owl:DatatypeProperty ;
    rdfs:label "Coil Coolant" ;
    rdfs:range xsd:string ;
    skos:definition "The fluid used for heating or cooling used by the hydronic coil." ;
    meta:allowedValue "{'Code': 'BRINE', 'Value': 'BRINE', 'Description': 'Brine'}",
        "{'Code': 'GLYCOL', 'Value': 'GLYCOL', 'Description': 'Glycol'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WATER', 'Value': 'WATER', 'Description': '[[Water]]'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilCoolant" .

ifc:CoilFaceArea a owl:DatatypeProperty ;
    rdfs:label "Coil Face Area" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcAreaMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Coil face area in the direction against air the flow." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilFaceArea" .

ifc:CoilFluidArrangement a owl:DatatypeProperty ;
    rdfs:label "Coil Fluid Arrangement" ;
    rdfs:range xsd:string ;
    skos:definition "Fluid flow arrangement of the coil.Air and water flow enter in different directions.;Air and water flow are perpendicular.;Air and water flow enter in same directions." ;
    meta:allowedValue "{'Code': 'CROSSCOUNTERFLOW', 'Value': 'CROSSCOUNTERFLOW', 'Description': 'Air and water flow enter in different directions'}",
        "{'Code': 'CROSSFLOW', 'Value': 'CROSSFLOW', 'Description': 'Air and water flow are perpendicular'}",
        "{'Code': 'CROSSPARALLELFLOW', 'Value': 'CROSSPARALLELFLOW', 'Description': 'Air and water flow enter in same directions'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilFluidArrangement" .

ifc:CoilLength a owl:DatatypeProperty ;
    rdfs:label "Coil Length" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Length]] of coil." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilLength" .

ifc:CoilPlacement a owl:DatatypeProperty ;
    rdfs:label "Coil Placement" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the placement of the coil.; [[FLOOR]] indicates an under floor heater (if coil type is WATERHEATINGCOIL or ELECTRICHEATINGCOIL);; [[CEILING]] indicates a cooling ceiling (if coil type is WATERCOOLINGCOIL);; [[UNIT]] indicates that the coil is part of a cooling or heating unit, like cooled beam, etc." ;
    meta:allowedValue "{'Code': 'CEILING', 'Value': 'CEILING', 'Description': '[[CEILING]] indicates a cooling ceiling (if coil type is WATERCOOLINGCOIL)'}",
        "{'Code': 'FLOOR', 'Value': 'FLOOR', 'Description': '[[FLOOR]] indicates an under floor heater (if coil type is WATERHEATINGCOIL or ELECTRICHEATINGCOIL)'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNIT', 'Value': 'UNIT', 'Description': '[[UNIT]] indicates that the coil is part of a cooling or heating unit'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilPlacement" .

ifc:CoilPosition a owl:DatatypeProperty ;
    rdfs:label "Coil Position" ;
    rdfs:range xsd:string ;
    skos:definition "Defines the relationship between a fan and a coil.Fan located downstream of the coil.;Fan located upstream of the coil." ;
    meta:allowedValue "{'Code': 'BLOWTHROUGH', 'Value': 'BLOWTHROUGH', 'Description': 'Fan located upstream of the coil'}",
        "{'Code': 'DRAWTHROUGH', 'Value': 'DRAWTHROUGH', 'Description': 'Fan located downstream of the coil'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CoilPosition" .

