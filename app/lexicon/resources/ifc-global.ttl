        "{'Code': 'CONSTANTVOLUMEBYPASS', 'Value': 'CONSTANTVOLUMEBYPASS', 'Description': 'Constant [[Volume]] Bypass'}",
        "{'Code': 'CONSTANTVOLUMEMULTIPLEZONEREHEAT', 'Value': 'CONSTANTVOLUMEMULTIPLEZONEREHEAT', 'Description': 'Constant [[Volume]] Multiple Zone Reheat'}",
        "{'Code': 'CONSTANTVOLUMESINGLEZONE', 'Value': 'CONSTANTVOLUMESINGLEZONE', 'Description': 'Constant [[Volume]] Single Zone'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
