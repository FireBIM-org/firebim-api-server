    rdfs:comment "Technical note: in IFC this property takes 'IfcVolumeMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Relative volume of silt (typically smaller than 0.063mm) stratum constituents." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SiltVolume" .

ifc:SingleChannelAveragePower a owl:DatatypeProperty ;
    rdfs:label "Single Channel Average Power" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the average power of a single channel of the transport equipment." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SingleChannelAveragePower" .

ifc:SingleChannelPower a owl:DatatypeProperty ;
    rdfs:label "Single Channel Power" ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the power range of a single channel of the transport equipment." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "SingleChannelPower" .

ifc:SingleWaveTransmissionRate a owl:DatatypeProperty ;
    rdfs:label "Single Wave Transmission Rate" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcFrequencyMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the single wave transmission rate of the transport equipment." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SingleWaveTransmissionRate" .

ifc:SinkType a owl:DatatypeProperty ;
    rdfs:label "Sink Type" ;
    rdfs:range xsd:string ;
    skos:definition "Deep sink that has a plain edge and a weir overflow; .; Sink at low level, with protected front edge, that facilitates filling and emptying buckets, usually with a hinged grid on which to stand them.; Sink, usually fixed at normal height (900mm), with protected front edge.; Sink with integral drainer on left hand side; .;Sink with integral drainer on right hand side; .; Sink with integral drainer on both sides; .;Small sink that catches drips or flow from a faucet; .;Sink, of acid resisting material, with a top edge shaped to facilitate fixing to the underside of a desktop; .;Deep sink that has a plain edge and no overflow; .;Sink with sediment receiver to prevent waste plaster passing into drains; .;Large metal sink, with a standing waste, for washing cooking utensils; .;Metal sink in which water can be heated and culinary utensils and tableware immersed at high temperature that destroys most harmful bacteria and allows subsequent self drying.; .;Ceramic sink with an integral back shelf through which water fittings are mounted; .; Large metal sink, with a standing waste, for washing and preparing vegetables; ." ;
    meta:allowedValue "{'Code': 'BELFAST', 'Value': 'BELFAST', 'Description': 'Deep sink that has a plain edge and a weir overflow'}",
        "{'Code': 'BUCKET', 'Value': 'BUCKET', 'Description': 'Sink at low level'}",
        "{'Code': 'CLEANERS', 'Value': 'CLEANERS', 'Description': 'Sink'}",
        "{'Code': 'COMBINATION_DOUBLE', 'Value': 'COMBINATION_DOUBLE', 'Description': 'Sink with integral drainer on both sides'}",
        "{'Code': 'COMBINATION_LEFT', 'Value': 'COMBINATION_LEFT', 'Description': 'Sink with integral drainer on left hand side'}",
        "{'Code': 'COMBINATION_RIGHT', 'Value': 'COMBINATION_RIGHT', 'Description': 'Sink with integral drainer on right hand side'}",
        "{'Code': 'DRIP', 'Value': 'DRIP', 'Description': 'Small sink that catches drips or flow from a faucet'}",
        "{'Code': 'LABORATORY', 'Value': 'LABORATORY', 'Description': 'Sink'}",
        "{'Code': 'LONDON', 'Value': 'LONDON', 'Description': 'Deep sink that has a plain edge and no overflow'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PLASTER', 'Value': 'PLASTER', 'Description': 'Sink with sediment receiver to prevent waste plaster passing into drains'}",
        "{'Code': 'POT', 'Value': 'POT', 'Description': 'Large metal sink'}",
        "{'Code': 'RINSING', 'Value': 'RINSING', 'Description': 'Metal sink in which water can be heated and culinary utensils and tableware immersed at high temperature that destroys most harmful bacteria and allows subsequent self drying'}",
        "{'Code': 'SHELF', 'Value': 'SHELF', 'Description': 'Ceramic sink with an integral back shelf through which water fittings are mounted'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VEGETABLEPREPARATION', 'Value': 'VEGETABLEPREPARATION', 'Description': 'Large metal sink'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SinkType" .

ifc:SiteCoverageRatio a owl:DatatypeProperty ;
    rdfs:label "Site Coverage Ratio" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of the utilization, [[TotalArea]] / [[BuildableArea]], expressed as a maximum value. The ratio value may be used to derive [[BuildableArea]]." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SiteCoverageRatio" .

ifc:Size a owl:DatatypeProperty ;
    rdfs:label "Size" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The size of the connection to the valve (or to each connection for faucets, mixing valves, etc.)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Size" .

ifc:SizingMethod a owl:DatatypeProperty ;
    rdfs:label "Sizing Method" ;
    rdfs:range xsd:string ;
    skos:definition "Nominal sizing method.;Exact sizing method." ;
    meta:allowedValue "{'Code': 'EXACT', 'Value': 'EXACT', 'Description': 'Nominal sizing method'}",
        "{'Code': 'NOMINAL', 'Value': 'NOMINAL', 'Description': 'Nominal sizing method'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SizingMethod" .

ifc:SkillLevel a owl:DatatypeProperty ;
    rdfs:label "Skill Level" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Skill level exhibited by the actor and which indicates an extent of their capability to perform actions on the artefacts upon which they can act." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SkillLevel" .

ifc:SkirtingBoard a owl:DatatypeProperty ;
    rdfs:label "Skirting Board" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Label to indicate the material or construction of the skirting board around the space flooring. The label is used for room book information.The material information is provided in absence of an [[IfcCovering]] (type=SKIRTINGBOARD) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SkirtingBoard" .

ifc:SkirtingBoardHeight a owl:DatatypeProperty ;
    rdfs:label "Skirting Board Height" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Height]] of the skirting board.The height information is provided in absence of an [[IfcCovering]] (type=SKIRTINGBOARD) object with own shape representation and material assignment. In case of inconsistency the height assigned to [[IfcCovering]] elements takes precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SkirtingBoardHeight" .

ifc:SleeperArrangement a owl:DatatypeProperty ;
    rdfs:label "Sleeper Arrangement" ;
    rdfs:range xsd:string ;
    skos:definition "Define the rail joint sleeper method of assembly ('twin sleeper' type or 'between sleepers' type)." ;
    meta:allowedValue "{'Code': 'BETWEENSLEEPERS', 'Value': 'BETWEENSLEEPERS', 'Description': 'Between Sleepers'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TWINSLEEPER', 'Value': 'TWINSLEEPER', 'Description': 'Twin Sleeper'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SleeperArrangement" .

ifc:SleeperType a owl:DatatypeProperty ;
    rdfs:label "Sleeper Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the sleeper type." ;
    meta:allowedValue "{'Code': 'COMPOSITESLEEPER', 'Value': 'COMPOSITESLEEPER', 'Description': 'Compo Site Sleeper'}",
        "{'Code': 'CONCRETESLEEPER', 'Value': 'CONCRETESLEEPER', 'Description': 'Concretesleeper'}",
        "{'Code': 'INSULATEDSTEELSLEEPER', 'Value': 'INSULATEDSTEELSLEEPER', 'Description': 'Insulatedsteelsleeper'}",
        "{'Code': 'MONOBLOCKCONCRETESLEEPER', 'Value': 'MONOBLOCKCONCRETESLEEPER', 'Description': 'Monoblockconcretesleeper'}",
        "{'Code': 'NOTINSULATEDSTEELSLEEPER', 'Value': 'NOTINSULATEDSTEELSLEEPER', 'Description': 'Notinsulatedsteelsleeper'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TWOBLOCKCONCRETESLEEPER', 'Value': 'TWOBLOCKCONCRETESLEEPER', 'Description': 'Twoblockconcretesleeper'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WOODENSLEEPER', 'Value': 'WOODENSLEEPER', 'Description': 'Woodensleeper'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SleeperType" .

ifc:Slope a owl:DatatypeProperty ;
    rdfs:label "Slope" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPlaneAngleMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Slope]] angle - relative to horizontal (0.0 degrees).The shape information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the shape properties, provided in the attached property, the geometric parameters take precedence. For geometry editing applications,this value should be write-only." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Slope" .

ifc:SlotLength a owl:DatatypeProperty ;
    rdfs:label "Slot Length" ;
