ifc:OCSFasteningType a owl:DatatypeProperty ;
    rdfs:label "Ocsfastening Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of the overhead contact system (OCS) mechanical fastener." ;
    meta:allowedValue "{'Code': 'EARTHING_FITTING', 'Value': 'EARTHING_FITTING', 'Description': 'Earthing Fitting'}",
        "{'Code': 'JOINT_FITTING', 'Value': 'JOINT_FITTING', 'Description': 'Joint Fitting'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'REGISTRATION_FITTING', 'Value': 'REGISTRATION_FITTING', 'Description': 'Registration Fitting'}",
        "{'Code': 'SUPPORT_FITTING', 'Value': 'SUPPORT_FITTING', 'Description': 'Support Fitting'}",
        "{'Code': 'SUSPENSION_FITTING', 'Value': 'SUSPENSION_FITTING', 'Description': 'Suspension Fitting'}",
        "{'Code': 'TENSIONING_FITTING', 'Value': 'TENSIONING_FITTING', 'Description': 'Tensioning Fitting'}",
        "{'Code': 'TERMINATION_FITTING', 'Value': 'TERMINATION_FITTING', 'Description': 'Termination Fitting'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "OCSFasteningType" .

ifc:OCSType a owl:DatatypeProperty ;
    rdfs:label "Ocstype" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of overhead contactline system (OCS)." ;
    meta:allowedValue "{'Code': 'COMPOUND_CATENARY_SUSPENSION', 'Value': 'COMPOUND_CATENARY_SUSPENSION', 'Description': 'Compound Catenary Suspension'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OCL_WITH_CATENARY_SUSPENSION', 'Value': 'OCL_WITH_CATENARY_SUSPENSION', 'Description': 'OCL with Catenary Suspension'}",
        "{'Code': 'OCL_WITH_STITCHED_CATENARY_SUSPENSION', 'Value': 'OCL_WITH_STITCHED_CATENARY_SUSPENSION', 'Description': 'OCL with Stitch Ed Catenary Suspension'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RIGID_CATENARY', 'Value': 'RIGID_CATENARY', 'Description': 'Rigid Catenary'}",
        "{'Code': 'TROLLY_TYPE_CONTACT_LINE', 'Value': 'TROLLY_TYPE_CONTACT_LINE', 'Description': 'Trolly [[Type]] Contact Line'}",
        "{'Code': 'TROLLY_TYPE_WITH_STITCHWIRE', 'Value': 'TROLLY_TYPE_WITH_STITCHWIRE', 'Description': 'Trolly [[Type]] with Stitch Wire'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "OCSType" .

ifc:ObjectType a owl:DatatypeProperty ;
    rdfs:label "Object Type" ;
    rdfs:range xsd:string ;
    skos:definition "The type denotes a particular type that indicates the object further. The use has to be established at the level of instantiable subtypes. In particular it holds the user defined type, if the enumeration of the attribute PredefinedType is set to [[USERDEFINED]] or when the concrete entity instantiated does not have a PredefinedType attribute. The latter is the case in some exceptional leaf classes and when instantiating [[IfcBuiltElement]] directly." ;
    meta:sourceCode "ObjectType" .

