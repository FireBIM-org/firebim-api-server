        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VARIABLEAIRVOLUME', 'Value': 'VARIABLEAIRVOLUME', 'Description': 'Variable Air [[Volume]]'}",
        "{'Code': 'VARIABLEAIRVOLUMEDUALCONDUIT', 'Value': 'VARIABLEAIRVOLUMEDUALCONDUIT', 'Description': 'Variable Air [[Volume]] Dual Conduit'}",
        "{'Code': 'VARIABLEAIRVOLUMEFANPOWERED', 'Value': 'VARIABLEAIRVOLUMEFANPOWERED', 'Description': 'Variable Air [[Volume]] Fan Powered'}",
        "{'Code': 'VARIABLEAIRVOLUMEINDUCTION', 'Value': 'VARIABLEAIRVOLUMEINDUCTION', 'Description': 'Variable Air [[Volume]] Induction'}",
        "{'Code': 'VARIABLEAIRVOLUMEREHEAT', 'Value': 'VARIABLEAIRVOLUMEREHEAT', 'Description': 'Variable Air [[Volume]] Reheat'}",
