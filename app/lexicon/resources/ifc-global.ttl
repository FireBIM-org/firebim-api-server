ifc:FuseDisconnectorType a owl:DatatypeProperty ;
    rdfs:label "Fuse Disconnector Type" ;
    rdfs:range xsd:string ;
    skos:definition "A fuse whose characteristic is specifically designed for the protection of a motor or generator.;A switch disconnector in which a fuse link or a fuse carrier with fuse link forms the moving contact,;A standard fuse (High Rupturing [[Capacity]]);A device that disconnects the supply when the operating conditions in an electrically undamaged circuit causes an overcurrent,;A fuse whose characteristic is specifically designed for the protection of sem-conductor devices.;A switch disconnector in which one or more poles have a fuse in series in a composite unit." ;
    meta:allowedValue "{'Code': 'ENGINEPROTECTIONDEVICE', 'Value': 'ENGINEPROTECTIONDEVICE', 'Description': 'A fuse whose characteristic is specifically designed for the protection of a motor or generator'}",
        "{'Code': 'FUSEDSWITCH', 'Value': 'FUSEDSWITCH', 'Description': 'Fusedswitch'}",
        "{'Code': 'HRC', 'Value': 'HRC', 'Description': 'A standard fuse (High Rupturing [[Capacity]]);A device that disconnects the supply when the operating conditions in an electrically undamaged circuit causes an overcurrent'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'OVERLOADPROTECTIONDEVICE', 'Value': 'OVERLOADPROTECTIONDEVICE', 'Description': 'A standard fuse (High Rupturing [[Capacity]]);A device that disconnects the supply when the operating conditions in an electrically undamaged circuit causes an overcurrent'}",
        "{'Code': 'SWITCHDISCONNECTORFUSE', 'Value': 'SWITCHDISCONNECTORFUSE', 'Description': 'A switch disconnector in which one or more poles have a fuse in series in a composite unit'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FuseDisconnectorType" .

ifc:FusibleLinkTemperature a owl:DatatypeProperty ;
    rdfs:label "Fusible Link Temperature" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcThermodynamicTemperatureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The temperature that the fusible link melts." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FusibleLinkTemperature" .

ifc:GasDetected a owl:DatatypeProperty ;
