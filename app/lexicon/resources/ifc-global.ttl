ifc:ValueHistory a owl:ObjectProperty ;
    rdfs:label "Value History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates values over time which may be recorded continuously or only when changed beyond a particular deadband. The range of possible values is defined by the [[Value]] property on the corresponding occurrence property set ([[Pset_ControllerTypeFloating]], [[Pset_ControllerTypeProportional]], [[Pset_ControllerTypeMultiPosition]], or [[Pset_ControllerTypeTwoPosition]])." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "ValueHistory" .

ifc:ValveMechanism a owl:DatatypeProperty ;
    rdfs:label "Valve Mechanism" ;
    rdfs:range xsd:string ;
    skos:definition "Valve that has a ported ball that can be turned relative to the body seat ports.;Valve in which a streamlined disc pivots about a diametric axis.;Screwdown valve in which the closing gate is shaped in a configured manner to have a more precise control of pressure and flow change across the valve.;Valve with a tapered seating, in which a rotatable plug is retained by means of a gland and gland packing.;Screwdown valve that has a spherical body.;Plug valve in which a lubricant is injected under pressure between the plug face and the body.;Valve for regulating the flow in or from a pipe, in which a slender cone moves along the axis of flow to close against a fixed conical seat.;Screwdown valve that has a machined plate that slides in formed grooves to form a seal.;Valve that has a ported plug that can be turned relative to the body seat ports.;Screwdown valve that has a wedge shaped plate fitting into tapered guides to form a seal." ;
    meta:allowedValue "{'Code': 'BALL', 'Value': 'BALL', 'Description': 'Valve that has a ported ball that can be turned relative to the body seat ports'}",
        "{'Code': 'BUTTERFLY', 'Value': 'BUTTERFLY', 'Description': 'Valve in which a streamlined disc pivots about a diametric axis'}",
        "{'Code': 'CONFIGUREDGATE', 'Value': 'CONFIGUREDGATE', 'Description': 'Screwdown valve in which the closing gate is shaped in a configured manner to have a more precise control of pressure and flow change across the valve'}",
        "{'Code': 'GLAND', 'Value': 'GLAND', 'Description': 'Valve with a tapered seating'}",
        "{'Code': 'GLOBE', 'Value': 'GLOBE', 'Description': 'Screwdown valve that has a spherical body'}",
        "{'Code': 'LUBRICATEDPLUG', 'Value': 'LUBRICATEDPLUG', 'Description': 'Plug valve in which a lubricant is injected under pressure between the plug face and the body'}",
        "{'Code': 'NEEDLE', 'Value': 'NEEDLE', 'Description': 'Valve for regulating the flow in or from a pipe'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PARALLELSLIDE', 'Value': 'PARALLELSLIDE', 'Description': 'Screwdown valve that has a machined plate that slides in formed grooves to form a seal'}",
        "{'Code': 'PLUG', 'Value': 'PLUG', 'Description': 'in which a rotatable plug is retained by means of a gland and gland packing'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WEDGEGATE', 'Value': 'WEDGEGATE', 'Description': 'Screwdown valve that has a wedge shaped plate fitting into tapered guides to form a seal'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ValveMechanism" .

ifc:ValveOperation a owl:DatatypeProperty ;
    rdfs:label "Valve Operation" ;
    rdfs:range xsd:string ;
    skos:definition "A valve that is closed by the action of a weighted lever being released, the weight normally being prevented from dropping by being held by a wire, the closure normally being made by the action of heat on a fusible link in the wire;A valve that is opened and closed by the action of a float that rises and falls with water level. The float may be a ball attached to a lever or other mechanism;A valve that is opened and closed by hydraulic actuation;A valve that is opened and closed by the action of a lever rotating the gate within the valve.;A valve that requires the use of a special lockshield key for opening and closing, the operating mechanism being protected by a shroud during normal operation.;A valve that is opened and closed by the action of an electric motor on an actuator;A valve that is opened and closed by pneumatic actuation;A valve that is normally held open by a magnetic field in a coil acting on the gate but that is closed immediately if the electrical current generating the magnetic field is removed.;A valve that is normally held in position by the pressure of a spring on a plate but that may be caused to open if the pressure of the fluid is sufficient to overcome the spring pressure.;A valve in which the ports are opened or closed to maintain a required predetermined temperature.;A valve that is opened and closed by the action of a wheel moving the gate within the valve." ;
    meta:allowedValue "{'Code': 'DROPWEIGHT', 'Value': 'DROPWEIGHT', 'Description': 'A valve that is closed by the action of a weighted lever being released'}",
        "{'Code': 'FLOAT', 'Value': 'FLOAT', 'Description': 'the closure normally being made by the action of heat on a fusible link in the wire;A valve that is opened and closed by the action of a float that rises and falls with water level'}",
        "{'Code': 'HYDRAULIC', 'Value': 'HYDRAULIC', 'Description': 'The float may be a ball attached to a lever or other mechanism;A valve that is opened and closed by hydraulic actuation;A valve that is opened and closed by the action of a lever rotating the gate within the valve'}",
        "{'Code': 'LEVER', 'Value': 'LEVER', 'Description': 'A valve that is closed by the action of a weighted lever being released'}",
        "{'Code': 'LOCKSHIELD', 'Value': 'LOCKSHIELD', 'Description': 'A valve that requires the use of a special lockshield key for opening and closing'}",
        "{'Code': 'MOTORIZED', 'Value': 'MOTORIZED', 'Description': 'A valve that is opened and closed by the action of an electric motor on an actuator;A valve that is opened and closed by pneumatic actuation;A valve that is normally held open by a magnetic field in a coil acting on the gate but that is closed immediately if the electrical current generating the magnetic field is removed'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'The float may be a ball attached to a lever or other mechanism;A valve that is opened and closed by hydraulic actuation;A valve that is opened and closed by the action of a lever rotating the gate within the valve'}",
        "{'Code': 'PNEUMATIC', 'Value': 'PNEUMATIC', 'Description': 'A valve that is opened and closed by the action of an electric motor on an actuator;A valve that is opened and closed by pneumatic actuation;A valve that is normally held open by a magnetic field in a coil acting on the gate but that is closed immediately if the electrical current generating the magnetic field is removed'}",
        "{'Code': 'SOLENOID', 'Value': 'SOLENOID', 'Description': 'A valve that is opened and closed by the action of an electric motor on an actuator;A valve that is opened and closed by pneumatic actuation;A valve that is normally held open by a magnetic field in a coil acting on the gate but that is closed immediately if the electrical current generating the magnetic field is removed'}",
        "{'Code': 'SPRING', 'Value': 'SPRING', 'Description': 'A valve that is normally held in position by the pressure of a spring on a plate but that may be caused to open if the pressure of the fluid is sufficient to overcome the spring pressure'}",
        "{'Code': 'THERMOSTATIC', 'Value': 'THERMOSTATIC', 'Description': 'A valve in which the ports are opened or closed to maintain a required predetermined temperature'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WHEEL', 'Value': 'WHEEL', 'Description': 'A valve that is opened and closed by the action of a wheel moving the gate within the valve'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ValveOperation" .

ifc:ValvePattern a owl:DatatypeProperty ;
    rdfs:label "Valve Pattern" ;
    rdfs:range xsd:string ;
    skos:definition "Valve that has a single entry port from the system that it serves, the exit port being to the surrounding environment.;Valve in which the direction of flow is changed through 90 degrees.;Valve in which the flow is straight through.;Valve with three separate ports.;Valve with 4 separate ports." ;
    meta:allowedValue "{'Code': 'ANGLED_2_PORT', 'Value': 'ANGLED_2_PORT', 'Description': 'Valve in which the direction of flow is changed through 90 degrees'}",
        "{'Code': 'CROSSOVER_4_PORT', 'Value': 'CROSSOVER_4_PORT', 'Description': 'Valve with 4 separate ports'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SINGLEPORT', 'Value': 'SINGLEPORT', 'Description': 'Valve that has a single entry port from the system that it serves'}",
        "{'Code': 'STRAIGHT_2_PORT', 'Value': 'STRAIGHT_2_PORT', 'Description': 'Valve in which the flow is straight through'}",
        "{'Code': 'STRAIGHT_3_PORT', 'Value': 'STRAIGHT_3_PORT', 'Description': 'Valve with three separate ports'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ValvePattern" .

