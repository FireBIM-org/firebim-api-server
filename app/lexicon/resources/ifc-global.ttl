ifc:MarkerType a owl:DatatypeProperty ;
    rdfs:label "Marker Type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of marker (sign) e.g. stop signal, restriction signal, track circuit tuning zone sign or others specified in PEnum_MarkerType." ;
    meta:allowedValue "{'Code': 'APPROACHING_MARKER', 'Value': 'APPROACHING_MARKER', 'Description': 'Approach Ing Marker'}",
        "{'Code': 'CABLE_POST_MARKER', 'Value': 'CABLE_POST_MARKER', 'Description': 'Cable Post Marker'}",
        "{'Code': 'COMMUNICATION_MODE_CONVERSION_MARKER', 'Value': 'COMMUNICATION_MODE_CONVERSION_MARKER', 'Description': 'Communication Mode Conversion Marker'}",
        "{'Code': 'EMU_STOP_POSITION_SIGN', 'Value': 'EMU_STOP_POSITION_SIGN', 'Description': 'Emu Stop Position Sign'}",
        "{'Code': 'FOUR_ASPECT_CAB_SIGNAL_CONNECT_SIGN', 'Value': 'FOUR_ASPECT_CAB_SIGNAL_CONNECT_SIGN', 'Description': 'Four Aspect Cab Signal Connect Sign'}",
        "{'Code': 'FOUR_ASPECT_CAB_SIGNAL_DISCONNECT_SIGN', 'Value': 'FOUR_ASPECT_CAB_SIGNAL_DISCONNECT_SIGN', 'Description': 'Four Aspect Cab Signal Disconnect Sign'}",
        "{'Code': 'LEVEL_CONVERSION_SIGN', 'Value': 'LEVEL_CONVERSION_SIGN', 'Description': 'Level Conversion Sign'}",
        "{'Code': 'LOCOMOTIVE_STOP_POSITION_SIGN', 'Value': 'LOCOMOTIVE_STOP_POSITION_SIGN', 'Description': 'Locomotive Stop Position Sign'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'track circuit tuning zone sign or others specified in PEnum_MarkerType'}",
        "{'Code': 'RELAY_STATION_SIGN', 'Value': 'RELAY_STATION_SIGN', 'Description': 'Relay [[Station]] Sign'}",
        "{'Code': 'RESTRICTION_PLACE_SIGN', 'Value': 'RESTRICTION_PLACE_SIGN', 'Description': 'Restriction Place Sign'}",
        "{'Code': 'RESTRICTION_PROTECTION_AREA_TERMINAL_SIGN', 'Value': 'RESTRICTION_PROTECTION_AREA_TERMINAL_SIGN', 'Description': 'Restriction Protection [[Area]] Terminal Sign'}",
        "{'Code': 'RESTRICTION_SIGN', 'Value': 'RESTRICTION_SIGN', 'Description': 'Restriction Sign'}",
        "{'Code': 'SECTION_SIGNAL_MARKER', 'Value': 'SECTION_SIGNAL_MARKER', 'Description': 'Section Signal Marker'}",
        "{'Code': 'STOP_SIGN', 'Value': 'STOP_SIGN', 'Description': 'Stop Sign'}",
        "{'Code': 'TRACK_CIRCUIT_TUNING_ZONE_SIGN', 'Value': 'TRACK_CIRCUIT_TUNING_ZONE_SIGN', 'Description': 'Track Circuit Tuning Zone Sign'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "MarkerType" .

