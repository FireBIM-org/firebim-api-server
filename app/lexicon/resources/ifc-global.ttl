ifc:IfcGroup a owl:Class ;
    rdfs:label "Group" ;
    rdfs:subClassOf ifc:IfcObject ;
    skos:definition "[[IfcGroup]] is an generalization of any arbitrary group. A group is a logical collection of objects. It does not have its own position, nor can it hold its own shape representation. Therefore a group is an aggregation under some non-geometrical / topological grouping aspects." ;
