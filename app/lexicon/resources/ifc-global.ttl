ifc:IfcFlowTerminal a owl:Class ;
    rdfs:label "Flow Terminal" ;
    rdfs:subClassOf ifc:IfcDistributionFlowElement ;
    skos:definition "The distribution flow element [[IfcFlowTerminal]] defines the occurrence of a permanently attached element that acts as a terminus or beginning of a distribution system (such as an air outlet, drain, water closet, or sink). A terminal is typically a point at which a system interfaces with an external environment. Its type is defined by IfcFlowTerminalType or its subtypes." ;
