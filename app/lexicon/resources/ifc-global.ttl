    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The shape form of the provision for void, the minimum set of agreed values includes 'Rectangle', 'Round', and 'Undefined'." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "VoidShape" .

ifc:Voltage a owl:DatatypeProperty ;
    rdfs:label "Voltage" ;
    rdfs:range xsd:decimal ;
    skos:definition "The actual voltage and operable range." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "Voltage" .

ifc:VoltageHistory a owl:ObjectProperty ;
    rdfs:label "Voltage History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Log of electrical voltage." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "VoltageHistory" .

ifc:VoltageLevel a owl:DatatypeProperty ;
    rdfs:label "Voltage Level" ;
    rdfs:range xsd:string ;
    skos:definition "The voltage levels for which the data of the instance is valid. More than one value may be selected in the enumeration." ;
    meta:allowedValue "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'U1000', 'Value': 'U1000', 'Description': '[[U1000]]'}",
        "{'Code': 'U230', 'Value': 'U230', 'Description': '[[U230]]'}",
        "{'Code': 'U400', 'Value': 'U400', 'Description': '[[U400]]'}",
        "{'Code': 'U440', 'Value': 'U440', 'Description': '[[U440]]'}",
        "{'Code': 'U525', 'Value': 'U525', 'Description': '[[U525]]'}",
        "{'Code': 'U690', 'Value': 'U690', 'Description': '[[U690]]'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "VoltageLevel" .

ifc:VoltageRegulationRate a owl:DatatypeProperty ;
    rdfs:label "Voltage Regulation Rate" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "When the input side voltage changes from the lowest allowable input value to the specified maximum value, the relative change value of the output voltage is the percentage of the rated output voltage." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "VoltageRegulationRate" .

