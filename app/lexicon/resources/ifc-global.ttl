ifc:IfcCommunicationsApplianceRADIOBLOCKCENTER a owl:Class ;
    rdfs:label "Radio Block Center" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcCommunicationsAppliance ;
    skos:definition "A radio block center is a specialised computing device in railway with specification for generating Movement Authorities (MA) and transmitting it to trains. It gets information from signalling control and from the trains in its section." ;
