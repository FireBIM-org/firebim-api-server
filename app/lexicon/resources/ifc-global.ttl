    rdfs:label "Electrical System Category" ;
    rdfs:range xsd:string ;
    skos:definition "Designates the voltage range of the circuit, according to IEC. [[HIGHVOLTAGE]] indicates >1000V AC or >1500V DV; [[LOWVOLTAGE]] indicates 50-1000V AC or 120-1500V DC; [[EXTRALOWVOLTAGE]] indicates <50V AC or <120V DC." ;
    meta:allowedValue "{'Code': 'EXTRALOWVOLTAGE', 'Value': 'EXTRALOWVOLTAGE', 'Description': '[[EXTRALOWVOLTAGE]] indicates <50V AC or <120V DC'}",
        "{'Code': 'HIGHVOLTAGE', 'Value': 'HIGHVOLTAGE', 'Description': '[[HIGHVOLTAGE]] indicates >1000V AC or >1500V DV'}",
        "{'Code': 'LOWVOLTAGE', 'Value': 'LOWVOLTAGE', 'Description': '[[LOWVOLTAGE]] indicates 50-1000V AC or 120-1500V DC'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElectricalSystemCategory" .

ifc:ElectricalSystemType a owl:DatatypeProperty ;
    rdfs:label "Electrical System Type" ;
    rdfs:range xsd:string ;
    skos:definition "For certain purposes of electrical regulations, IEC 60364 defines types of system using type identifiers. Assignment of identifiers depends upon the relationship of the source, and of exposed conductive parts of the installation, to Ground (Earth).TN type system, a system having one or more points of the source of energy directly earthed, the exposed conductive parts of the installation being connected to that point by protective conductors,; TN C type system, a TN type system in which neutral and protective functions are combined in a single conductor throughout the system,; TN S type system, a TN type system having separate neutral and protective conductors throughout the system,; TN C S type system, a TN type system in which neutral and protective functions are combined in a single conductor in part of the system,; TT type system, a system having one point of the source of energy directly earthed, the exposed conductive parts of the installation being connected to earth electrodes electrically independent of the earth electrodes of the source,; IT type system, a system having no direct connection between live parts and Earth, the exposed conductive parts of the electrical installation being earthed." ;
    meta:allowedValue "{'Code': 'IT', 'Value': 'IT', 'Description': 'IT type system'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TN', 'Value': 'TN', 'Description': 'TN type system'}",
        "{'Code': 'TN_C', 'Value': 'TN_C', 'Description': 'TN C'}",
        "{'Code': 'TN_C_S', 'Value': 'TN_C_S', 'Description': 'TN C S'}",
        "{'Code': 'TN_S', 'Value': 'TN_S', 'Description': 'TN S'}",
        "{'Code': 'TT', 'Value': 'TT', 'Description': 'TT type system'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElectricalSystemType" .

ifc:Electricity a owl:ObjectProperty ;
    rdfs:label "Electricity" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "The amount of electricity consumed during the period specified in the time series." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Electricity" .

ifc:ElectrificationType a owl:DatatypeProperty ;
    rdfs:label "Electrification Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of railway electrification." ;
    meta:allowedValue "{'Code': 'AC', 'Value': 'AC', 'Description': 'AC'}",
        "{'Code': 'DC', 'Value': 'DC', 'Description': 'DC'}",
        "{'Code': 'NON_ELECTRIFIED', 'Value': 'NON_ELECTRIFIED', 'Description': 'Non Electrified'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElectrificationType" .

ifc:ElectroMagneticStandardsCompliance a owl:ObjectProperty ;
    rdfs:label "Electro Magnetic Standards Compliance" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "Information about compliance with regard to electro magnetic related standards." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "ElectroMagneticStandardsCompliance" .

ifc:ElectroMagneticTrippingUnitType a owl:DatatypeProperty ;
    rdfs:label "Electro Magnetic Tripping Unit Type" ;
    rdfs:range xsd:string ;
    skos:definition "A list of the available types of electric magnetic tripping unit from which that required may be selected. These cover overload, none special, short circuit, motor protection and bi-metal tripping." ;
    meta:allowedValue "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OL', 'Value': 'OL', 'Description': 'OL'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TMP_BM', 'Value': 'TMP_BM', 'Description': 'TMP BM'}",
        "{'Code': 'TMP_MP', 'Value': 'TMP_MP', 'Description': 'TMP MP'}",
        "{'Code': 'TMP_SC', 'Value': 'TMP_SC', 'Description': 'TMP SC'}",
        "{'Code': 'TMP_STD', 'Value': 'TMP_STD', 'Description': 'TMP STD'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElectroMagneticTrippingUnitType" .

ifc:ElectronicFilterType a owl:DatatypeProperty ;
    rdfs:label "Electronic Filter Type" ;
    rdfs:range xsd:string ;
    skos:definition "[[Type]] of electronic filter." ;
    meta:allowedValue "{'Code': 'BANDPASSFLITER', 'Value': 'BANDPASSFLITER', 'Description': 'Band Passfliter'}",
        "{'Code': 'BANDSTOPFILTER', 'Value': 'BANDSTOPFILTER', 'Description': 'Band Stop Filter'}",
        "{'Code': 'FILTERCAPACITOR', 'Value': 'FILTERCAPACITOR', 'Description': 'Filter Capacitor'}",
        "{'Code': 'HARMONICFILTER', 'Value': 'HARMONICFILTER', 'Description': 'Harmonic Filter'}",
        "{'Code': 'HIGHPASSFILTER', 'Value': 'HIGHPASSFILTER', 'Description': 'High Pass Filter'}",
        "{'Code': 'LOWPASSFILTER', 'Value': 'LOWPASSFILTER', 'Description': 'Lowpass Filter'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElectronicFilterType" .

ifc:ElectronicMailAddresses a owl:DatatypeProperty ;
    rdfs:label "Electronic Mail Addresses" ;
    rdfs:range xsd:string ;
    skos:definition "The list of Email addresses at which Email messages may be received." ;
    meta:propertyValueKind "List" ;
    meta:sourceCode "ElectronicMailAddresses" .

ifc:ElectronicTrippingUnitType a owl:DatatypeProperty ;
    rdfs:label "Electronic Tripping Unit Type" ;
    rdfs:range xsd:string ;
    skos:definition "A list of the available types of electronic tripping unit from which that required may be selected." ;
    meta:allowedValue "{'Code': 'EP_BM', 'Value': 'EP_BM', 'Description': 'EP BM'}",
        "{'Code': 'EP_MP', 'Value': 'EP_MP', 'Description': 'EP MP'}",
        "{'Code': 'EP_SC', 'Value': 'EP_SC', 'Description': 'EP SC'}",
        "{'Code': 'EP_STD', 'Value': 'EP_STD', 'Description': 'EP STD'}",
        "{'Code': 'EP_TIMEDELAYED', 'Value': 'EP_TIMEDELAYED', 'Description': 'EP Time Delayed'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElectronicTrippingUnitType" .

ifc:ElementType a owl:DatatypeProperty ;
    rdfs:label "Element Type" ;
    rdfs:range xsd:string ;
    skos:definition "The type denotes a particular type that indicates the object further. The use has to be established at the level of instantiable subtypes. In particular it holds the user defined type, if the enumeration of the attribute 'PredefinedType' is set to [[USERDEFINED]]." ;
    meta:sourceCode "ElementType" .

ifc:Elevation a owl:DatatypeProperty ;
    rdfs:label "Elevation" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Elevation]] of the entity" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Elevation" .

ifc:ElevationOfFFLRelative a owl:DatatypeProperty ;
    rdfs:label "Elevation of FFL Relative" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Elevation]] of the top surface of the finished floor level given in elevation above the local zero height. If the level varies and there is no significantly more prominent elevation, then this property may be omitted. In case of any inconsistency with the geometric positioning of the top surface, the geometric representation takes precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElevationOfFFLRelative" .

ifc:ElevationOfRefHeight a owl:DatatypeProperty ;
    rdfs:label "Elevation of Ref Height" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Elevation]] above sea level of the reference height used for all storey elevation measures, equals to height 0.0. It is usually the ground floor level." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElevationOfRefHeight" .

ifc:ElevationOfSSLRelative a owl:DatatypeProperty ;
    rdfs:label "Elevation of SSL Relative" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Elevation]] of the top surface of the structural slab level given in elevation above the local zero height. If the level varies and there is no significantly more prominent elevation, then this property may be omitted. In case of any inconsistency with the geometric positioning of the top surface, the geometric representation takes precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElevationOfSSLRelative" .

ifc:ElevationOfTerrain a owl:DatatypeProperty ;
    rdfs:label "Elevation of Ter Rain" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Elevation]] above the minimal terrain level around the foot print of the building, given in elevation above sea level." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElevationOfTerrain" .

ifc:ElevationWithFlooring a owl:DatatypeProperty ;
    rdfs:label "Elevation with Flooring" ;
    rdfs:range xsd:decimal ;
    skos:definition "Level of flooring of this space; the average shall be taken, if the space ground surface is sloping or if there are level differences within this space." ;
    meta:sourceCode "ElevationWithFlooring" .

ifc:ElevationalFlatness a owl:DatatypeProperty ;
    rdfs:label "Elevational Flat Ness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicative (95%-100%) range flatness associated to the elevational surface in ZX, if different to the overall flatness." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ElevationalFlatness" .

ifc:Enabled a owl:ObjectProperty ;
    rdfs:label "Enabled" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates whether alarm is enabled or disabled over time." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Enabled" .

ifc:EncapsulationTechnologyCode a owl:DatatypeProperty ;
    rdfs:label "Encapsulation Technology Code" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcIdentifier' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Code indicating the encapsulation technology which has been applied in an electric, electronic or electromechanical component." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EncapsulationTechnologyCode" .

ifc:EndDate a owl:DatatypeProperty ;
    rdfs:label "End Date" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcDateTime' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Date and time at which the permit ceases to be valid." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EndDate" .

ifc:EndShapeType a owl:DatatypeProperty ;
    rdfs:label "End Shape Type" ;
    rdfs:range xsd:string ;
    skos:definition "Defines the types of end shapes that can be used for preformed tanks. The convention for reading these enumerated values is that for a vertical cylinder, the first value is the base and the second is the top; for a horizontal cylinder, the order of reading should be left to right. For a speherical tank, the value [[UNSET]] should be used." ;
    meta:allowedValue "{'Code': 'CONCAVECONVEX', 'Value': 'CONCAVECONVEX', 'Description': 'Concave Convex'}",
        "{'Code': 'CONCAVEFLAT', 'Value': 'CONCAVEFLAT', 'Description': 'Concave Flat'}",
        "{'Code': 'CONVEXCONVEX', 'Value': 'CONVEXCONVEX', 'Description': 'Convex Convex'}",
        "{'Code': 'FLATCONVEX', 'Value': 'FLATCONVEX', 'Description': 'Flat Convex'}",
        "{'Code': 'FLATFLAT', 'Value': 'FLATFLAT', 'Description': 'Flat Flat'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'the value [[UNSET]] should be used'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EndShapeType" .

ifc:EnergyAbsorption a owl:DatatypeProperty ;
    rdfs:label "Energy Absorption" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcEnergyMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Energy absorption capacity of the element." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyAbsorption" .

ifc:EnergyAbsorptionTolerance a owl:DatatypeProperty ;
    rdfs:label "Energy Absorption Tolerance" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Manufacturing tolerance on energy absorption" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyAbsorptionTolerance" .

ifc:EnergyConsumption a owl:DatatypeProperty ;
    rdfs:label "Energy Consumption" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcEnergyMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Annual energy consumption requirement" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyConsumption" .

ifc:EnergyConversionEfficiency a owl:DatatypeProperty ;
    rdfs:label "Energy Conversion Efficiency" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Measure of the efficiency of conversion of fuel energy to mechanical energy" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyConversionEfficiency" .

ifc:EnergyEfficiencyRatio a owl:ObjectProperty ;
    rdfs:label "Energy Efficiency Ratio" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Energy efficiency ratio (EER)." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "EnergyEfficiencyRatio" .

ifc:EnergyGainSensible a owl:DatatypeProperty ;
    rdfs:label "Energy Gain Sensible" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The sum of total energy gains for the spaces served by the system during the peak cooling conditions, plus any system-level sensible energy gains." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyGainSensible" .

ifc:EnergyGainTotal a owl:DatatypeProperty ;
    rdfs:label "Energy Gain Total" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The total amount of energy gains for the spaces served by the system during the peak cooling conditions, plus any system-level total energy gains." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyGainTotal" .

ifc:EnergyLoss a owl:DatatypeProperty ;
    rdfs:label "Energy Loss" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The sum of energy losses for the spaces served by the system during the peak heating conditions." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergyLoss" .

ifc:EnergySource a owl:DatatypeProperty ;
    rdfs:label "Energy Source" ;
    rdfs:range xsd:string ;
    skos:definition "Enumeration defining the energy source or fuel cumbusted." ;
    meta:allowedValue "{'Code': 'COAL', 'Value': 'COAL', 'Description': 'Coal'}",
        "{'Code': 'COAL_PULVERIZED', 'Value': 'COAL_PULVERIZED', 'Description': 'Coal Pulverized'}",
        "{'Code': 'ELECTRICITY', 'Value': 'ELECTRICITY', 'Description': '[[Electricity]]'}",
        "{'Code': 'GAS', 'Value': 'GAS', 'Description': 'Gas'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OIL', 'Value': 'OIL', 'Description': 'Oil'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PROPANE', 'Value': 'PROPANE', 'Description': 'Propane'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WOOD', 'Value': 'WOOD', 'Description': 'Wood'}",
        "{'Code': 'WOOD_CHIP', 'Value': 'WOOD_CHIP', 'Description': 'Wood Chip'}",
        "{'Code': 'WOOD_PELLET', 'Value': 'WOOD_PELLET', 'Description': 'Wood Pellet'}",
        "{'Code': 'WOOD_PULVERIZED', 'Value': 'WOOD_PULVERIZED', 'Description': 'Wood Pulverized'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "EnergySource" .

ifc:EnergySourceConsumption a owl:ObjectProperty ;
    rdfs:label "Energy Source Consumption" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Energy consumption." ;
