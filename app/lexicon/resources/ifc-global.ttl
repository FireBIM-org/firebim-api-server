    meta:sourceCode "ShortCircuit1PoleMinimumState" .

ifc:ShortCircuit1PolePowerFactorMaximumState a owl:DatatypeProperty ;
    rdfs:label "Short Circuit 1Pole Power Factor Maximum State" ;
