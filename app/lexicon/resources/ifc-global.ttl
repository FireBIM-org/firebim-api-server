    meta:sourceCode "BentSpacing" .

ifc:BerthApproach a owl:DatatypeProperty ;
    rdfs:label "Berth Approach" ;
    rdfs:range xsd:string ;
    skos:definition "How the vessel approaches the berth" ;
    meta:allowedValue "{'Code': 'END', 'Value': 'END', 'Description': 'End'}",
        "{'Code': 'SIDE', 'Value': 'SIDE', 'Description': '[[Side]]'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BerthApproach" .

