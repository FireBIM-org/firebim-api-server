ifc:CapacityControl a owl:DatatypeProperty ;
    rdfs:label "Capacity Control" ;
    rdfs:range xsd:string ;
    skos:definition "Fan is cycled on and off to control duty.;Fan is switched between low and high speed to control duty.;Fan speed is varied to control duty.;Dampers modulate the air flow to control duty.;Bypass valve modulates the water flow to control duty.;Turn on/off multiple series pump to control duty.;Switch between high/low pump speed to control duty.;vary pump speed to control duty." ;
    meta:allowedValue "{'Code': 'BYPASSVALVECONTROL', 'Value': 'BYPASSVALVECONTROL', 'Description': 'Bypass valve modulates the water flow to control duty'}",
        "{'Code': 'DAMPERSCONTROL', 'Value': 'DAMPERSCONTROL', 'Description': 'Dampers modulate the air flow to control duty'}",
        "{'Code': 'FANCYCLING', 'Value': 'FANCYCLING', 'Description': 'Fan is cycled on and off to control duty'}",
        "{'Code': 'MULTIPLESERIESPUMPS', 'Value': 'MULTIPLESERIESPUMPS', 'Description': 'Turn on/off multiple series pump to control duty'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TWOSPEEDFAN', 'Value': 'TWOSPEEDFAN', 'Description': 'Fan is switched between low and high speed to control duty'}",
        "{'Code': 'TWOSPEEDPUMP', 'Value': 'TWOSPEEDPUMP', 'Description': 'Switch between high/low pump speed to control duty'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VARIABLESPEEDFAN', 'Value': 'VARIABLESPEEDFAN', 'Description': 'Fan speed is varied to control duty'}",
        "{'Code': 'VARIABLESPEEDPUMP', 'Value': 'VARIABLESPEEDPUMP', 'Description': 'vary pump speed to control duty'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CapacityControl" .

ifc:CapacityControlType a owl:DatatypeProperty ;
    rdfs:label "Capacity Control Type" ;
    rdfs:range xsd:string ;
    skos:definition "Control by adjusting inlet vane.;Control by variable speed drive.;Control by adjusting blade pitch angle.;Control by switch between high and low speed.;Control by modulating discharge damper." ;
    meta:allowedValue "{'Code': 'BLADEPITCHANGLE', 'Value': 'BLADEPITCHANGLE', 'Description': 'Control by adjusting blade pitch angle'}",
        "{'Code': 'DISCHARGEDAMPER', 'Value': 'DISCHARGEDAMPER', 'Description': 'Control by modulating discharge damper'}",
        "{'Code': 'INLETVANE', 'Value': 'INLETVANE', 'Description': 'Control by adjusting inlet vane'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TWOSPEED', 'Value': 'TWOSPEED', 'Description': 'Control by switch between high and low speed'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VARIABLESPEEDDRIVE', 'Value': 'VARIABLESPEEDDRIVE', 'Description': 'Control by variable speed drive'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CapacityControlType" .

ifc:CapacityCurve a owl:ObjectProperty ;
    rdfs:label "Capacity Curve" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Chiller cooling capacity is a function of condensing temperature and evaporating temperature, data is in table form, [[Capacity]] = f (TempCon, TempEvp), capacity = a1+b1*Tei+c1*Tei\\2+d1*Tci+e1*Tci\\2+f1*Tei*Tci.; This table uses multiple input variables; to represent, both DefiningValues and DefinedValues lists are null and IfcTable is attached using IfcResourceConstraintRelationship and IfcMetric.; 1.[[Capacity]]; 2.[[CondensingTemperature]]; 3.[[EvaporatingTemperature]]" ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CapacityCurve" .

ifc:CapacityPeople a owl:DatatypeProperty ;
    rdfs:label "Capacity People" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcCountMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:integer ;
    skos:definition "[[Capacity]] of the transportation element measured in numbers of person." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CapacityPeople" .

ifc:CapacityWeight a owl:DatatypeProperty ;
    rdfs:label "Capacity Weight" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcMassMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
