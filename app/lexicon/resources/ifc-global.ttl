ifc:IfcContext a owl:Class ;
    rdfs:label "Context" ;
    rdfs:subClassOf ifc:IfcObjectDefinition ;
    skos:definition "[[IfcContext]] is the generalization of a project context in which objects, type objects, property sets, and properties are defined. The [[IfcProject]] as subtype of [[IfcContext]] provides the context for all information on a construction project, it may include one or several [[IfcProjectLibrary]]'s as subtype of [[IfcContext]] to register the included libraries for the project. A library of products that is referenced is declared within the [[IfcProjectLibrary]] as the context of that library." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:Description_from_Attributes,
        ifc:GlobalId_from_Attributes,
        ifc:LongName_from_Attributes,
        ifc:Name_from_Attributes,
        ifc:ObjectType_from_Attributes,
        ifc:Phase_from_Attributes ;
    meta:parentClassCode "IfcObjectDefinition" ;
    meta:sourceCode "IfcContext" ;
    meta:uid "2ef4dae0-8e0d-4c3e-a179-bf7d2f279492" .

ifc:IfcCooledBeam a owl:Class ;
    rdfs:label "Cooled Beam" ;
    rdfs:subClassOf ifc:IfcEnergyConversionDevice ;
    skos:definition "A cooled beam (or chilled beam) is a device typically used to cool air by circulating a fluid such as chilled water through exposed finned tubes above a space. Typically mounted overhead near or within a ceiling, the cooled beam uses convection to cool the space below it by acting as a heat sink for the naturally rising warm air of the space. Once cooled, the air naturally drops back to the floor where the cycle begins again." ;
    meta:classType "Class" ;
