ifc:IfcObjectDefinition a owl:Class ;
    rdfs:label "Object Definition" ;
    rdfs:subClassOf ifc:IfcRoot ;
    skos:definition "An [[IfcObjectDefinition]] is the generalization of any semantically treated thing or process, either being a type or an occurrence. Object definitions can be named, using the inherited [[Name]] attribute, which should be a user recognizable label for the object occurrence. Further explanations to the object can be given using the inherited [[Description]] attribute. A context is a specific kind of object definition as it provides the project or library context in which object types and object occurrences are defined." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:Description_from_Attributes,
        ifc:GlobalId_from_Attributes,
        ifc:Name_from_Attributes ;
    meta:parentClassCode "IfcRoot" ;
    meta:sourceCode "IfcObjectDefinition" ;
    meta:uid "40ee8a1b-c5dc-4107-8d14-cb784713b9e5" .

ifc:IfcOpeningElement a owl:Class ;
    rdfs:label "Opening Element" ;
    rdfs:subClassOf ifc:IfcFeatureElementSubtraction ;
    skos:definition "The opening element stands for opening, recess or chase, all reflecting voids. It represents a void within any element that has physical manifestation. Openings can be inserted into walls, slabs, beams, columns, or other elements." ;
