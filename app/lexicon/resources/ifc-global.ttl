        "{'Code': 'VARIABLEAIRVOLUMEVARIABLETEMPERATURE', 'Value': 'VARIABLEAIRVOLUMEVARIABLETEMPERATURE', 'Description': 'Variable Air [[Volume]] Variable [[Temperature]]'}" ;
