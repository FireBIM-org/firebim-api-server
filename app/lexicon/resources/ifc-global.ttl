ifc:IfcSurfaceFeature a owl:Class ;
    rdfs:label "Surface Feature" ;
    rdfs:subClassOf ifc:IfcFeatureElement ;
    skos:definition "A surface feature is a modification at (onto, or into) of the surface of an element. Parts of the surface of the entire surface may be affected. The volume and mass of the element may be increased, remain unchanged, or be decreased by the surface feature, depending on manufacturing technology. However, any increase or decrease of volume is small compared to the total volume of the element." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:AcceptanceDate_from_InstallationOccurrence,
        ifc:AccidentResponse_from_MaintenanceStrategy,
        ifc:AcquisitionDate_from_ManufacturerOccurrence,
        ifc:Area_from_SurfaceFeatureBaseQuantities,
        ifc:ArticleNumber_from_ManufacturerTypeInformation,
        ifc:AssemblyPlace_from_ManufacturerOccurrence,
        ifc:AssemblyPlace_from_ManufacturerTypeInformation,
        ifc:AssessmentCondition_from_Condition,
        ifc:AssessmentDate_from_Condition,
        ifc:AssessmentDescription_from_Condition,
        ifc:AssessmentFrequency_from_Condition,
