ifc:TrackElementOrientation a owl:DatatypeProperty ;
    rdfs:label "Track Element Orientation" ;
    rdfs:range xsd:string ;
    skos:definition "Turnout panels can be placed in 2 mirror-symmetric directions in the field. To distinguish both ends of the turnout panel, a definition of an orientation system with respect to the panel is necessary. The orientation defines, if the panel is oriented in a way or opposite with respect to the direction of the alignment/stationing." ;
    meta:allowedValue "{'Code': 'BACK', 'Value': 'BACK', 'Description': 'Back'}",
        "{'Code': 'FRONT', 'Value': 'FRONT', 'Description': 'Front'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TrackElementOrientation" .

