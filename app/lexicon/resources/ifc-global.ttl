ifc:ShowerType a owl:DatatypeProperty ;
    rdfs:label "Shower Type" ;
    rdfs:range xsd:string ;
    skos:definition "Shower that rapidly gives a thorough soaking in an emergency.; Shower unit that is typically enclosed and is for the use of one person at a time.; Shower that has a succession of shower heads or spreaders that operate simultaneously along its length." ;
    meta:allowedValue "{'Code': 'DRENCH', 'Value': 'DRENCH', 'Description': 'Shower that rapidly gives a thorough soaking in an emergency'}",
        "{'Code': 'INDIVIDUAL', 'Value': 'INDIVIDUAL', 'Description': 'Shower unit that is typically enclosed and is for the use of one person at a time'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TUNNEL', 'Value': 'TUNNEL', 'Description': 'Shower that has a succession of shower heads or spreaders that operate simultaneously along its length'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ShowerType" .

ifc:Side a owl:DatatypeProperty ;
    rdfs:label "Side" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies if the width is measured to the [[RIGHT]] or to the [[LEFT]] of the curve referenced by the placement, or if the same value is applied to [[BOTH]] sides." ;
    meta:allowedValue "{'Code': 'BOTH', 'Value': 'BOTH', 'Description': 'or if the same value is applied to [[BOTH]] sides'}",
        "{'Code': 'LEFT', 'Value': 'LEFT', 'Description': 'Specifies if the width is measured to the [[RIGHT]] or to the [[LEFT]] of the curve referenced by the placement'}",
        "{'Code': 'RIGHT', 'Value': 'RIGHT', 'Description': 'Specifies if the width is measured to the [[RIGHT]] or to the [[LEFT]] of the curve referenced by the placement'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Side" .

