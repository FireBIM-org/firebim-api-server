        "{'Code': 'DOUBLECHECKBACKFLOWPREVENTER', 'Value': 'DOUBLECHECKBACKFLOWPREVENTER', 'Description': 'Double Check Back Flow Preventer'}",
        "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PRESSUREVACUUMBREAKER', 'Value': 'PRESSUREVACUUMBREAKER', 'Description': '[[Pressure]] Vacuum Breaker'}",
        "{'Code': 'REDUCEDPRESSUREBACKFLOWPREVENTER', 'Value': 'REDUCEDPRESSUREBACKFLOWPREVENTER', 'Description': 'Reduced [[Pressure]] Back Flow Preventer'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BackflowPreventerType" .

