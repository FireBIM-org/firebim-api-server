ifc:RadiatedOutputPowerPerAntenna a owl:ObjectProperty ;
    rdfs:label "Radiated Output Power Per Antenna" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the power of radio waves emitted by each antenna of the base transceiver station." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "RadiatedOutputPowerPerAntenna" .

ifc:RadiationPattern a owl:DatatypeProperty ;
    rdfs:label "Radiation Pattern" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the radiation pattern of antenna." ;
    meta:allowedValue "{'Code': 'DIRECTIONAL', 'Value': 'DIRECTIONAL', 'Description': 'Directional'}",
        "{'Code': 'FANBEAM', 'Value': 'FANBEAM', 'Description': 'Fanbeam'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OMNIDIRECTIONAL', 'Value': 'OMNIDIRECTIONAL', 'Description': 'Omni Directional'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PENCILBEAM', 'Value': 'PENCILBEAM', 'Description': 'Pencilbeam'}",
        "{'Code': 'SHAPEDBEAM', 'Value': 'SHAPEDBEAM', 'Description': 'Shape Dbeam'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RadiationPattern" .

ifc:RadiatorType a owl:DatatypeProperty ;
    rdfs:label "Radiator Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of radiator." ;
    meta:allowedValue "{'Code': 'FINNEDTUBE', 'Value': 'FINNEDTUBE', 'Description': 'Finned Tube'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PANEL', 'Value': 'PANEL', 'Description': 'Panel'}",
        "{'Code': 'SECTIONAL', 'Value': 'SECTIONAL', 'Description': 'Sectional'}",
        "{'Code': 'TUBULAR', 'Value': 'TUBULAR', 'Description': 'Tubular'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RadiatorType" .

