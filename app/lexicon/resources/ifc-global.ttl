ifc:CharacteristicFunction a owl:DatatypeProperty ;
    rdfs:label "Characteristic Function" ;
    rdfs:range xsd:string ;
    skos:definition "The characteristic function to show the relationship between varistor current and voltage." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CharacteristicFunction" .

ifc:CharacteristicImpedance a owl:DatatypeProperty ;
    rdfs:label "Characteristic Impedance" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricResistanceMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "; Z1 = S/ I2; Z2 = U2 / S; Z3 = U / I; where Z is the complex characteristic impedance, S the complex power and U and I are the values, usually complex, respectively of a voltage and a current conventionally defined for each type of mode by analogy with transmission line equations." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CharacteristicImpedance" .

ifc:ChargePressure a owl:DatatypeProperty ;
