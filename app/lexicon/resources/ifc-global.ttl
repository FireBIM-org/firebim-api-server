        ifc:AssetPriority_from_MaintenanceStrategy,
        ifc:AssociatedActivity_from_Risk,
        ifc:AssociatedLocation_from_Risk,
        ifc:AssociatedProduct_from_Risk,
        ifc:AtmosphericAcidificationPerUnit_from_Envir___ators,
        ifc:AtmosphericAcidification_from_Environm___ctValues,
