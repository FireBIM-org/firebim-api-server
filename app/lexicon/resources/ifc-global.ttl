        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConnectedConductorFunction" .

ifc:ConnectionGender a owl:DatatypeProperty ;
    rdfs:label "Connection Gender" ;
    rdfs:range xsd:string ;
    skos:definition "The physical connection gender." ;
    meta:allowedValue "{'Code': 'FEMALE', 'Value': 'FEMALE', 'Description': 'Female'}",
        "{'Code': 'MALE', 'Value': 'MALE', 'Description': 'Male'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConnectionGender" .

ifc:ConnectionSize a owl:DatatypeProperty ;
    rdfs:label "Connection Size" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The connection size of the object." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConnectionSize" .

ifc:ConnectionSubtype a owl:DatatypeProperty ;
    rdfs:label "Connection Subtype" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The physical port connection subtype that further qualifies the [[ConnectionType]].A, B, C, D, E, F, EF, G, H, I, J, K, L, M;Mini3P, Mini4P, Mini5P, Mini6P, Mini7P, Mini8P, Mini9P;DA15, DB25, DC37, DD50, DE9, DE15;RC5720;A, B, C;IEEE802.11g, IEEE802.11n;4P4C, 6P2C, 8P8C;E-11, E-12, E-14, E-17, E-26, E-27, E-39, E-40;TS_Mini, TS_SubMini, TRS_Mini, TRS_SubMini" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConnectionSubtype" .

ifc:ConnectionType a owl:DatatypeProperty ;
    rdfs:label "Connection Type" ;
