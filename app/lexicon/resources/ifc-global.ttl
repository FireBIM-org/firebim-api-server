ifc:FountainType a owl:DatatypeProperty ;
    rdfs:label "Fountain Type" ;
    rdfs:range xsd:string ;
    skos:definition "Sanitary appliance that provides a low pressure jet of drinking water.; Waste water appliance, usually installed in work places where there is a risk of injury to eyes by solid particles or dangerous liquids, with which the user can wash the eyes without touching them." ;
    meta:allowedValue "{'Code': 'DRINKINGWATER', 'Value': 'DRINKINGWATER', 'Description': 'Sanitary appliance that provides a low pressure jet of drinking water'}",
        "{'Code': 'EYEWASH', 'Value': 'EYEWASH', 'Description': 'Waste water appliance'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FountainType" .

