ifc:MaintenanceLevel a owl:DatatypeProperty ;
    rdfs:label "Maintenance Level" ;
    rdfs:range xsd:decimal ;
    skos:definition "Adjustment of the service life resulting from the effect of the level or degree of maintenance applied to dcomponents." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "MaintenanceLevel" .

ifc:MaintenanceType a owl:DatatypeProperty ;
    rdfs:label "Maintenance Type" ;
    rdfs:range xsd:string ;
    skos:definition "generated as a result of the condition of an asset or artefact being less than a determined value.;generated as a result of an immediate and urgent need for maintenance action.;generated as a result of immediate corrective action being needed but with sufficient time available for the work order to be included in maintenance planning.;generated as a result of a fixed, periodic maintenance requirement." ;
    meta:allowedValue "{'Code': 'CONDITIONBASED', 'Value': 'CONDITIONBASED', 'Description': 'generated as a result of the condition of an asset or artefact being less than a determined value'}",
        "{'Code': 'CORRECTIVE', 'Value': 'CORRECTIVE', 'Description': 'generated as a result of an immediate and urgent need for maintenance action'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PLANNEDCORRECTIVE', 'Value': 'PLANNEDCORRECTIVE', 'Description': 'generated as a result of immediate corrective action being needed but with sufficient time available for the work order to be included in maintenance planning'}",
        "{'Code': 'SCHEDULED', 'Value': 'SCHEDULED', 'Description': 'generated as a result of a fixed'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "MaintenanceType" .

