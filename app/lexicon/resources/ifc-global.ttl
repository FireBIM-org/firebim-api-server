    rdfs:range xsd:string ;
    skos:definition "Indicates the local identification number of the track." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TrackNumber" .

ifc:TrackSupportingStructure a owl:DatatypeProperty ;
    rdfs:label "Track Supporting Structure" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the supporting structure for track part." ;
    meta:allowedValue "{'Code': 'BRIDGE', 'Value': 'BRIDGE', 'Description': 'Bridge'}",
