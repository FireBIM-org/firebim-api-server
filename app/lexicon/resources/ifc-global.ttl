ifc:IfcStairSPIRAL_STAIR a owl:Class ;
    rdfs:label "Spiral Stair" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcStair ;
    skos:definition "A stair constructed with winders around a circular newel often without landings. Depending on outer boundary it can be either a circular, elliptical or rectangular spiral stair. The orientation of the winding stairs is determined by the walking line." ;
