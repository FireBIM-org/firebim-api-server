ifc:GrossArea a owl:DatatypeProperty ;
    rdfs:label "Gross Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Gross [[Area]] of the object. Openings, recesses, projections and cut-outs are not taken into account." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossArea" .

ifc:GrossCeilingArea a owl:DatatypeProperty ;
    rdfs:label "Gross Ceiling Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Sum of all ceiling areas of the space. It includes the area covered by elementsinside the space (columns, inner walls, etc.). The ceiling area is the real (and not the projected) area (e.g. in case of sloped ceilings)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossCeilingArea" .

ifc:GrossCrossSectionArea a owl:DatatypeProperty ;
    rdfs:label "Gross Cross Section Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Area]] of the cross section." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossCrossSectionArea" .

ifc:GrossFloorArea a owl:DatatypeProperty ;
    rdfs:label "Gross Floor Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Sum of all gross floor areas within the spatial structure element." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossFloorArea" .

ifc:GrossFootPrintArea a owl:DatatypeProperty ;
    rdfs:label "Gross Foot Print Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Area]] of the wall as viewed by a ground floor view, not taking any wall modifications (like recesses) into account. It is also referred to as the foot print of the wall." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossFootPrintArea" .

ifc:GrossHeight a owl:DatatypeProperty ;
    rdfs:label "Gross Height" ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Standard]] gross height of this storey, from the top surface of the construction floor, to the top surface of the construction floor or roof above. Only provided is there is a constant height." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossHeight" .

ifc:GrossPerimeter a owl:DatatypeProperty ;
    rdfs:label "Gross Peri Meter" ;
    rdfs:range xsd:decimal ;
    skos:definition "Gross perimeter at the outer contour of the object." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossPerimeter" .

ifc:GrossPlannedArea a owl:DatatypeProperty ;
    rdfs:label "Gross Planned Area" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcAreaMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Total planned gross area of the spatial structure element. Used for programming the spatial structure element." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossPlannedArea" .

ifc:GrossSideArea a owl:DatatypeProperty ;
    rdfs:label "Gross Side Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Area]] of the wall as viewed by an elevation view of the middle plane of the wall. It does not take into account any wall modifications (such as openings)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossSideArea" .

ifc:GrossSurfaceArea a owl:DatatypeProperty ;
    rdfs:label "Gross Surface Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Total gross area of the object, normally generated as perimeter * length + 2 * cross section area. It is the sum of [[OuterSurfaceArea]] + (2 x [[CrossSectionArea]]) and shall only be given, if the [[OuterSurfaceArea]] and [[CrossSectionArea]] cannot be established separately." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossSurfaceArea" .

ifc:GrossVolume a owl:DatatypeProperty ;
    rdfs:label "Gross Volume" ;
    rdfs:range xsd:decimal ;
    skos:definition "Total gross volume of the object. Openings, recesses, enclosed objects and projections are not taken into account." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossVolume" .

ifc:GrossWallArea a owl:DatatypeProperty ;
    rdfs:label "Gross Wall Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Sum of all wall (and other vertically bounding elements, like columns) areas bounded by the space. It includes the area covered by elements inside the wall area (doors, windows, other openings, etc.)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossWallArea" .

ifc:GrossWeight a owl:DatatypeProperty ;
    rdfs:label "Gross Weight" ;
    rdfs:range xsd:decimal ;
    skos:definition "Total Gross [[Weight]] of the object without any add-on parts and not taking into account possible processing features (cut-out's, etc.) or openings and recesses." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GrossWeight" .

