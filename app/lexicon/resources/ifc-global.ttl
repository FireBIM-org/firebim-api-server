        "{'Code': 'RACK', 'Value': 'RACK', 'Description': 'Indicates the characteristic of the track'}",
        "{'Code': 'RIGIDOVERHEAD', 'Value': 'RIGIDOVERHEAD', 'Description': 'Rigid Overhead'}",
