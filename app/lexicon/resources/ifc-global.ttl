ifc:IfcDamperGRAVITYRELIEFDAMPER a owl:Class ;
    rdfs:label "Gravity Relief Damper" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcDamper ;
    skos:definition "Gravity-relief damper used to allow air to move upon a buildup of enough pressure to overcome the gravitational force exerted upon the damper blades. Commonly operated by gravitational weight." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:AcceptanceDate_from_InstallationOccurrence,
        ifc:AccidentResponse_from_MaintenanceStrategy,
        ifc:AcquisitionDate_from_ManufacturerOccurrence,
        ifc:AirFlowRate_from_DamperPHistory,
        ifc:ArticleNumber_from_ManufacturerTypeInformation,
        ifc:AssemblyPlace_from_ManufacturerOccurrence,
        ifc:AssemblyPlace_from_ManufacturerTypeInformation,
