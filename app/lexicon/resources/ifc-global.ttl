        "{'Code': 'MODERATE', 'Value': 'MODERATE', 'Description': 'Moderate'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SOME', 'Value': 'SOME', 'Description': 'Some'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VERYHIGH', 'Value': 'VERYHIGH', 'Description': 'Very High'}",
        "{'Code': 'VERYLOW', 'Value': 'VERYLOW', 'Description': 'Very Low'}" ;
    meta:propertyValueKind "Single" ;
