ifc:RailGap a owl:DatatypeProperty ;
    rdfs:label "Rail Gap" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The gap between the rail profiles." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RailGap" .

ifc:RailPadStiffness a owl:DatatypeProperty ;
    rdfs:label "Rail Pad Stiffness" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the stiffness of a rail pad." ;
    meta:allowedValue "{'Code': 'MEDIUM', 'Value': 'MEDIUM', 'Description': 'Medium'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SOFT', 'Value': 'SOFT', 'Description': 'Soft'}",
        "{'Code': 'STIFF', 'Value': 'STIFF', 'Description': 'Indicates the stiffness of a rail pad'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RailPadStiffness" .

ifc:RailwayBaliseType a owl:DatatypeProperty ;
    rdfs:label "Railway Balise Type" ;
    rdfs:range xsd:string ;
    skos:definition "[[Type]] of the railway balise." ;
    meta:allowedValue "{'Code': 'ACTIVEBALISE', 'Value': 'ACTIVEBALISE', 'Description': 'Activebalise'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
