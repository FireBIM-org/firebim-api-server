ifc:IfcVibrationDamperAXIAL_YIELD a owl:Class ;
    rdfs:label "Axial Yield" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcVibrationDamper ;
    skos:definition "A displacement dependent type damper in which the resistance force generated is determined by the plastic strain amount utilizing the plastic deformation of the steel material. The axial yield type is a damper that yields energy by absorbing the steel material against deformation in the axial direction, that is, in the direction of expansion and contraction." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:AcceptanceDate_from_InstallationOccurrence,
        ifc:AccidentResponse_from_MaintenanceStrategy,
        ifc:AcquisitionDate_from_ManufacturerOccurrence,
