        ifc:InsulationVoltage_from_CableSegment___CableSegment,
        ifc:MassPerLength_from_CableSegmentTypeCableSegment,
        ifc:MaximumBendingRadius_from_CableSegme___bleSegment,
        ifc:MaximumCurrent_from_CableSegmentTypeCableSegment,
        ifc:MaximumOperatingTemperature_from_CableSe___Segment,
        ifc:MaximumShortCircuitTemperature_from_Cable___gment,
        ifc:NumberOfCores_from_CableSegmentTypeCableSegment,
        ifc:NumberOfWires_from_CableSegmentTypeCableSegment,
        ifc:OverallDiameter_from_CableSegmentTypeCableSegment,
        ifc:RatedTemperature_from_CableSegmentTypeCableSegment,
        ifc:RatedVoltage_from_CableSegmentTypeCableSegment,
        ifc:ScreenDiameter_from_CableSegmentTypeCableSegment,
        ifc:SelfExtinguishing60332_1_from_CableSeg___eSegment,
        ifc:SelfExtinguishing60332_3_from_CableSeg___eSegment,
        ifc:SpecialConstruction_from_CableSegmen___ableSegment,
        ifc:Standard_from_CableSegmentTypeCableSegment,
