ifc:IfcCommunicationsApplianceREPEATER a owl:Class ;
    rdfs:label "Repeater" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcCommunicationsAppliance ;
    skos:definition "A repeater is an electronic device that receives a signal and retransmits it at a higher level and/or higher power, or onto the other side of an obstruction, so that the signal can cover longer distances without degradation." ;
