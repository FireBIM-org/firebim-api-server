    skos:definition "Identifies the predefined types of trap from which the type required may be set." ;
    meta:allowedValue "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'P_TRAP', 'Value': 'P_TRAP', 'Description': 'P Trap'}",
        "{'Code': 'Q_TRAP', 'Value': 'Q_TRAP', 'Description': 'Q Trap'}",
        "{'Code': 'S_TRAP', 'Value': 'S_TRAP', 'Description': 'S Trap'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TrapType" .

ifc:TreadLength a owl:DatatypeProperty ;
    rdfs:label "Tread Length" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Horizontal distance from the front of the thread to the front of the next tread.; The tread length is supposed to be equal for all steps of the stair or stair flight at the walking line." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TreadLength" .

ifc:TreadLengthAtInnerSide a owl:DatatypeProperty ;
    rdfs:label "Tread Length at Inner Side" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum length of treads at the inner side of the winder.; Only relevant in case of winding flights, for straight flights it is identical with [[IfcStairFlight]].[[TreadLength]]. It is a pre-calculated value, in case of inconsistencies, the value derived from the shape representation shall take precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TreadLengthAtInnerSide" .

ifc:TreadLengthAtOffset a owl:DatatypeProperty ;
    rdfs:label "Tread Length at Off Set" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Length]] of treads at a given offset.; Walking line position is given by the '[[WalkingLineOffset]]'. The resulting value should normally be identical with [[TreadLength]], it may be given in addition, if the walking line offset for building code calculations is different from that used in design." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TreadLengthAtOffset" .

ifc:TrippingCurve a owl:ObjectProperty ;
    rdfs:label "Tripping Curve" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "A curve that establishes the release time of a tripping unit when a particular prospective current is applied.(1) Defining value is the Prospective [[Current]] which is a list of minimum 2 and maximum 16 numbers providing the currents in x In for points in the current/time log/log coordinate space. The curve is drawn as a straight line between two consecutive points.; (2) Defined value is a list of minimum 2 and maximum 16 numbers providing the release_time in s for points in the current/time log/log coordinate space. The curve is drawn as a straight line between two consecutive points. Note that a defined interpolation." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "TrippingCurve" .

ifc:TrippingCurveType a owl:DatatypeProperty ;
    rdfs:label "Tripping Curve Type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of tripping curve that is represented by the property set." ;
    meta:allowedValue "{'Code': 'LOWER', 'Value': 'LOWER', 'Description': 'Lower'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'UPPER', 'Value': 'UPPER', 'Description': 'Upper'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TrippingCurveType" .

ifc:TrippingUnitReleaseCurrent a owl:DatatypeProperty ;
    rdfs:label "Tripping Unit Release Current" ;
    rdfs:range xsd:string ;
    skos:definition "The value of tripping or residual current for which the device has the possibility to be equipped. The values are given in mA." ;
