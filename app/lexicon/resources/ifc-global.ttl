ifc:UrinalType a owl:DatatypeProperty ;
    rdfs:label "Urinal Type" ;
    rdfs:range xsd:string ;
    skos:definition "Individual wall mounted urinal.;Urinal that consists of a slab or sheet fixed to a wall and down which urinal flows into a floor channel.;Floor mounted urinal that consists of an elliptically shaped sanitary stall fixed to a wall and down which urine flows into a floor channel.;Wall mounted urinal of elongated rectangular shape on plan, that can be used by more than one person at a time." ;
