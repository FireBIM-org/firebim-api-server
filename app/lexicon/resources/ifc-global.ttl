ifc:FluidPressureRange a owl:DatatypeProperty ;
    rdfs:label "Fluid Pressure Range" ;
    rdfs:range xsd:decimal ;
    skos:definition "Allowable water working pressure range inside the tube." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "FluidPressureRange" .

ifc:FlushRate a owl:DatatypeProperty ;
    rdfs:label "Flush Rate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The minimum and maximum volume of water used at each flush. Where a single flush is used, the value of upper bound and lower bound should be equal. For a dual flush toilet, the lower bound should be used for the lesser flush rate and the upper bound for the greater flush rate. Where flush is achieved using mains pressure water through a flush valve, the value of upper and lower bound should be equal and should be the same as the flush rate property of the flush valve (see relevant valve property set). Alternatively, in this case, do not assert the flush rate property; refer to the flush rate of the flush valve." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "FlushRate" .

ifc:FlushType a owl:DatatypeProperty ;
    rdfs:label "Flush Type" ;
    rdfs:range xsd:string ;
    skos:definition "Flushing is achieved by twisting a lever that causes a predetermined flow of water to be passed from a cistern to the sanitary terminal.; Flushing is achieved by pulling a handle or knob vertically upwards that causes a predetermined flow of water to be passed from a cistern to the sanitary terminal.; Flushing is achieved by pushing a button or plate that causes a predetermined flow of water to be passed from a cistern to the sanitary terminal.;Flush is activated through an automatic sensing mechanism." ;
    meta:allowedValue "{'Code': 'LEVER', 'Value': 'LEVER', 'Description': 'Flushing is achieved by twisting a lever that causes a predetermined flow of water to be passed from a cistern to the sanitary terminal'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PULL', 'Value': 'PULL', 'Description': 'Flushing is achieved by pulling a handle or knob vertically upwards that causes a predetermined flow of water to be passed from a cistern to the sanitary terminal'}",
        "{'Code': 'PUSH', 'Value': 'PUSH', 'Description': 'Flushing is achieved by pushing a button or plate that causes a predetermined flow of water to be passed from a cistern to the sanitary terminal'}",
        "{'Code': 'SENSOR', 'Value': 'SENSOR', 'Description': 'Flush is activated through an automatic sensing mechanism'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlushType" .

ifc:FlushingRate a owl:DatatypeProperty ;
    rdfs:label "Flushing Rate" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcVolumetricFlowRateMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The predetermined quantity of water to be flushed." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FlushingRate" .

ifc:FootPrintArea a owl:DatatypeProperty ;
    rdfs:label "Foot Print Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Gross area of the site covered by the building(s)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FootPrintArea" .

ifc:Force a owl:DatatypeProperty ;
    rdfs:label "Force" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcForceMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
