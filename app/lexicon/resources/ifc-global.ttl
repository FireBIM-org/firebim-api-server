ifc:IfcActionRequestEMAIL a owl:Class ;
    rdfs:label "Email" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcActionRequest ;
    skos:definition "Request was made through email." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:Description_from_Attributes,
        ifc:GlobalId_from_Attributes,
        ifc:Identification_from_Attributes,
        ifc:LongDescription_from_Attributes,
        ifc:Name_from_Attributes,
        ifc:ObjectType_from_Attributes,
        ifc:RequestComments_from_ActionRequest,
        ifc:RequestSourceLabel_from_ActionRequest,
