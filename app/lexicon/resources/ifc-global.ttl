ifc:IfcStructuralLoadGroup a owl:Class ;
    rdfs:label "Structural Load Group" ;
    rdfs:subClassOf ifc:IfcGroup ;
    skos:definition "The entity [[IfcStructuralLoadGroup]] is used to structure the physical impacts. By using the grouping features inherited from [[IfcGroup]], instances of [[IfcStructuralAction]] (or its subclasses) and of [[IfcStructuralLoadGroup]] can be used to define load groups, load cases and load combinations. (See also IfcLoadGroupTypeEnum.)" ;
