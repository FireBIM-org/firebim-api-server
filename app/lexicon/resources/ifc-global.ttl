ifc:ContactorType a owl:DatatypeProperty ;
    rdfs:label "Contact or Type" ;
    rdfs:range xsd:string ;
    skos:definition "for switching 3 phase single or multi-step capacitor banks.;requires the use of low resistance contacts.;enables the contactor to remain in the on position when the coil is no longer energized.;requires that the contactor is mechanically retained in the on position.;are totally enclosed and self contained.;has a double set of contactors that are prewired.;is a generic device that controls the flow of power in a circuit on or off." ;
    meta:allowedValue "{'Code': 'CAPACITORSWITCHING', 'Value': 'CAPACITORSWITCHING', 'Description': 'for switching 3 phase single or multi-step capacitor banks'}",
        "{'Code': 'LOWCURRENT', 'Value': 'LOWCURRENT', 'Description': 'requires the use of low resistance contacts'}",
        "{'Code': 'MAGNETICLATCHING', 'Value': 'MAGNETICLATCHING', 'Description': 'enables the contactor to remain in the on position when the coil is no longer energized'}",
        "{'Code': 'MECHANICALLATCHING', 'Value': 'MECHANICALLATCHING', 'Description': 'requires that the contactor is mechanically retained in the on position'}",
        "{'Code': 'MODULAR', 'Value': 'MODULAR', 'Description': 'are totally enclosed and self contained'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'REVERSING', 'Value': 'REVERSING', 'Description': 'has a double set of contactors that are prewired'}",
        "{'Code': 'STANDARD', 'Value': 'STANDARD', 'Description': 'is a generic device that controls the flow of power in a circuit on or off'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ContactorType" .

