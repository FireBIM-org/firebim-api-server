ifc:ConditionTermination a owl:DatatypeProperty ;
    rdfs:label "Condition Termination" ;
    rdfs:range xsd:string ;
    skos:definition "Condition of property required on termination of the agreement e.g. cold shell, warm lit shell, broom clean, turn-key." ;
