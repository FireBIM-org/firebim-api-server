ifc:WorkDayDuration a owl:DatatypeProperty ;
    rdfs:label "Work Day Duration" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcDuration' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The elapsed time within a worktime-based day. For presentation purposes, applications may choose to display [[IfcTask]] durations in work days where IfcTaskTime.DurationType=WORKTIME. This value must be less than or equal to 24 hours (an elapsed day); if omitted then 8 hours is assumed." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WorkDayDuration" .

