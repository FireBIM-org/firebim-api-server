    skos:definition "A textual description of the products that require the work." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProductDescription" .

ifc:ProductionLotId a owl:DatatypeProperty ;
    rdfs:label "Production Lot ID" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcIdentifier' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The manufacturer's production lot identifier." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProductionLotId" .

ifc:ProductionYear a owl:DatatypeProperty ;
    rdfs:label "Production Year" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The year of production of the manufactured item." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProductionYear" .

ifc:ProjectInvestmentEstimate a owl:ObjectProperty ;
    rdfs:label "Project Investment Estimate" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcAppliedValue. Read the IFC documentation for more information." ;
    skos:definition "Estimate of investment cost" ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "ProjectInvestmentEstimate" .

ifc:ProjectType a owl:DatatypeProperty ;
    rdfs:label "Project Type" ;
    rdfs:range xsd:string ;
    skos:definition "Additional typing of a project" ;
    meta:allowedValue "{'Code': 'MODIFICATION', 'Value': 'MODIFICATION', 'Description': 'Modification'}",
        "{'Code': 'NEWBUILD', 'Value': 'NEWBUILD', 'Description': 'Newbuild'}",
        "{'Code': 'OPERATIONMAINTENANCE', 'Value': 'OPERATIONMAINTENANCE', 'Description': '[[Operation]] Maintenance'}",
        "{'Code': 'RENOVATION', 'Value': 'RENOVATION', 'Description': 'Renovation'}",
        "{'Code': 'REPAIR', 'Value': 'REPAIR', 'Description': 'Repair'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProjectType" .

ifc:ProjectedArea a owl:DatatypeProperty ;
    rdfs:label "Projected Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Total gross area of the outer surfaces of the roof, projected tp the ground. It is the sum of all projected roof slab gross areas. Roof openings, like sky windows and other openings and cut-outs are not taken into account." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProjectedArea" .

ifc:ProjectedOrTrue a owl:DatatypeProperty ;
    rdfs:label "Projected Or True" ;
    rdfs:range xsd:string ;
    skos:definition "Defines whether load values are given per true length of the curve on which they act, or per length of the projection of the curve in load direction. The latter is only applicable to loads which act in global coordinate directions." ;
    meta:allowedValue "{'Code': 'PROJECTED_LENGTH', 'Value': 'PROJECTED_LENGTH', 'Description': 'Projected [[Length]]'}",
        "{'Code': 'TRUE_LENGTH', 'Value': 'TRUE_LENGTH', 'Description': 'True [[Length]]'}" ;
    meta:sourceCode "ProjectedOrTrue" .

ifc:ProjectorType a owl:DatatypeProperty ;
    rdfs:label "Projector Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of projector." ;
    meta:allowedValue "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProjectorType" .

ifc:PropagationSpeedCoefficient a owl:DatatypeProperty ;
    rdfs:label "Propagation Speed Coefficient" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the propagation speed coefficient." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "PropagationSpeedCoefficient" .

ifc:PropertyName a owl:DatatypeProperty ;
    rdfs:label "Property Name" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Addressing details of the property as stated within the agreement." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "PropertyName" .

ifc:ProportionalConstant a owl:DatatypeProperty ;
    rdfs:label "Proportional Constant" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The proportional gain factor of the controller (usually referred to as Kp)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProportionalConstant" .

ifc:ProportionalStress a owl:DatatypeProperty ;
    rdfs:label "Proportional Stress" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPressureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "A measure of the proportional stress of the material. It describes the stress before the first plastic deformation occurs and is commonly measured at a deformation of 0.01%." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProportionalStress" .

ifc:ProtectivePoreRatio a owl:DatatypeProperty ;
    rdfs:label "Protective Pore Ratio" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The protective pore ratio indicating the frost-resistance of the concrete." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ProtectivePoreRatio" .

ifc:Protocols a owl:DatatypeProperty ;
    rdfs:label "Protocols" ;
    rdfs:range xsd:string ;
    skos:definition "For data ports, identifies the protocols used as defined by the Open [[System]] Interconnection (OSI) Basic Reference Model (ISO 7498).1. Physical; 2. DataLink; 3. Network; 4. Transport; 5. Session; 6. Presentation; 7. [[Application]].IP,TCP,HTTP" ;
    meta:propertyValueKind "List" ;
    meta:sourceCode "Protocols" .

