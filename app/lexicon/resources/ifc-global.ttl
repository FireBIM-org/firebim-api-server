        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RailwayCommunicationTerminalType" .

ifc:RailwaySignalType a owl:DatatypeProperty ;
    rdfs:label "Railway Signal Type" ;
    rdfs:range xsd:string ;
    skos:definition "The type of railway signal, e.g. home signal, starting signal, shunting signal, level crossing signal." ;
    meta:allowedValue "{'Code': 'APPROACHSIGNAL', 'Value': 'APPROACHSIGNAL', 'Description': 'Approach Signal'}",
        "{'Code': 'BLOCKSIGNAL', 'Value': 'BLOCKSIGNAL', 'Description': 'Block Signal'}",
        "{'Code': 'DISTANTSIGNAL', 'Value': 'DISTANTSIGNAL', 'Description': 'Distant Signal'}",
        "{'Code': 'HOMESIGNAL', 'Value': 'HOMESIGNAL', 'Description': 'Home Signal'}",
        "{'Code': 'HUMPAUXILIARYSIGANL', 'Value': 'HUMPAUXILIARYSIGANL', 'Description': 'Hump Auxiliary Siganl'}",
        "{'Code': 'HUMPSIGNAL', 'Value': 'HUMPSIGNAL', 'Description': 'Hump Signal'}",
        "{'Code': 'LEVELCROSSINGSIGNAL', 'Value': 'LEVELCROSSINGSIGNAL', 'Description': 'Level Crossing Signal'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OBSTRUCTIONSIGNAL', 'Value': 'OBSTRUCTIONSIGNAL', 'Description': 'Obstruction Signal'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'REPEATINGSIGNAL', 'Value': 'REPEATINGSIGNAL', 'Description': 'Repeating Signal'}",
        "{'Code': 'SHUNTINGSIGNAL', 'Value': 'SHUNTINGSIGNAL', 'Description': 'Shunting Signal'}",
        "{'Code': 'STARTINGSIGNAL', 'Value': 'STARTINGSIGNAL', 'Description': 'Starting Signal'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RailwaySignalType" .

