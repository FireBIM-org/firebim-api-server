    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The sensible heat or energy gained by the space during the peak conditions." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SensibleHeatGain" .

ifc:SensibleHeatRatio a owl:DatatypeProperty ;
    rdfs:label "Sensible Heat Ratio" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Air-side sensible heat ratio, or fraction of sensible heat transfer to the total heat transfer." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SensibleHeatRatio" .

ifc:SensibleHeatTransferRate a owl:ObjectProperty ;
    rdfs:label "Sensible Heat Transfer Rate" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Sensible heat transfer rate." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "SensibleHeatTransferRate" .

ifc:SensibleLoadToRadiant a owl:DatatypeProperty ;
    rdfs:label "Sensible Load to Radiant" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Percent of sensible thermal load to radiant heat." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SensibleLoadToRadiant" .

ifc:Sensitivity a owl:DatatypeProperty ;
