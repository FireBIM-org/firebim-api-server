ifc:BatchReference a owl:DatatypeProperty ;
    rdfs:label "Batch Reference" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcIdentifier' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The identity of the batch reference from which an occurrence of a product is taken." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BatchReference" .

ifc:BathType a owl:DatatypeProperty ;
    rdfs:label "Bath Type" ;
    rdfs:range xsd:string ;
    skos:definition "The property enumeration defines the types of bath that may be specified within the property set." ;
    meta:allowedValue "{'Code': 'DOMESTIC', 'Value': 'DOMESTIC', 'Description': 'Domestic'}",
        "{'Code': 'FOOT', 'Value': 'FOOT', 'Description': 'Foot'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PLUNGE', 'Value': 'PLUNGE', 'Description': 'Plunge'}",
        "{'Code': 'POOL', 'Value': 'POOL', 'Description': 'Pool'}",
        "{'Code': 'SITZ', 'Value': 'SITZ', 'Description': 'Sitz'}",
        "{'Code': 'SPA', 'Value': 'SPA', 'Description': 'Spa'}",
        "{'Code': 'TREATMENT', 'Value': 'TREATMENT', 'Description': 'Treatment'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BathType" .

ifc:BatterAtEnd a owl:DatatypeProperty ;
    rdfs:label "Batter at End" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPlaneAngleMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The angle, in radians, by which the formwork at the ending face of a piece is to be rotated from the vertical in order to compensate for the rotation of the face that will occur once the piece is stripped from its form, inducing camber due to eccentric prestressing." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BatterAtEnd" .

ifc:BatterAtStart a owl:DatatypeProperty ;
    rdfs:label "Batter at Start" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPlaneAngleMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The angle, in radians, by which the formwork at the starting face of a piece is to be rotated from the vertical in order to compensate for the rotation of the face that will occur once the piece is stripped from its form, inducing camber due to eccentric prestressing." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BatterAtStart" .

ifc:BatteryChargingType a owl:DatatypeProperty ;
    rdfs:label "Battery Charging Type" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the predefined types of battery charging." ;
    meta:allowedValue "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RECHARGEABLE', 'Value': 'RECHARGEABLE', 'Description': 'Rechargeable'}",
        "{'Code': 'SINGLECHARGE', 'Value': 'SINGLECHARGE', 'Description': 'Single Charge'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BatteryChargingType" .

ifc:BeamCoolingCapacity a owl:ObjectProperty ;
    rdfs:label "Beam Cooling Capacity" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Cooling capacity of beam. This excludes cooling capacity of supply air." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "BeamCoolingCapacity" .

ifc:BeamHeatingCapacity a owl:ObjectProperty ;
    rdfs:label "Beam Heating Capacity" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Heating capacity of beam. This excludes heating capacity of supply air." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "BeamHeatingCapacity" .

ifc:BearingStrength a owl:ObjectProperty ;
    rdfs:label "Bearing Strength" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "α;bearing strength of bolt holes, i.e. intrados pressure." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "BearingStrength" .

ifc:BendAngle a owl:DatatypeProperty ;
    rdfs:label "Bend Angle" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositivePlaneAngleMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The change of direction of flow." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BendAngle" .

ifc:BendRadius a owl:DatatypeProperty ;
    rdfs:label "Bend Radius" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The radius of bending if circular arc or zero if sharp bend." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BendRadius" .

ifc:BendingShapeCode a owl:DatatypeProperty ;
    rdfs:label "Bending Shape Code" ;
    rdfs:range xsd:string ;
    skos:definition "Shape code per a standard like ACI 315, ISO 3766, or a similar standard. It is presumed that a single standard for defining the bar bending is used throughout the project and that this standard is referenced from the [[IfcProject]] object through the IfcDocumentReference mechanism." ;
    meta:sourceCode "BendingShapeCode" .

ifc:BendingStrength a owl:DatatypeProperty ;
    rdfs:label "Bending Strength" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPressureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Bending strength." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "BendingStrength" .

ifc:BentSpacing a owl:DatatypeProperty ;
    rdfs:label "Bent Spacing" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Bent (upright) spacing" ;
