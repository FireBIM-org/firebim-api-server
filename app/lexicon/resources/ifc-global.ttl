ifc:SwitchDisconnectorType a owl:DatatypeProperty ;
    rdfs:label "Switch Disconnector Type" ;
    rdfs:range xsd:string ;
    skos:definition "A disconnector in which both contacts of each pole are movable and engage at a point substantially midway between their supports. (IEC 441-14-08);A disconnector in which the fixed and moving contacts of each pole are not supported by a common base or frame. (IEC 441-14-06);A disconnector that opens a circuit at two points. (IEC 441-14-09);A disconnector in which the fixed and moving contacts of each pole are not supported by a common base or frame. (IEC 441-14-07);A disconnector which in the open position satisfies isolating requirements. (IEC 441-14-12)" ;
    meta:allowedValue "{'Code': 'CENTERBREAK', 'Value': 'CENTERBREAK', 'Description': 'A disconnector in which both contacts of each pole are movable and engage at a point substantially midway between their supports'}",
        "{'Code': 'DIVIDEDSUPPORT', 'Value': 'DIVIDEDSUPPORT', 'Description': '(IEC 441-14-08);A disconnector in which the fixed and moving contacts of each pole are not supported by a common base or frame'}",
        "{'Code': 'DOUBLEBREAK', 'Value': 'DOUBLEBREAK', 'Description': '(IEC 441-14-06);A disconnector that opens a circuit at two points'}",
        "{'Code': 'EARTHINGSWITCH', 'Value': 'EARTHINGSWITCH', 'Description': '(IEC 441-14-09);A disconnector in which the fixed and moving contacts of each pole are not supported by a common base or frame'}",
        "{'Code': 'ISOLATOR', 'Value': 'ISOLATOR', 'Description': '(IEC 441-14-07);A disconnector which in the open position satisfies isolating requirements'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SwitchDisconnectorType" .

