    meta:allowedValue "{'Code': 'BOILERCONTROLLER', 'Value': 'BOILERCONTROLLER', 'Description': 'Boiler Controller'}",
        "{'Code': 'CONSTANTLIGHTCONTROLLER', 'Value': 'CONSTANTLIGHTCONTROLLER', 'Description': 'Constant Light Controller'}",
        "{'Code': 'DISCHARGEAIRCONTROLLER', 'Value': 'DISCHARGEAIRCONTROLLER', 'Description': 'Discharge Air Controller'}",
        "{'Code': 'FANCOILUNITCONTROLLER', 'Value': 'FANCOILUNITCONTROLLER', 'Description': 'Fan Coil Unit Controller'}",
        "{'Code': 'LIGHTINGPANELCONTROLLER', 'Value': 'LIGHTINGPANELCONTROLLER', 'Description': 'Light Ing Panel Controller'}",
        "{'Code': 'MODEMCONTROLLER', 'Value': 'MODEMCONTROLLER', 'Description': 'Modem Controller'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OCCUPANCYCONTROLLER', 'Value': 'OCCUPANCYCONTROLLER', 'Description': 'Occupancy Controller'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PARTITIONWALLCONTROLLER', 'Value': 'PARTITIONWALLCONTROLLER', 'Description': 'Partition Wall Controller'}",
        "{'Code': 'PUMPCONTROLLER', 'Value': 'PUMPCONTROLLER', 'Description': 'Pump Controller'}",
        "{'Code': 'REALTIMEBASEDSCHEDULER', 'Value': 'REALTIMEBASEDSCHEDULER', 'Description': 'Real Time Based Schedule R'}",
        "{'Code': 'REALTIMEKEEPER', 'Value': 'REALTIMEKEEPER', 'Description': 'Real Time Keeper'}",
        "{'Code': 'ROOFTOPUNITCONTROLLER', 'Value': 'ROOFTOPUNITCONTROLLER', 'Description': 'Roof Top Unit Controller'}",
        "{'Code': 'SCENECONTROLLER', 'Value': 'SCENECONTROLLER', 'Description': 'Scene Controller'}",
        "{'Code': 'SPACECONFORTCONTROLLER', 'Value': 'SPACECONFORTCONTROLLER', 'Description': 'Space Confort Controller'}",
        "{'Code': 'SUNBLINDCONTROLLER', 'Value': 'SUNBLINDCONTROLLER', 'Description': 'Sunblind Controller'}",
        "{'Code': 'TELEPHONEDIRECTORY', 'Value': 'TELEPHONEDIRECTORY', 'Description': 'Telephonedirectory'}",
        "{'Code': 'UNITVENTILATORCONTROLLER', 'Value': 'UNITVENTILATORCONTROLLER', 'Description': 'Unit Ventilator Controller'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VAV', 'Value': 'VAV', 'Description': 'Vav'}" ;
