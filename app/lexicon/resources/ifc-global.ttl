ifc:IfcWindow a owl:Class ;
    rdfs:label "Window" ;
    rdfs:subClassOf ifc:IfcBuiltElement ;
    skos:definition "The window is a building element that is predominately used to provide natural light and fresh air. It includes vertical opening but also horizontal opening such as skylights or light domes. It includes constructions with swinging, pivoting, sliding, or revolving panels and fixed panels. A window consists of a lining and one or several panels." ;
