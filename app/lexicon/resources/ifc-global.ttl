        "{'Code': 'SINGLETOUCH', 'Value': 'SINGLETOUCH', 'Description': 'Single Touch'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TouchScreen" .

