    meta:sourceCode "TransformationRatio" .

ifc:TransformerVectorGroup a owl:DatatypeProperty ;
    rdfs:label "Transformer Vector Group" ;
    rdfs:range xsd:string ;
    skos:definition "List of the possible vector groups for the transformer from which that required may be set. Values in the enumeration list follow a standard international code where the first letter describes how the primary windings are connected,; the second letter describes how the secondary windings are connected, and the numbers describe the rotation of voltages and currents from the primary to the secondary side in multiples of 30 degrees.means that the windings are delta-connected.;means that the windings are star-connected.;means that the windings are zig-zag connected (a special start-connected providing low reactance of the transformer);; The connectivity is only relevant for three-phase transformers." ;
    meta:allowedValue "{'Code': 'DD0', 'Value': 'DD0', 'Description': 'Dd0'}",
        "{'Code': 'DD6', 'Value': 'DD6', 'Description': 'Dd6'}",
        "{'Code': 'DY11', 'Value': 'DY11', 'Description': 'Dy11'}",
        "{'Code': 'DY5', 'Value': 'DY5', 'Description': 'Dy5'}",
        "{'Code': 'DZ0', 'Value': 'DZ0', 'Description': 'Dz0'}",
        "{'Code': 'DZ6', 'Value': 'DZ6', 'Description': 'Dz6'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'YD11', 'Value': 'YD11', 'Description': 'Yd11'}",
        "{'Code': 'YD5', 'Value': 'YD5', 'Description': 'Yd5'}",
        "{'Code': 'YY0', 'Value': 'YY0', 'Description': 'Yy0'}",
        "{'Code': 'YY6', 'Value': 'YY6', 'Description': 'Yy6'}",
        "{'Code': 'YZ11', 'Value': 'YZ11', 'Description': 'Yz11'}",
        "{'Code': 'YZ5', 'Value': 'YZ5', 'Description': 'Yz5'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TransformerVectorGroup" .

