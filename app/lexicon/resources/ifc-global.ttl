    rdfs:label "Actuator" ;
    rdfs:subClassOf ifc:IfcDistributionControlElement ;
    skos:definition "An actuator is a mechanical device for moving or controlling a mechanism or system. An actuator takes energy, usually created by air, electricity, or liquid, and converts that into some kind of motion." ;
