ifc:InsulationStandardClass a owl:DatatypeProperty ;
    rdfs:label "Insulation Standard Class" ;
    rdfs:range xsd:string ;
    skos:definition "Insulation standard classes provides basic protection information against electric shock. Defines levels of insulation required in terms of constructional requirements (creepage and clearance distances) and electrical requirements (compliance with electric strength tests). Basic insulation is considered to be shorted under single fault conditions. The actual values required depend on the working voltage to which the insulation is subjected, as well as other factors. Also indicates whether the electrical device has a protective earth connection." ;
    meta:allowedValue "{'Code': 'CLASS0APPLIANCE', 'Value': 'CLASS0APPLIANCE', 'Description': 'Class 0 Appliance'}",
        "{'Code': 'CLASS0IAPPLIANCE', 'Value': 'CLASS0IAPPLIANCE', 'Description': 'Class 0I Appliance'}",
        "{'Code': 'CLASSIAPPLIANCE', 'Value': 'CLASSIAPPLIANCE', 'Description': 'Class I Appliance'}",
        "{'Code': 'CLASSIIAPPLIANCE', 'Value': 'CLASSIIAPPLIANCE', 'Description': 'Class II Appliance'}",
        "{'Code': 'CLASSIIIAPPLIANCE', 'Value': 'CLASSIIIAPPLIANCE', 'Description': 'Class III Appliance'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'as well as other factors'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "InsulationStandardClass" .

ifc:InsulationVoltage a owl:DatatypeProperty ;
