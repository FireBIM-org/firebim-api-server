ifc:IfcMobileTelecommunicationsApplianceBASETRANSCEIVE a owl:Class ;
    rdfs:label "Base Transceivers Tation" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcMobileTelecommunicationsAppliance ;
    skos:definition "A base transceiver station (BTS) is a network component which serves one cell. It completes the conversion between base station controller and wireless channel, and realizes the wireless transmission and related control functions between base station controller and mobile switching through the air interface." ;
