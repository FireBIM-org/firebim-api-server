ifc:IfcRampFlight a owl:Class ;
    rdfs:label "Ramp Flight" ;
    rdfs:subClassOf ifc:IfcBuiltElement ;
    skos:definition "A ramp comprises a single inclined segment, or several inclined segments that are connected by a horizontal segment, referred to as a landing. A ramp flight is the single inclined segment and part of the ramp construction. In case of single flight ramps, the ramp flight and the ramp are identical." ;
