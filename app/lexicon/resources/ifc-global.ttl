    meta:sourceCode "TotalSensibleLoad" .

ifc:TotalSensibleLoadHistory a owl:ObjectProperty ;
    rdfs:label "Total Sensible Load History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Total energy added or removed from air that affects its temperature. If a value is less than zero (negative), then the thermal load is lost from the space. If a value is greater than zero (positive), then the thermal load is a gain to the space." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "TotalSensibleLoadHistory" .

ifc:TotalSurfaceArea a owl:DatatypeProperty ;
    rdfs:label "Total Surface Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Total surface area of the element." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TotalSurfaceArea" .

ifc:TotalUACurves a owl:ObjectProperty ;
    rdfs:label "Total Ua Curves" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Total UA curves, UA - air and water velocities, UA = (C1 * [[AirFlowRate]]\\0.8)\\-1 + (C2 * WaterFlowRate\\0.8)\\-1\\-1.as two variables are used, DefiningValues and DefinedValues are null,[[AirFlowRate]],WaterFlowRate,UA. The IfcTable is related to IfcPropertyTableValue using IfcMetric and IfcResourceConstraintRelationship." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "TotalUACurves" .

ifc:TotalWattage a owl:DatatypeProperty ;
    rdfs:label "Total Wattage" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Wattage on whole lightfitting device with all sources intact." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TotalWattage" .

