ifc:Quality a owl:ObjectProperty ;
    rdfs:label "Quality" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates the quality of measurement or failure condition, which may be further qualified by the [[Status]].measured values are considered reliable;measured values are considered not reliable (i.e. a fault has been detected);reliability of values is uncertain." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Quality" .

ifc:QualityHistory a owl:ObjectProperty ;
    rdfs:label "Quality History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates the quality of measurement or failure condition, which may be further qualified by the [[Status]].measured values are considered reliable;measured values are considered not reliable (i.e. a fault has been detected);reliability of values is uncertain." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "QualityHistory" .

ifc:QualityOfComponents a owl:DatatypeProperty ;
    rdfs:label "Quality of Components" ;
    rdfs:range xsd:decimal ;
    skos:definition "Adjustment of the service life resulting from the effect of the quality of components used." ;
    meta:propertyValueKind "Range" ;
    meta:sourceCode "QualityOfComponents" .

ifc:QuaySectionType a owl:DatatypeProperty ;
    rdfs:label "Quay Section Type" ;
    rdfs:range xsd:string ;
    skos:definition "Whether the structure presents a solid/closed barrier to the passage of water or is open." ;
    meta:allowedValue "{'Code': 'CLOSED', 'Value': 'CLOSED', 'Description': 'Whether the structure presents a solid/closed barrier to the passage of water or is open'}",
        "{'Code': 'OPEN', 'Value': 'OPEN', 'Description': 'Whether the structure presents a solid/closed barrier to the passage of water or is open'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "QuaySectionType" .

ifc:RMSWithstandVoltage a owl:DatatypeProperty ;
    rdfs:label "Rms with Stand Voltage" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricVoltageMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Rms value of sinusoidal power frequency voltage that the insulation of the given equipment can withstand during tests made under specified conditions and for a specified duration. (IEV ref 614-03-22" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RMSWithstandVoltage" .

ifc:ROI a owl:DatatypeProperty ;
    rdfs:label "Roi" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Return on Investment" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ROI" .

ifc:RRUConnectionType a owl:DatatypeProperty ;
    rdfs:label "Rruconnection Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the connection type between the remote radio unit and baseband unit." ;
    meta:allowedValue "{'Code': 'CHAIN', 'Value': 'CHAIN', 'Description': 'Chain'}",
        "{'Code': 'MIXED', 'Value': 'MIXED', 'Description': 'Mixed'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RING', 'Value': 'RING', 'Description': 'Ring'}",
        "{'Code': 'STAR', 'Value': 'STAR', 'Description': 'Star'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RRUConnectionType" .

ifc:RUConnectionType a owl:DatatypeProperty ;
    rdfs:label "Ruconnection Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicate the connection type between the remote unit and the master unit." ;
    meta:allowedValue "{'Code': 'CHAIN', 'Value': 'CHAIN', 'Description': 'Chain'}",
        "{'Code': 'MIXED', 'Value': 'MIXED', 'Description': 'Mixed'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RING', 'Value': 'RING', 'Description': 'Ring'}",
        "{'Code': 'STAR', 'Value': 'STAR', 'Description': 'Star'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "RUConnectionType" .

ifc:RadiantFrequency a owl:DatatypeProperty ;
    rdfs:label "Radiant Frequency" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcFrequencyMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the radiant frequency of the leaky coaxial cable (radiating cable)." ;
