ifc:ShearStrength a owl:DatatypeProperty ;
    rdfs:label "Shear Strength" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPressureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "α;shear strength." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ShearStrength" .

ifc:SheathColours a owl:DatatypeProperty ;
    rdfs:label "Sheath Colours" ;
    rdfs:range xsd:string ;
    skos:definition "[[Colour]] of the core (derived from IEC 60757). Note that the combined color 'GreenAndYellow' shall be used only as Protective Earth (PE) conductors according to the requirements of IEC 60446." ;
    meta:allowedValue "{'Code': 'BLACK', 'Value': 'BLACK', 'Description': 'Black'}",
        "{'Code': 'BLUE', 'Value': 'BLUE', 'Description': 'Blue'}",
        "{'Code': 'BROWN', 'Value': 'BROWN', 'Description': 'Brown'}",
        "{'Code': 'GOLD', 'Value': 'GOLD', 'Description': 'Gold'}",
        "{'Code': 'GREEN', 'Value': 'GREEN', 'Description': \"Note that the combined color 'GreenAndYellow' shall be used only as Protective Earth (PE) conductors according to the requirements of IEC 60446\"}",
        "{'Code': 'GREENANDYELLOW', 'Value': 'GREENANDYELLOW', 'Description': \"Note that the combined color 'GreenAndYellow' shall be used only as Protective Earth (PE) conductors according to the requirements of IEC 60446\"}",
        "{'Code': 'GREY', 'Value': 'GREY', 'Description': 'Grey'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'ORANGE', 'Value': 'ORANGE', 'Description': 'Orange'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PINK', 'Value': 'PINK', 'Description': 'Pink'}",
        "{'Code': 'RED', 'Value': 'RED', 'Description': 'Red'}",
        "{'Code': 'SILVER', 'Value': 'SILVER', 'Description': 'Silver'}",
        "{'Code': 'TURQUOISE', 'Value': 'TURQUOISE', 'Description': 'Turquoise'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VIOLET', 'Value': 'VIOLET', 'Description': 'Violet'}",
        "{'Code': 'WHITE', 'Value': 'WHITE', 'Description': 'White'}",
        "{'Code': 'YELLOW', 'Value': 'YELLOW', 'Description': \"Note that the combined color 'GreenAndYellow' shall be used only as Protective Earth (PE) conductors according to the requirements of IEC 60446\"}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SheathColours" .

ifc:SheathDiameter a owl:DatatypeProperty ;
    rdfs:label "S Heat H Diameter" ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Diameter]] of the sheeth (duct) around the tendon, if there is one with this type of tendon." ;
