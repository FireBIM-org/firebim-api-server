ifc:WWWHomePageURL a owl:DatatypeProperty ;
    rdfs:label "WWW Home Page URL" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcURIReference' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The world wide web address at which the preliminary page of information for the person or organization can be located." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WWWHomePageURL" .

ifc:WaistThickness a owl:DatatypeProperty ;
    rdfs:label "Waist Thickness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum thickness of the stair flight, measured perpendicular to the slope of the flight to the inner corner of riser and tread. It is a pre-calculated value, in case of inconsistencies, the value derived from the shape representation shall take precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WaistThickness" .

ifc:WalkingLineOffset a owl:DatatypeProperty ;
    rdfs:label "Walking Line Off Set" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Offset of the walking line from the inner side of the flight.;the walking line may have a own shape representation (in case of inconsistencies, the value derived from the shape representation shall take precedence)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WalkingLineOffset" .

ifc:WallCovering a owl:DatatypeProperty ;
    rdfs:label "Wall Covering" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Label to indicate the material or finish of the space cladding. The label is used for room book information and often displayed in room stamp.The material information is provided in absence of an [[IfcCovering]] (type=CLADDING) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WallCovering" .

ifc:WallCoveringThickness a owl:DatatypeProperty ;
    rdfs:label "Wall Covering Thickness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Thickness]] of the material layer(s) for the space cladding.The thickness information is provided in absence of an [[IfcCovering]] (type=CLADDING) object with own shape representation. In cases of inconsistency between the geometric parameters of an assigned [[IfcCovering]] and this attached property, the geometric parameters take precedence." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WallCoveringThickness" .

ifc:WallMaterial a owl:ObjectProperty ;
    rdfs:label "Wall Material" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcMaterialDefinition. Read the IFC documentation for more information." ;
    skos:definition "The material from which the wall of the chamber is constructed.;" ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "WallMaterial" .

ifc:WallThickness a owl:DatatypeProperty ;
    rdfs:label "Wall Thickness" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The thickness of the wall construction.;" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "WallThickness" .

