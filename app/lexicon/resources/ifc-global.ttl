    meta:sourceCode "CondenserEnteringTemperature" .

ifc:CondenserFlowrate a owl:DatatypeProperty ;
    rdfs:label "Condenser Flow Rate" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcVolumetricFlowRateMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Flow rate of fluid through the condenser." ;
