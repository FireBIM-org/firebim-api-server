ifc:IfcWorkCalendar a owl:Class ;
    rdfs:label "Work Calendar" ;
    rdfs:subClassOf ifc:IfcControl ;
    skos:definition "An [[IfcWorkCalendar]] defines working and non-working time periods for tasks and resources. It enables to define both specific time periods,00 on 25th August 2009, as well as repetitive time periods based on frequently used recurrence patterns,00 between 1st March 2009 and 31st December 2009." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:Description_from_Attributes,
        ifc:GlobalId_from_Attributes,
        ifc:Identification_from_Attributes,
        ifc:Name_from_Attributes,
        ifc:ObjectType_from_Attributes ;
    meta:parentClassCode "IfcControl" ;
    meta:sourceCode "IfcWorkCalendar" ;
    meta:uid "d05923c3-37a8-444a-b811-bf0709bab84f" .

