    meta:sourceCode "ConditionTermination" .

ifc:ConductorDiameter a owl:DatatypeProperty ;
    rdfs:label "Conductor Diameter" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the conductor diameter. It is only used for twisted and untwisted wire pair." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConductorDiameter" .

ifc:ConductorFunction a owl:DatatypeProperty ;
    rdfs:label "Conductor Function" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates function of the conductors to which the load is connected. Where L1, L2 and L3 represent the phase lines according to IEC 60446 notation (sometimes phase lines may be referenced by color Red, Blue, Yellow or by number 1, 2, 3 etc). Protective Earth is sometimes also known as CPC or common protective conductor. Note that for an electrical device, a set of line conductor functions may be applied." ;
    meta:allowedValue "{'Code': 'NEUTRAL', 'Value': 'NEUTRAL', 'Description': 'Neutral'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PHASE_L1', 'Value': 'PHASE_L1', 'Description': '[[Phase]] L1'}",
        "{'Code': 'PHASE_L2', 'Value': 'PHASE_L2', 'Description': '[[Phase]] L2'}",
        "{'Code': 'PHASE_L3', 'Value': 'PHASE_L3', 'Description': '[[Phase]] L3'}",
        "{'Code': 'PROTECTIVEEARTH', 'Value': 'PROTECTIVEEARTH', 'Description': 'Protective Earth'}",
        "{'Code': 'PROTECTIVEEARTHNEUTRAL', 'Value': 'PROTECTIVEEARTHNEUTRAL', 'Description': 'Protective Earth Neutral'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConductorFunction" .

ifc:ConductorMaterial a owl:DatatypeProperty ;
    rdfs:label "Conductor Material" ;
    rdfs:range xsd:string ;
    skos:definition "[[Type]] of material from which the conductor is constructed." ;
    meta:allowedValue "{'Code': 'ALUMINIUM', 'Value': 'ALUMINIUM', 'Description': 'Aluminium'}",
        "{'Code': 'COPPER', 'Value': 'COPPER', 'Description': 'Copper'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConductorMaterial" .

ifc:ConductorShape a owl:DatatypeProperty ;
    rdfs:label "Conductor Shape" ;
    rdfs:range xsd:string ;
    skos:definition "Indication of the shape of the conductor." ;
    meta:allowedValue "{'Code': 'CIRCULARCONDUCTOR', 'Value': 'CIRCULARCONDUCTOR', 'Description': 'Circular Conductor'}",
        "{'Code': 'HELICALCONDUCTOR', 'Value': 'HELICALCONDUCTOR', 'Description': 'Helical Conductor'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'RECTANGULARCONDUCTOR', 'Value': 'RECTANGULARCONDUCTOR', 'Description': 'Rectangular Conductor'}",
        "{'Code': 'SECTORCONDUCTOR', 'Value': 'SECTORCONDUCTOR', 'Description': 'Sector Conductor'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConductorShape" .

ifc:ConduitShapeType a owl:DatatypeProperty ;
    rdfs:label "Conduit Shape Type" ;
    rdfs:range xsd:string ;
    skos:definition "The shape of the conduit segment." ;
    meta:allowedValue "{'Code': 'CIRCULAR', 'Value': 'CIRCULAR', 'Description': 'Circular'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'OVAL', 'Value': 'OVAL', 'Description': 'Oval'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConduitShapeType" .

ifc:ConicityRatio a owl:DatatypeProperty ;
    rdfs:label "Conicity Ratio" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of the diameter of the cone bottom surface to the height of the pole." ;
