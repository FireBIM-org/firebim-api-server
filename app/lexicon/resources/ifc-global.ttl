ifc:GroupCode a owl:DatatypeProperty ;
    rdfs:label "Group Code" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcIdentifier' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "e.g. panels, worksurfaces, storage, etc." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GroupCode" .

ifc:GuardRailConnection a owl:DatatypeProperty ;
    rdfs:label "Guard Rail Connection" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates how the guard rail is connected along its length, when the fasteners are not explicitly modelled." ;
    meta:allowedValue "{'Code': 'FISHPLATE', 'Value': 'FISHPLATE', 'Description': 'Fishplate'}",
        "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WELD', 'Value': 'WELD', 'Description': 'Weld'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GuardRailConnection" .

ifc:GuardRailType a owl:DatatypeProperty ;
    rdfs:label "Guard Rail Type" ;
    rdfs:range xsd:string ;
    skos:definition "[[Type]] of the guard rail." ;
    meta:allowedValue "{'Code': 'GUARDRAILANDSPOTSLEEPERS', 'Value': 'GUARDRAILANDSPOTSLEEPERS', 'Description': 'Guard Rail Andspotsleepers'}",
        "{'Code': 'GUARDRAILSONLY', 'Value': 'GUARDRAILSONLY', 'Description': 'Guard Rail Sonly'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SPOTSLEEPERSONLY', 'Value': 'SPOTSLEEPERSONLY', 'Description': 'Spotsleepersonly'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GuardRailType" .

ifc:GullyType a owl:DatatypeProperty ;
    rdfs:label "Gully Type" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the predefined types of gully from which the type required may be set." ;
    meta:allowedValue "{'Code': 'BACKINLET', 'Value': 'BACKINLET', 'Description': 'Back Inlet'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VERTICAL', 'Value': 'VERTICAL', 'Description': 'Vertical'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GullyType" .

