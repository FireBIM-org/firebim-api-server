ifc:IfcDeepFoundation a owl:Class ;
    rdfs:label "Deep Foundation" ;
    rdfs:subClassOf ifc:IfcBuiltElement ;
    skos:definition "Deep foundation is a type of foundation that transfers loads deeper than shallow foundation below the soft soils not capable of bearing the above structure. Depending on the soil strength it might have to reach down to the rock layer." ;
