        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PARTIALLY_DECONSTRUCTED', 'Value': 'PARTIALLY_DECONSTRUCTED', 'Description': 'Partially Deconstructed'}",
        "{'Code': 'PARTIALLY_REFILLED', 'Value': 'PARTIALLY_REFILLED', 'Description': 'Partially Re Filled'}",
        "{'Code': 'RECONDITIONED', 'Value': 'RECONDITIONED', 'Description': 'Reconditioned'}",
        "{'Code': 'REFILLED', 'Value': 'REFILLED', 'Description': 'Re Filled'}",
