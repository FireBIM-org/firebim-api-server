    meta:allowedValue "{'Code': 'BUTTONS', 'Value': 'BUTTONS', 'Description': 'Buttons'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TOUCHSCREEN', 'Value': 'TOUCHSCREEN', 'Description': 'Touch Screen'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "KeypadType" .

ifc:LRMConstraint a owl:DatatypeProperty ;
