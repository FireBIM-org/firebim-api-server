ifc:IfcProtectiveDeviceEARTHINGSWITCH a owl:Class ;
    rdfs:label "Earthing Switch" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcProtectiveDevice ;
    skos:definition "A safety device used to open or close a circuit when there is no current. Used to isolate a part of a circuit, a machine, a part of an overhead line or an underground line so that maintenance can be safely conducted." ;
    meta:classType "Class" ;
