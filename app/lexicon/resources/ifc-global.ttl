        "{'Code': 'LRM_INTERPOLATIVE', 'Value': 'LRM_INTERPOLATIVE', 'Description': 'LRM Interpolative'}",
        "{'Code': 'LRM_RELATIVE', 'Value': 'LRM_RELATIVE', 'Description': 'LRM Relative'}",
        "{'Code': 'LRM_USERDEFINED', 'Value': 'LRM_USERDEFINED', 'Description': 'In this Pset this is handled by adding the enumeration constant [[LRM_USERDEFINED]] and the additional property [[UserDefinedLRMType]]'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LRMType" .

