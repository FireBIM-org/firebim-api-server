ifc:TrackUsage a owl:DatatypeProperty ;
    rdfs:label "Track Usage" ;
    rdfs:range xsd:string ;
    skos:definition "The expected primary usage of the track." ;
    meta:allowedValue "{'Code': 'CATCHSIDING', 'Value': 'CATCHSIDING', 'Description': 'Catchsiding'}",
