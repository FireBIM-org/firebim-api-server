        ifc:IsCurrentTolerancePositiveOnly_from____PPDTFGC,
        ifc:IsSelectable_from_ProtectiveDevi___FunctionGCurve,
        ifc:IsTimeTolerancePositiveOnly_from_Protect___nGCurve,
        ifc:NominalCurrentAdjusted_from_Protectiv___ionGCurve,
        ifc:ReleaseCurrentI2tEnd_from_Protective___tionGCurve,
        ifc:ReleaseCurrentI2tStart_from_Protectiv___ionGCurve,
        ifc:ReleaseCurrent_from_ProtectiveDev___unctionGCurve,
        ifc:ReleaseTimeI2tEnd_from_ProtectiveDe___nctionGCurve,
        ifc:ReleaseTimeI2tStart_from_ProtectiveD___ctionGCurve,
        ifc:ReleaseTime_from_ProtectiveDevic___gFunctionGCurve,
        ifc:TimeTolerance1_from_ProtectiveDev___unctionGCurve,
        ifc:TimeTolerance2_from_ProtectiveDev___unctionGCurve,
        ifc:TimeToleranceLimit1_from_ProtectiveD___ctionGCurve ;
    meta:sourceCode "Pset_ProtectiveDeviceTrippingFunctionGCurve" .

