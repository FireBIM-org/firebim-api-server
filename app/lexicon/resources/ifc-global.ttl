ifc:CompositeFractions a owl:DatatypeProperty ;
    rdfs:label "Compo Site Fractions" ;
    rdfs:range xsd:string ;
    skos:definition "Denomination into soil groups by composite fractions" ;
    meta:allowedValue "{'Code': 'BOULDERS', 'Value': 'BOULDERS', 'Description': 'Boulders'}",
        "{'Code': 'BOULDERS_WITH_COBBLES', 'Value': 'BOULDERS_WITH_COBBLES', 'Description': 'Boulders with Cobbles'}",
        "{'Code': 'BOULDERS_WITH_FINER_SOILS', 'Value': 'BOULDERS_WITH_FINER_SOILS', 'Description': 'Boulders with Finer Soils'}",
        "{'Code': 'CLAY', 'Value': 'CLAY', 'Description': 'Clay'}",
        "{'Code': 'CLAYEY_SILT', 'Value': 'CLAYEY_SILT', 'Description': 'Clayey Silt'}",
        "{'Code': 'COBBLES', 'Value': 'COBBLES', 'Description': 'Cobbles'}",
        "{'Code': 'COBBLES_WITH_BOULDERS', 'Value': 'COBBLES_WITH_BOULDERS', 'Description': 'Cobbles with Boulders'}",
        "{'Code': 'COBBLES_WITH_FINER_SOILS', 'Value': 'COBBLES_WITH_FINER_SOILS', 'Description': 'Cobbles with Finer Soils'}",
        "{'Code': 'FILL', 'Value': 'FILL', 'Description': 'Fill'}",
        "{'Code': 'GRAVEL', 'Value': 'GRAVEL', 'Description': 'Gravel'}",
        "{'Code': 'GRAVELLY_SAND', 'Value': 'GRAVELLY_SAND', 'Description': 'Gravelly Sand'}",
        "{'Code': 'GRAVEL_WITH_CLAY_OR_SILT', 'Value': 'GRAVEL_WITH_CLAY_OR_SILT', 'Description': 'Gravel with Clay or Silt'}",
        "{'Code': 'GRAVEL_WITH_COBBLES', 'Value': 'GRAVEL_WITH_COBBLES', 'Description': 'Gravel with Cobbles'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'ORGANIC_CLAY', 'Value': 'ORGANIC_CLAY', 'Description': 'Organic Clay'}",
        "{'Code': 'ORGANIC_SILT', 'Value': 'ORGANIC_SILT', 'Description': 'Organic Silt'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SAND', 'Value': 'SAND', 'Description': 'Sand'}",
        "{'Code': 'SANDY_CLAYEY_SILT', 'Value': 'SANDY_CLAYEY_SILT', 'Description': 'Sandy Clayey Silt'}",
        "{'Code': 'SANDY_GRAVEL', 'Value': 'SANDY_GRAVEL', 'Description': 'Sandy Gravel'}",
        "{'Code': 'SANDY_GRAVELLY_CLAY', 'Value': 'SANDY_GRAVELLY_CLAY', 'Description': 'Sandy Gravelly Clay'}",
        "{'Code': 'SANDY_GRAVELLY_SILT', 'Value': 'SANDY_GRAVELLY_SILT', 'Description': 'Sandy Gravelly Silt'}",
        "{'Code': 'SANDY_GRAVEL_WITH_COBBLES', 'Value': 'SANDY_GRAVEL_WITH_COBBLES', 'Description': 'Sandy Gravel with Cobbles'}",
        "{'Code': 'SANDY_PEAT', 'Value': 'SANDY_PEAT', 'Description': 'Sandy Peat'}",
        "{'Code': 'SANDY_SILT', 'Value': 'SANDY_SILT', 'Description': 'Sandy Silt'}",
        "{'Code': 'SAND_WITH_CLAY_AND_SILT', 'Value': 'SAND_WITH_CLAY_AND_SILT', 'Description': 'Sand with Clay and Silt'}",
        "{'Code': 'SILT', 'Value': 'SILT', 'Description': 'Silt'}",
        "{'Code': 'SILTY_CLAY', 'Value': 'SILTY_CLAY', 'Description': 'Silty Clay'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CompositeFractions" .

ifc:CompositionType a owl:DatatypeProperty ;
    rdfs:label "Composition Type" ;
    rdfs:range xsd:string ;
    skos:definition "Denotes, whether the predefined spatial structure element represents itself, or an aggregate (complex) or a part (part). The interpretation is given separately for each subtype of spatial structure element. If no [[CompositionType]] is asserted, the default value ''[[ELEMENT]]'' applies." ;
    meta:allowedValue "{'Code': 'COMPLEX', 'Value': 'COMPLEX', 'Description': 'or an aggregate (complex) or a part (part)'}",
        "{'Code': 'ELEMENT', 'Value': 'ELEMENT', 'Description': 'whether the predefined spatial structure element represents itself'}",
        "{'Code': 'PARTIAL', 'Value': 'PARTIAL', 'Description': 'Partial'}" ;
    meta:sourceCode "CompositionType" .

ifc:CompressedAirFilterType a owl:DatatypeProperty ;
    rdfs:label "Compressed Air Filter Type" ;
    rdfs:range xsd:string ;
    skos:definition "absorbs oil vapor and odor;used to absorb solid particles of medium size;used to absorb fine solid, oil, and water particles, also called micro filter" ;
    meta:allowedValue "{'Code': 'ACTIVATEDCARBON', 'Value': 'ACTIVATEDCARBON', 'Description': 'absorbs oil vapor and odor'}",
        "{'Code': 'COALESCENSE_FILTER', 'Value': 'COALESCENSE_FILTER', 'Description': 'used to absorb fine solid'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PARTICLE_FILTER', 'Value': 'PARTICLE_FILTER', 'Description': 'used to absorb solid particles of medium size'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CompressedAirFilterType" .

ifc:CompressionEfficiency a owl:ObjectProperty ;
    rdfs:label "Compression Efficiency" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Ratio of the work required for isentropic compression of the gas to the work delivered to the gas within the compression volume (as obtained by measurement)." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressionEfficiency" .

ifc:CompressiveStrength a owl:DatatypeProperty ;
    rdfs:label "Compressive Strength" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPressureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The compressive strength of the object or material." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CompressiveStrength" .

ifc:CompressorCapacity a owl:ObjectProperty ;
    rdfs:label "Compressor Capacity" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "The product of the ideal capacity and the overall volumetric efficiency of the compressor." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorCapacity" .

ifc:CompressorCondenserHeatGain a owl:ObjectProperty ;
    rdfs:label "Compressor Condenser Heat Gain" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "[[Heat]] gain between condenser inlet to compressor outlet." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorCondenserHeatGain" .

ifc:CompressorCondenserPressureDrop a owl:ObjectProperty ;
    rdfs:label "Compressor Condenser Pressure Drop" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "[[Pressure]] drop between condenser inlet and compressor outlet." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorCondenserPressureDrop" .

ifc:CompressorEvaporatorHeatGain a owl:ObjectProperty ;
    rdfs:label "Compressor Evaporator Heat Gain" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "[[Heat]] gain between the evaporator outlet and the compressor inlet." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorEvaporatorHeatGain" .

ifc:CompressorEvaporatorPressureDrop a owl:ObjectProperty ;
    rdfs:label "Compressor Evaporator Pressure Drop" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "[[Pressure]] drop between the evaporator outlet and the compressor inlet." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorEvaporatorPressureDrop" .

ifc:CompressorSpeed a owl:DatatypeProperty ;
    rdfs:label "Compressor Speed" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRotationalFrequencyMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Compressor speed." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "CompressorSpeed" .

ifc:CompressorTotalEfficiency a owl:ObjectProperty ;
    rdfs:label "Compressor Total Efficiency" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Ratio of the thermal cooling capacity to electrical input." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorTotalEfficiency" .

ifc:CompressorTotalHeatGain a owl:ObjectProperty ;
    rdfs:label "Compressor Total Heat Gain" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Compressor total heat gain." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CompressorTotalHeatGain" .

ifc:ConcealedCeiling a owl:DatatypeProperty ;
    rdfs:label "Concealed Ceiling" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "Indication whether this space is designed to have a concealed flooring space (TRUE) or not (FALSE). A concealed ceiling space is normally meant to be the space between a slab and a ceiling." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConcealedCeiling" .

ifc:ConcealedCeilingOffset a owl:DatatypeProperty ;
    rdfs:label "Concealed Ceiling Off Set" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNonNegativeLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Distance between the upper floor slab and the suspended ceiling, often used for distribution systems. Often referred to as plenum." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConcealedCeilingOffset" .

ifc:ConcealedFlooring a owl:DatatypeProperty ;
    rdfs:label "Concealed Flooring" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "Indication whether this space is designed to have a concealed flooring space (TRUE) or not (FALSE). A concealed flooring space is normally meant to be the space beneath a raised floor." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConcealedFlooring" .

ifc:ConcealedFlooringOffset a owl:DatatypeProperty ;
    rdfs:label "Concealed Flooring Off Set" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNonNegativeLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Distance between the floor slab and the floor covering, often used for cables and other installations. Often referred to as raised flooring." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConcealedFlooringOffset" .

ifc:ConcreteCover a owl:DatatypeProperty ;
    rdfs:label "Concrete Cover" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The protective concrete cover at the reinforcing bars according to local building regulations." ;
