ifc:Mounting a owl:DatatypeProperty ;
    rdfs:label "Mounting" ;
    rdfs:range xsd:string ;
    skos:definition "The property enumeration Pset_SanitaryMountingEnum defines the forms of mounting or fixing of the sanitary terminal that may be specified within property sets used to define sanitary terminals (WCs, basins, sinks, etc. A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections; A floor mounted sanitary terminal that has an integral base; A sanitary terminal that is installed into a horizontal surface that is installed into a horizontal surface.When applied to a wash hand basin, the term more normally used is vanity. See also Wash Hand Basin [[Type]] specification.; A sanitary terminal cantilevered clear of the floor.Note that BackToWall, Pedestal and WallHung are allowable values for a bidet." ;
    meta:allowedValue "{'Code': 'BACKTOWALL', 'Value': 'BACKTOWALL', 'Description': 'A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections; A floor mounted sanitary terminal that has an integral base; A sanitary terminal that is installed into a horizontal surface that is installed into a horizontal surface'}",
        "{'Code': 'COUNTERTOP', 'Value': 'COUNTERTOP', 'Description': 'A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections; A floor mounted sanitary terminal that has an integral base; A sanitary terminal that is installed into a horizontal surface that is installed into a horizontal surface'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PEDESTAL', 'Value': 'PEDESTAL', 'Description': 'A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections; A floor mounted sanitary terminal that has an integral base; A sanitary terminal that is installed into a horizontal surface that is installed into a horizontal surface'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WALLHUNG', 'Value': 'WALLHUNG', 'Description': 'A sanitary terminal cantilevered clear of the floor'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Mounting" .

ifc:MountingMethod a owl:DatatypeProperty ;
    rdfs:label "Mounting Method" ;
    rdfs:range xsd:string ;
    skos:definition "The method of mounting cable segment occurrences on a cable carrier occurrence from which the method required can be selected. This is for the purpose of carrying out 'worst case' cable sizing calculations and may be a conceptual requirement rather than a statement of the physical occurrences of cable and carrier segments." ;
    meta:allowedValue "{'Code': 'LADDER', 'Value': 'LADDER', 'Description': 'Ladder'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PERFORATEDTRAY', 'Value': 'PERFORATEDTRAY', 'Description': 'Perfo Rated Tray'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "MountingMethod" .

