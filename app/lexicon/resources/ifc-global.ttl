ifc:SnowSensorType a owl:DatatypeProperty ;
    rdfs:label "Snow Sensor Type" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of snow depth meter." ;
    meta:allowedValue "{'Code': 'LASERIRRADIATION', 'Value': 'LASERIRRADIATION', 'Description': 'Laserir Radiation'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SnowSensorType" .

ifc:SoffitLevel a owl:DatatypeProperty ;
    rdfs:label "S Off It Level" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Level of the highest internal part of the cross section as measured from ground level." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SoffitLevel" .

ifc:SoftnessCoefficient a owl:DatatypeProperty ;
    rdfs:label "Soft Ness Coefficient" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Vessel flexibility factor - proportion of impact energy absorbed by the hull." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SoftnessCoefficient" .

ifc:SoftwareVersion a owl:DatatypeProperty ;
    rdfs:label "Soft Ware Version" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Indicates version of application software according to systems integrator." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SoftwareVersion" .

ifc:SoilConductivity a owl:DatatypeProperty ;
    rdfs:label "Soil Conductivity" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcThermalConductivityMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Thermal conductivity of soil. Generally, within standards such as IEC 60364-5-52, table 52A-16, the resistivity of soil is required (measured in SI units of degK.m /W). This is the reciprocal of the conductivity value and needs to be calculated accordingly." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SoilConductivity" .

ifc:SolarAbsorption a owl:DatatypeProperty ;
    rdfs:label "Solar Absorption" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "(Asol) The ratio of incident solar radiation that is absorbed by a glazing system. It is the sum of the absorption distributed to the exterior (a) and to the interior (qi). Note the following equation Asol + Rsol + Tsol = 1" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarAbsorption" .

ifc:SolarHeatGainTransmittance a owl:DatatypeProperty ;
    rdfs:label "Solar Heat Gain Transmittance" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of incident solar radiation that contributes to the heat gain of the interior, it is the solar radiation that directly passes (Tsol or τe) plus the part of the absorbed radiation that is distributed to the interior (qi). The SHGC is referred to also as g-value (g = τe + qi)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarHeatGainTransmittance" .

ifc:SolarReflectance a owl:DatatypeProperty ;
    rdfs:label "Solar Reflectance" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of incident solar radiation that is reflected by a glazing system (also named ρe). Note the following equation Asol + Rsol + Tsol = 1" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarReflectance" .

ifc:SolarReflectanceBack a owl:DatatypeProperty ;
    rdfs:label "Solar Reflectance Back" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "back side. Defines the fraction of the solar ray that is reflected and not transmitted when the ray passes from one medium into another, at the 'back' side of the other material, perpendicular to the surface. Dependent on material and surface characteristics." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarReflectanceBack" .

ifc:SolarReflectanceFront a owl:DatatypeProperty ;
    rdfs:label "Solar Reflectance Front" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "front side. Defines the fraction of the solar ray that is reflected and not transmitted when the ray passes from one medium into another, at the 'front' side of the other material, perpendicular to the surface. Dependent on material and surface characteristics." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarReflectanceFront" .

ifc:SolarRefractionIndex a owl:DatatypeProperty ;
    rdfs:label "Solar Refraction Index" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Index of refraction (solar) defines the 'bending' of the solar ray when it passes from one medium into another." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarRefractionIndex" .

ifc:SolarTransmittance a owl:DatatypeProperty ;
    rdfs:label "Solar Transmittance" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcNormalisedRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of incident solar radiation that directly passes through a system (also named τe). Note the following equation Asol + Rsol + Tsol = 1" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SolarTransmittance" .

ifc:Sound a owl:ObjectProperty ;
    rdfs:label "Sound" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "[[Sound]] performance." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Sound" .

ifc:SoundAbsorptionLimit a owl:DatatypeProperty ;
    rdfs:label "Sound Absorption Limit" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcSoundPowerLevelMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Mandatory limit values in sound absorption." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SoundAbsorptionLimit" .

ifc:SoundCurve a owl:ObjectProperty ;
    rdfs:label "Sound Curve" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Sound]] curve." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "SoundCurve" .

ifc:SoundCurveHistory a owl:ObjectProperty ;
    rdfs:label "Sound Curve History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Regenerated sound versus air-flow rate." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "SoundCurveHistory" .

ifc:SoundFrequency a owl:DatatypeProperty ;
    rdfs:label "Sound Frequency" ;
    rdfs:range xsd:decimal ;
    skos:definition "List of nominal sound frequencies, correlated to the [[SoundPressure]] time series values (IfcTimeSeries.ListValues)" ;
    meta:propertyValueKind "List" ;
    meta:sourceCode "SoundFrequency" .

ifc:SoundPressure a owl:ObjectProperty ;
    rdfs:label "Sound Pressure" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "A time series of sound pressure values measured in decibels at a reference pressure of 20 microPascals for the referenced octave band frequency. Each value in IfcTimeSeries.ListValues is correlated to the sound frequency at the same position within SoundFrequencies." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "SoundPressure" .

ifc:SoundScale a owl:DatatypeProperty ;
    rdfs:label "Sound Scale" ;
    rdfs:range xsd:string ;
    skos:definition "The reference sound scale.Decibels in an A-weighted scale;Decibels in an B-weighted scale;Decibels in an C-weighted scale;Noise criteria;Noise rating" ;
    meta:allowedValue "{'Code': 'DBA', 'Value': 'DBA', 'Description': 'Decibels in an A-weighted scale;Decibels in an B-weighted scale;Decibels in an C-weighted scale;Noise criteria;Noise rating'}",
        "{'Code': 'DBB', 'Value': 'DBB', 'Description': 'Decibels in an A-weighted scale;Decibels in an B-weighted scale;Decibels in an C-weighted scale;Noise criteria;Noise rating'}",
        "{'Code': 'DBC', 'Value': 'DBC', 'Description': 'Decibels in an A-weighted scale;Decibels in an B-weighted scale;Decibels in an C-weighted scale;Noise criteria;Noise rating'}",
        "{'Code': 'NC', 'Value': 'NC', 'Description': 'The reference sound scale'}",
        "{'Code': 'NR', 'Value': 'NR', 'Description': 'Decibels in an A-weighted scale;Decibels in an B-weighted scale;Decibels in an C-weighted scale;Noise criteria;Noise rating'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "SoundScale" .

ifc:SpaceAirTemperature a owl:ObjectProperty ;
    rdfs:label "Space Air Temperature" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Dry bulb temperature in the space." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "SpaceAirTemperature" .

ifc:SpaceHeaterPlacement a owl:DatatypeProperty ;
    rdfs:label "Space Heater Placement" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates how the space heater is designed to be placed." ;
    meta:allowedValue "{'Code': 'BASEBOARD', 'Value': 'BASEBOARD', 'Description': 'Base Board'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
