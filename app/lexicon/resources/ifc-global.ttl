    rdfs:range xsd:decimal ;
    skos:definition "Humidity of the space or zone for the hot (summer) period, that is required from user/designer view point and provided as requirement for cooling." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "HumiditySummer" .

ifc:HumidityWinter a owl:DatatypeProperty ;
    rdfs:label "Humidity Winter" ;
