ifc:IfcTrackElementHALF_SET_OF_BLADES a owl:Class ;
    rdfs:label "Half Set of Blades" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcTrackElement ;
    skos:definition "A half set of blades consists of one stock rail and its switch rail complete with small fittings. It is right or left hand as seen by an observer in the centre of the track facing the switch heel from the switch toe.;definition from EN 13232-1-2004." ;
