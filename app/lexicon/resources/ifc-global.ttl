    rdfs:range xsd:decimal ;
    skos:definition "Fill pressure (e.g.the pressure exerted by a mass of gas confined in a constant volume." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GasPressure" .

ifc:GasType a owl:DatatypeProperty ;
    rdfs:label "Gas Type" ;
