    rdfs:range xsd:decimal ;
    skos:definition "Ground fault tripping time. The set value of the ground fault tripping current if adjustable." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "GroundFaultTrippingTime" .

ifc:GroundFaulti2tFunction a owl:DatatypeProperty ;
