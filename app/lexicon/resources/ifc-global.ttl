        "{'Code': 'SLAB', 'Value': 'SLAB', 'Description': 'Urinal that consists of a slab or sheet fixed to a wall and down which urinal flows into a floor channel'}",
        "{'Code': 'STALL', 'Value': 'STALL', 'Description': 'Floor mounted urinal that consists of an elliptically shaped sanitary stall fixed to a wall and down which urine flows into a floor channel'}",
        "{'Code': 'TROUGH', 'Value': 'TROUGH', 'Description': 'Wall mounted urinal of elongated rectangular shape on plan'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "UrinalType" .

