        ifc:LRMConstraint_from_LinearReferencingMethod,
        ifc:LRMName_from_LinearReferencingMethod,
        ifc:LRMType_from_LinearReferencingMethod,
        ifc:LRMUnit_from_LinearReferencingMethod,
        ifc:LinearUncertainty_from_Uncertainty,
