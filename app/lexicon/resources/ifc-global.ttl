@prefix ifc: <https://firebim.org/ontologies/ifc/global#> .
@prefix meta: <https://firebim.org/ontology-meta#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ifc: a owl:Ontology ;
    rdfs:label "IFC" ;
    rdfs:comment "IFC ontology projection generated from JSON." ;
    owl:versionIRI <https://firebim.org/ontologies/ifc/global/2026.04.23#> ;
    owl:versionInfo "4.3" ;
    meta:dictionaryCode "ifc" ;
    meta:moreInfoUrl "https://ifc43-docs.standards.buildingsmart.org/" ;
    meta:sourceLicense "CC BY-ND 4.0" ;
    meta:sourceReleaseDate "2024-01-11" .

ifc:ACResistance a owl:DatatypeProperty ;
    rdfs:label "Acresistance" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcElectricResistanceMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The resistance under AC." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ACResistance" .

ifc:AbnormalBerthingFactor a owl:DatatypeProperty ;
    rdfs:label "Abnormal Berthing Factor" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Risk assessed safety factor" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AbnormalBerthingFactor" .

ifc:AboveDeckProjectedWindEnd a owl:DatatypeProperty ;
    rdfs:label "Above Deck Projected Wind End" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcAreaMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "End on projected windage area above the main deck" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AboveDeckProjectedWindEnd" .

ifc:AboveDeckProjectedWindSide a owl:DatatypeProperty ;
    rdfs:label "Above Deck Projected Wind Side" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcAreaMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Side]] on projected windage area above the main deck" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AboveDeckProjectedWindSide" .

ifc:AboveGround a owl:DatatypeProperty ;
    rdfs:label "Above Ground" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLogical' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    skos:definition "Indication whether this building storey is fully above ground (TRUE), or below ground (FALSE), or partially above and below ground ([[UNKNOWN]]) - as in sloped terrain." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AboveGround" .

ifc:AcceptanceDate a owl:DatatypeProperty ;
    rdfs:label "Acceptance Date" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcDate' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Date on which the element is accepted by the manager or administrator." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AcceptanceDate" .

ifc:AccessCoverLoadRating a owl:DatatypeProperty ;
    rdfs:label "Access Cover Load Rating" ;
    rdfs:range xsd:string ;
    skos:definition "The load rating of the access cover (which may be a value or an alphanumerically defined class rating)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccessCoverLoadRating" .

ifc:AccessCoverMaterial a owl:ObjectProperty ;
    rdfs:label "Access Cover Material" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcMaterialDefinition. Read the IFC documentation for more information." ;
    skos:definition "The material from which the access cover to the chamber is constructed.;" ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "AccessCoverMaterial" .

ifc:AccessLengthOrRadius a owl:DatatypeProperty ;
    rdfs:label "Access Length or Radius" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The length of the chamber access cover or, where the plan shape of the cover is circular, the radius." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccessLengthOrRadius" .

ifc:AccessType a owl:DatatypeProperty ;
    rdfs:label "Access Type" ;
    rdfs:range xsd:string ;
    skos:definition "Defines the types of access (or cover) to a tank that may be specified.Note that covers are generally specified for rectangular tanks. For cylindrical tanks, access will normally be via a manhole." ;
    meta:allowedValue "{'Code': 'LOOSECOVER', 'Value': 'LOOSECOVER', 'Description': 'Loosecover'}",
        "{'Code': 'MANHOLE', 'Value': 'MANHOLE', 'Description': 'access will normally be via a manhole'}",
        "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SECUREDCOVER', 'Value': 'SECUREDCOVER', 'Description': 'Secured Cover'}",
        "{'Code': 'SECUREDCOVERWITHMANHOLE', 'Value': 'SECUREDCOVERWITHMANHOLE', 'Description': 'Secured Cover with Manhole'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccessType" .

ifc:AccessWidth a owl:DatatypeProperty ;
    rdfs:label "Access Width" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The width of the chamber access cover where the plan shape of the cover is not circular." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccessWidth" .

ifc:AccidentResponse a owl:DatatypeProperty ;
    rdfs:label "Accident Response" ;
    rdfs:range xsd:string ;
    skos:definition "Accident response chosen for the asset" ;
    meta:allowedValue "{'Code': 'EMERGENCYINSPECTION', 'Value': 'EMERGENCYINSPECTION', 'Description': 'Emergency Inspection'}",
        "{'Code': 'EMERGENCYPROCEDURE', 'Value': 'EMERGENCYPROCEDURE', 'Description': 'Emergency Procedure'}",
        "{'Code': 'REACTIVE', 'Value': 'REACTIVE', 'Description': 'Reactive'}",
        "{'Code': 'URGENTINSPECTION', 'Value': 'URGENTINSPECTION', 'Description': 'Urgent Inspection'}",
        "{'Code': 'URGENTPROCEDURE', 'Value': 'URGENTPROCEDURE', 'Description': 'Urgent Procedure'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccidentResponse" .

ifc:AccuracyClass a owl:DatatypeProperty ;
    rdfs:label "Accuracy Class" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "A designation assigned to an instrument transformer the current (or voltage) error and phase displacement of which remain within specified limits under prescribed conditions of use (IEC 321-01-24)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccuracyClass" .

ifc:AccuracyGrade a owl:DatatypeProperty ;
    rdfs:label "Accuracy Grade" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The grade of accuracy." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccuracyGrade" .

ifc:AccuracyOfFireSensor a owl:DatatypeProperty ;
    rdfs:label "Accuracy of Fire Sensor" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcThermodynamicTemperatureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The accuracy of the sensor." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccuracyOfFireSensor" .

ifc:AccuracyQualityExpected a owl:DatatypeProperty ;
    rdfs:label "Accuracy Quality Expected" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "A measure of the accuracy quality of survey points as expected expressed in percentage terms." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccuracyQualityExpected" .

ifc:AccuracyQualityObtained a owl:DatatypeProperty ;
    rdfs:label "Accuracy Quality Obtained" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcRatioMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "A measure of the accuracy quality of survey points as obtained expressed in percentage terms." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AccuracyQualityObtained" .

ifc:AcidityConcentration a owl:DatatypeProperty ;
    rdfs:label "Acidity Concentration" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcIonConcentrationMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum CaCO3 equivalent that would neutralize the acid." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AcidityConcentration" .

ifc:Acknowledge a owl:ObjectProperty ;
    rdfs:label "Acknowledge" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates acknowledgement status where False indicates acknowlegement is required and outstanding, True indicates condition has been acknowedged, and Unknown indicates no acknowledgement is required. Upon resetting the condition, then acknowledgement reverts to Unknown." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Acknowledge" .

ifc:AcousticRating a owl:DatatypeProperty ;
    rdfs:label "Acoustic Rating" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Acoustic rating for this object.; It is provided according to the national building code. It indicates the sound transmission resistance of this object by an index ratio (instead of providing full sound absorption values)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AcousticRating" .

ifc:AcquisitionDate a owl:DatatypeProperty ;
    rdfs:label "Acquisition Date" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcDate' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "The date that the manufactured item was purchased." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AcquisitionDate" .

ifc:AcquisitionMethod a owl:DatatypeProperty ;
    rdfs:label "Acquisition Method" ;
    rdfs:range xsd:string ;
    skos:definition "The means by which survey data was acquired." ;
    meta:allowedValue "{'Code': 'GPS', 'Value': 'GPS', 'Description': 'GPS'}",
        "{'Code': 'LASERSCAN_AIRBORNE', 'Value': 'LASERSCAN_AIRBORNE', 'Description': 'Laserscan Air Borne'}",
        "{'Code': 'LASERSCAN_GROUND', 'Value': 'LASERSCAN_GROUND', 'Description': 'Laserscan Ground'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'SONAR', 'Value': 'SONAR', 'Description': 'Sonar'}",
        "{'Code': 'THEODOLITE', 'Value': 'THEODOLITE', 'Description': 'Theodolite'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'USERDEFINED', 'Value': 'USERDEFINED', 'Description': 'User Defined'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AcquisitionMethod" .

ifc:ActionBarMovementLength a owl:DatatypeProperty ;
    rdfs:label "Action Bar Movement Length" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The movement of the bar that pulls the point of a turnout." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActionBarMovementLength" .

ifc:ActionSource a owl:DatatypeProperty ;
    rdfs:label "Action Source" ;
    rdfs:range xsd:string ;
    skos:definition "Source of actions in the group. Normally needed if 'PredefinedType' specifies a LOAD_CASE." ;
    meta:allowedValue "{'Code': 'BRAKES', 'Value': 'BRAKES', 'Description': 'Brakes'}",
        "{'Code': 'BUOYANCY', 'Value': 'BUOYANCY', 'Description': 'Buoyancy'}",
        "{'Code': 'COMPLETION_G1', 'Value': 'COMPLETION_G1', 'Description': 'Completion G1'}",
        "{'Code': 'CREEP', 'Value': 'CREEP', 'Description': 'Creep'}",
        "{'Code': 'CURRENT', 'Value': 'CURRENT', 'Description': '[[Current]]'}",
        "{'Code': 'DEAD_LOAD_G', 'Value': 'DEAD_LOAD_G', 'Description': 'Dead [[Load]] G'}",
        "{'Code': 'EARTHQUAKE_E', 'Value': 'EARTHQUAKE_E', 'Description': 'Earthquake E'}",
        "{'Code': 'ERECTION', 'Value': 'ERECTION', 'Description': 'Erection'}",
        "{'Code': 'FIRE', 'Value': 'FIRE', 'Description': 'Fire'}",
        "{'Code': 'ICE', 'Value': 'ICE', 'Description': 'Ice'}",
        "{'Code': 'IMPACT', 'Value': 'IMPACT', 'Description': 'Impact'}",
        "{'Code': 'IMPULSE', 'Value': 'IMPULSE', 'Description': 'Im Pulse'}",
        "{'Code': 'LACK_OF_FIT', 'Value': 'LACK_OF_FIT', 'Description': 'Lack of Fit'}",
        "{'Code': 'LIVE_LOAD_Q', 'Value': 'LIVE_LOAD_Q', 'Description': 'Live [[Load]] Q'}",
        "{'Code': 'NOTDEFINED', 'Value': 'NOTDEFINED', 'Description': 'Not Defined'}",
        "{'Code': 'PRESTRESSING_P', 'Value': 'PRESTRESSING_P', 'Description': 'Prestressing P'}",
        "{'Code': 'PROPPING', 'Value': 'PROPPING', 'Description': 'Propping'}",
        "{'Code': 'RAIN', 'Value': 'RAIN', 'Description': 'Rain'}",
        "{'Code': 'SETTLEMENT_U', 'Value': 'SETTLEMENT_U', 'Description': 'Settlement U'}",
        "{'Code': 'SHRINKAGE', 'Value': 'SHRINKAGE', 'Description': 'Shrinkage'}",
        "{'Code': 'SNOW_S', 'Value': 'SNOW_S', 'Description': 'Snow S'}",
        "{'Code': 'SYSTEM_IMPERFECTION', 'Value': 'SYSTEM_IMPERFECTION', 'Description': '[[System]] Imperfection'}",
        "{'Code': 'TEMPERATURE_T', 'Value': 'TEMPERATURE_T', 'Description': '[[Temperature]] T'}",
        "{'Code': 'TRANSPORT', 'Value': 'TRANSPORT', 'Description': 'Transport'}",
        "{'Code': 'USERDEFINED', 'Value': 'USERDEFINED', 'Description': 'User Defined'}",
        "{'Code': 'WAVE', 'Value': 'WAVE', 'Description': 'Wave'}",
        "{'Code': 'WIND_W', 'Value': 'WIND_W', 'Description': 'Wind W'}" ;
    meta:sourceCode "ActionSource" .

ifc:ActionType a owl:DatatypeProperty ;
    rdfs:label "Action Type" ;
    rdfs:range xsd:string ;
    skos:definition "[[Type]] of actions in the group. Normally needed if 'PredefinedType' specifies a LOAD_CASE." ;
    meta:allowedValue "{'Code': 'EXTRAORDINARY_A', 'Value': 'EXTRAORDINARY_A', 'Description': 'Extraordinary A'}",
        "{'Code': 'NOTDEFINED', 'Value': 'NOTDEFINED', 'Description': 'Not Defined'}",
        "{'Code': 'PERMANENT_G', 'Value': 'PERMANENT_G', 'Description': 'Permanent G'}",
        "{'Code': 'USERDEFINED', 'Value': 'USERDEFINED', 'Description': 'User Defined'}",
        "{'Code': 'VARIABLE_Q', 'Value': 'VARIABLE_Q', 'Description': 'Variable Q'}" ;
    meta:sourceCode "ActionType" .

ifc:Activation a owl:DatatypeProperty ;
    rdfs:label "Activation" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the predefined methods of sprinkler activation from which that required may be set." ;
    meta:allowedValue "{'Code': 'BULB', 'Value': 'BULB', 'Description': 'Bulb'}",
        "{'Code': 'FUSIBLESOLDER', 'Value': 'FUSIBLESOLDER', 'Description': 'Fusiblesolder'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "Activation" .

ifc:ActivationTemperature a owl:DatatypeProperty ;
    rdfs:label "Activation Temperature" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcThermodynamicTemperatureMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The temperature at which the object is designed to activate." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActivationTemperature" .

ifc:ActorCategory a owl:DatatypeProperty ;
    rdfs:label "Actor Category" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcLabel' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Designation of the category into which the actors in the population belong." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActorCategory" .

ifc:ActualErectionDate a owl:DatatypeProperty ;
    rdfs:label "Actual Erection Date" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcDateTime' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Date erected." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActualErectionDate" .

ifc:ActualProductionDate a owl:DatatypeProperty ;
    rdfs:label "Actual Production Date" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcDateTime' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:string ;
    skos:definition "Production date (stripped from form)." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActualProductionDate" .

ifc:ActuationType a owl:DatatypeProperty ;
    rdfs:label "Actuation Type" ;
    rdfs:range xsd:string ;
    skos:definition "Enumeration that identifies the different types of dampers." ;
    meta:allowedValue "{'Code': 'GRAVITY', 'Value': 'GRAVITY', 'Description': 'Gravity'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SPRING', 'Value': 'SPRING', 'Description': 'Spring'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActuationType" .

ifc:ActuatorApplication a owl:DatatypeProperty ;
    rdfs:label "Actuator Application" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates application of actuator." ;
    meta:allowedValue "{'Code': 'DAMPERACTUATOR', 'Value': 'DAMPERACTUATOR', 'Description': 'Damper Actuator'}",
        "{'Code': 'ENTRYEXITDEVICE', 'Value': 'ENTRYEXITDEVICE', 'Description': 'Entry Exit Device'}",
        "{'Code': 'FIRESMOKEDAMPERACTUATOR', 'Value': 'FIRESMOKEDAMPERACTUATOR', 'Description': 'Fire Smoke Damper Actuator'}",
        "{'Code': 'LAMPACTUATOR', 'Value': 'LAMPACTUATOR', 'Description': 'Lamp Actuator'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'SUNBLINDACTUATOR', 'Value': 'SUNBLINDACTUATOR', 'Description': 'Sunblind Actuator'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'VALVEPOSITIONER', 'Value': 'VALVEPOSITIONER', 'Description': 'Valve Positioner'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActuatorApplication" .

ifc:ActuatorInputPower a owl:DatatypeProperty ;
    rdfs:label "Actuator Input Power" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPowerMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum input power requirement." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActuatorInputPower" .

ifc:ActuatorStatus a owl:DatatypeProperty ;
    rdfs:label "Actuator Status" ;
    rdfs:range xsd:string ;
    skos:definition "[[Status]] of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as 'New' - element designed as new addition, 'Existing' - element exists and remains, 'Demolish' - element existed but is to be demolished, 'Temporary' - element will exists only temporary (like a temporary support structure)." ;
    meta:allowedValue "{'Code': 'DEMOLISH', 'Value': 'DEMOLISH', 'Description': \"'Demolish' - element existed but is to be demolished\"}",
        "{'Code': 'EXISTING', 'Value': 'EXISTING', 'Description': \"'Existing' - element exists and remains\"}",
        "{'Code': 'NEW', 'Value': 'NEW', 'Description': \"The status can be assigned to as 'New' - element designed as new addition\"}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'TEMPORARY', 'Value': 'TEMPORARY', 'Description': \"'Temporary' - element will exists only temporary (like a temporary support structure)\"}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ActuatorStatus" .

ifc:AddedMassCoefficientMethod a owl:DatatypeProperty ;
    rdfs:label "Added Mass Coefficient Method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used to determine the Added [[Mass]] [[Coefficient]] used for design" ;
    meta:allowedValue "{'Code': 'PIANC', 'Value': 'PIANC', 'Description': 'Pianc'}",
        "{'Code': 'SHIGERU_UEDA', 'Value': 'SHIGERU_UEDA', 'Description': 'Shigeru Ueda'}",
        "{'Code': 'VASCO_COSTA', 'Value': 'VASCO_COSTA', 'Description': 'Vasco Cost A'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AddedMassCoefficientMethod" .

ifc:AdditionalProcessing a owl:DatatypeProperty ;
    rdfs:label "Additional Processing" ;
    rdfs:range xsd:string ;
    skos:definition "Any additional or special processing requirements on the associated cargo." ;
    meta:allowedValue "{'Code': 'INSPECTION', 'Value': 'INSPECTION', 'Description': 'Inspection'}",
        "{'Code': 'ISOLATION', 'Value': 'ISOLATION', 'Description': 'Isolation'}",
        "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}",
        "{'Code': 'TARIFFS', 'Value': 'TARIFFS', 'Description': 'Tariffs'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "AdditionalProcessing" .

ifc:AddressLines a owl:DatatypeProperty ;
    rdfs:label "Address Lines" ;
    rdfs:range xsd:string ;
