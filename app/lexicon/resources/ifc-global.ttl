        "{'Code': 'FREESTANDING', 'Value': 'FREESTANDING', 'Description': 'Freestanding'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'POLE_SIDE', 'Value': 'POLE_SIDE', 'Description': 'Pole [[Side]]'}",
        "{'Code': 'POLE_TOP', 'Value': 'POLE_TOP', 'Description': 'Pole Top'}",
        "{'Code': 'RECESSED', 'Value': 'RECESSED', 'Description': 'Recessed'}",
        "{'Code': 'SURFACE', 'Value': 'SURFACE', 'Description': 'Surface'}",
        "{'Code': 'SUSPENDED', 'Value': 'SUSPENDED', 'Description': 'Suspended'}",
        "{'Code': 'TRACKMOUNTED', 'Value': 'TRACKMOUNTED', 'Description': 'Track Mounted'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LightFixtureMountingType" .

