ifc:InletConnectionSize a owl:DatatypeProperty ;
    rdfs:label "Inlet Connection Size" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "[[Size]] of the inlet connection.; Note that all inlet connections are assumed to be the same size." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "InletConnectionSize" .

ifc:InletDiameter a owl:DatatypeProperty ;
    rdfs:label "Inlet Diameter" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcPositiveLengthMeasure' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The inlet diameter of the breeching inlet." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "InletDiameter" .

ifc:InletPatternType a owl:DatatypeProperty ;
    rdfs:label "Inlet Pattern Type" ;
    rdfs:range xsd:string ;
    skos:definition "Identifies the pattern of inlet connections to a trap.A trap may have 0,1,2,3 or 4 inlet connections and the pattern of their arrangement may vary. The enumeration makes the convention that an outlet is either vertical or is placed at the bottom (south side) of the trap (when viewed in plan). Position 1 is to the left (west), position 2 is to the top (north), position 3 is to the right (east) and position 4 is to the bottom (south)." ;
    meta:allowedValue "{'Code': '1', 'Value': '1', 'Description': '1'}",
        "{'Code': '12', 'Value': '12', 'Description': '12'}",
        "{'Code': '123', 'Value': '123', 'Description': '123'}",
        "{'Code': '1234', 'Value': '1234', 'Description': '[[1234]]'}",
        "{'Code': '124', 'Value': '124', 'Description': '124'}",
        "{'Code': '13', 'Value': '13', 'Description': '13'}",
        "{'Code': '134', 'Value': '134', 'Description': '134'}",
        "{'Code': '14', 'Value': '14', 'Description': '14'}",
        "{'Code': '2', 'Value': '2', 'Description': '2'}",
        "{'Code': '23', 'Value': '23', 'Description': '23'}",
        "{'Code': '234', 'Value': '234', 'Description': '234'}",
        "{'Code': '24', 'Value': '24', 'Description': '24'}",
        "{'Code': '3', 'Value': '3', 'Description': '3 or 4 inlet connections and the pattern of their arrangement may vary'}",
        "{'Code': '34', 'Value': '34', 'Description': '34'}",
        "{'Code': '4', 'Value': '4', 'Description': '3 or 4 inlet connections and the pattern of their arrangement may vary'}",
        "{'Code': 'NONE', 'Value': 'NONE', 'Description': 'None'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "InletPatternType" .

ifc:InnerDiameter a owl:DatatypeProperty ;
    rdfs:label "Inner Diameter" ;
