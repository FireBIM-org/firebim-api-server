    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Refrigerant condensing temperature." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "CondensingTemperature" .

ifc:ConditionCommencement a owl:DatatypeProperty ;
    rdfs:label "Condition Commencement" ;
    rdfs:range xsd:string ;
    skos:definition "Condition of property provided on commencement of the agreement e.g. cold shell, warm lit shell, broom clean, turn-key." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConditionCommencement" .

ifc:ConditionDisposalLevel a owl:DatatypeProperty ;
    rdfs:label "Condition Disposal Level" ;
    rdfs:range xsd:string ;
    skos:definition "Condition that will trigger a disposal process" ;
    meta:allowedValue "{'Code': 'HIGH', 'Value': 'HIGH', 'Description': 'High'}",
        "{'Code': 'LOW', 'Value': 'LOW', 'Description': 'Low'}",
        "{'Code': 'MODERATE', 'Value': 'MODERATE', 'Description': 'Moderate'}",
        "{'Code': 'VERYHIGH', 'Value': 'VERYHIGH', 'Description': 'Very High'}",
        "{'Code': 'VERYLOW', 'Value': 'VERYLOW', 'Description': 'Very Low'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConditionDisposalLevel" .

ifc:ConditionHistory a owl:ObjectProperty ;
    rdfs:label "Condition History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Indicates alarm condition over time. The range of possible values and their meanings is defined by [[Pset_AlarmTypeCommon]].Condition. An empty value indicates no present alarm condition." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "ConditionHistory" .

ifc:ConditionMaintenanceLevel a owl:DatatypeProperty ;
    rdfs:label "Condition Maintenance Level" ;
    rdfs:range xsd:string ;
    skos:definition "Condition that will trigger maintenance" ;
    meta:allowedValue "{'Code': 'HIGH', 'Value': 'HIGH', 'Description': 'High'}",
        "{'Code': 'LOW', 'Value': 'LOW', 'Description': 'Low'}",
        "{'Code': 'MODERATE', 'Value': 'MODERATE', 'Description': 'Moderate'}",
        "{'Code': 'VERYHIGH', 'Value': 'VERYHIGH', 'Description': 'Very High'}",
        "{'Code': 'VERYLOW', 'Value': 'VERYLOW', 'Description': 'Very Low'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ConditionMaintenanceLevel" .

ifc:ConditionReplacementLevel a owl:DatatypeProperty ;
    rdfs:label "Condition Re Placement Level" ;
    rdfs:range xsd:string ;
    skos:definition "Condition that will trigger a replacement process" ;
    meta:allowedValue "{'Code': 'HIGH', 'Value': 'HIGH', 'Description': 'High'}",
        "{'Code': 'LOW', 'Value': 'LOW', 'Description': 'Low'}",
        "{'Code': 'MODERATE', 'Value': 'MODERATE', 'Description': 'Moderate'}",
        "{'Code': 'VERYHIGH', 'Value': 'VERYHIGH', 'Description': 'Very High'}",
        "{'Code': 'VERYLOW', 'Value': 'VERYLOW', 'Description': 'Very Low'}" ;
