        "{'Code': 'PHOTOVOLTAIC', 'Value': 'PHOTOVOLTAIC', 'Description': 'Photovoltaic'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "LubricationPowerSupplyType" .

