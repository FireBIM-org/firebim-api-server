ifc:IfcRailingGUARDRAIL a owl:Class ;
    rdfs:label "Guard Rail" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcRailing ;
    skos:definition "A type of railing designed to guard human or vehicle occupants from falling off a stair, ramp or landing where there is a vertical drop at the edge of such floors/landings, or to provide restraint to an errant road vehicle, installed on the central reserve of or alongside a road." ;
