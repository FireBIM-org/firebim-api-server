    rdfs:comment "Technical note: in IFC this property takes 'IfcReal' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "The pressure loss due to friction per unit length. (Data type = PressureMeasure/LengthMeasure)" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "FrictionLoss" .

ifc:Fuel a owl:ObjectProperty ;
    rdfs:label "Fuel" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "The amount of fuel consumed during the period specified in the time series." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "Fuel" .

ifc:FullLoadRatio a owl:ObjectProperty ;
    rdfs:label "Full Load Ratio" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Ratio of actual power to full load power as a quadratic function of part load, at certain condensing and evaporating temperature, FracFullLoadPower = f ( [[PartLoadRatio]])." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "FullLoadRatio" .

ifc:FullLoadRatioCurve a owl:ObjectProperty ;
    rdfs:label "Full Load Ratio Curve" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes a table as its value. That table has two columns (lists), one with definitions and other for defined values. Read the IFC documentation for more information." ;
    rdfs:range xsd:decimal ;
    skos:definition "Ratio of actual power to full load power as a quadratic function of part load, at certain condensing and evaporating temperature, FracFullLoadPower = f ( [[PartLoadRatio]])." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "FullLoadRatioCurve" .

ifc:FullScaleOutput a owl:DatatypeProperty ;
