ifc:IfcDiscreteAccessoryELASTIC_CUSHION a owl:Class ;
    rdfs:label "Elastic Cushion" ;
    rdfs:comment "Technical note: Because this class is a 'Predefined Type' in IFC, meaning a specialisation of its parent class, in IFC it should be represented by the parent class." ;
    rdfs:subClassOf ifc:IfcDiscreteAccessory ;
    skos:definition "A track elastic cushion is a kind of layer set on grooved sides of a concrete base, which is used for mitigating the impact of longitudinal and lateral load on track structures. A track elastic cushion shall only appear in ballastless track structures." ;
