ifc:N_Protection a owl:DatatypeProperty ;
    rdfs:label "N Protection" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "An indication whether the electronic tripping unit has separate protection for the N conductor, or not." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "N_Protection" .

ifc:N_Protection_100 a owl:DatatypeProperty ;
    rdfs:label "N Protection 100" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "An indication whether the electronic tripping unit is tripping if the current in the N conductor is more than 100% of that of the phase conductors. The property is only asserted if the property [[N_Protection]] is asserted." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "N_Protection_100" .

ifc:N_Protection_50 a owl:DatatypeProperty ;
    rdfs:label "N Protection 50" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "An indication whether the electronic tripping unit is tripping if the current in the N conductor is more than 50% of that of the phase conductors. The property is only asserted if the property [[N_Protection]] is asserted." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "N_Protection_50" .

ifc:N_Protection_Select a owl:DatatypeProperty ;
    rdfs:label "N Protection Select" ;
    rdfs:comment "Technical note: in IFC this property takes 'IfcBoolean' as value. Such objects are not included in bSDD for simplicity reason. IFC also doesn't enforce particular units, but recommends using metric SI units (metre, kilogram, etc.). Read the IFC documentation for more information." ;
    rdfs:range xsd:boolean ;
    skos:definition "An indication whether the use of the [[N_Protection]] can be selected by the user or not. If both the properties [[N_Protection_50]] and [[N_Protection_100]] are asserted, the value of [[N_Protection_Select]] property is set to TRUE. The property is only asserted if the property [[N_Protection]] is asserted." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "N_Protection_Select" .

