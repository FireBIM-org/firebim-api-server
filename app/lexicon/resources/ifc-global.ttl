    rdfs:label "Unitary Equipment" ;
    rdfs:subClassOf ifc:IfcEnergyConversionDevice ;
    skos:definition "Unitary equipment typically combine a number of components into a single product, such as air handlers, pre-packaged rooftop air-conditioning units, heat pumps, and split systems." ;
