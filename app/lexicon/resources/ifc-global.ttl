ifc:TotalLatentLoadHistory a owl:ObjectProperty ;
    rdfs:label "Total Latent Load History" ;
    rdfs:comment "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries. Read the IFC documentation for more information." ;
    skos:definition "Total energy added or removed from air that affects its humidity or concentration of water vapor. If a value is less than zero (negative), then the thermal load is lost from the space. If a value is greater than zero (positive), then the thermal load is a gain to the space." ;
    meta:propertyValueKind "Complex" ;
    meta:sourceCode "TotalLatentLoadHistory" .

ifc:TotalPrimaryEnergyConsumption a owl:DatatypeProperty ;
