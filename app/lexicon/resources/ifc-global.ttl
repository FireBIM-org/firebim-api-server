        "{'Code': 'HYDROCARBON', 'Value': 'HYDROCARBON', 'Description': 'Hydrocarbon'}",
        "{'Code': 'HYDROGEOLOGICAL', 'Value': 'HYDROGEOLOGICAL', 'Description': 'Hydrogeological'}",
        "{'Code': 'MINERAL', 'Value': 'MINERAL', 'Description': 'Mineral'}",
        "{'Code': 'NOTDEFINED', 'Value': 'NOTDEFINED', 'Description': 'Not Defined'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'PEDOLOGICAL', 'Value': 'PEDOLOGICAL', 'Description': 'Pedological'}",
        "{'Code': 'SITE_INVESTIGATION', 'Value': 'SITE_INVESTIGATION', 'Description': 'Site Investigation'}",
        "{'Code': 'STORAGE', 'Value': 'STORAGE', 'Description': 'Storage'}",
