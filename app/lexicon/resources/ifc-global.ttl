ifc:IfcCostItem a owl:Class ;
    rdfs:label "Cost Item" ;
    rdfs:subClassOf ifc:IfcControl ;
    skos:definition "An [[IfcCostItem]] describes a cost or financial value together with descriptive information that describes its context in a form that enables it to be used within a cost schedule. An [[IfcCostItem]] can be used to represent the cost of goods and services, the execution of works by a process, lifecycle cost and more." ;
    meta:classType "Class" ;
    meta:hasProperty ifc:Description_from_Attributes,
        ifc:GlobalId_from_Attributes,
        ifc:Identification_from_Attributes,
        ifc:Name_from_Attributes,
        ifc:ObjectType_from_Attributes ;
    meta:parentClassCode "IfcControl" ;
    meta:sourceCode "IfcCostItem" ;
    meta:uid "78610aed-e656-483f-b7d3-8fc99b2c0312" .

