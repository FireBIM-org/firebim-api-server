ifc:PanMounting a owl:DatatypeProperty ;
    rdfs:label "Pan Mounting" ;
    rdfs:range xsd:string ;
    skos:definition "The property enumeration Pset_SanitaryMountingEnum defines the forms of mounting or fixing of the sanitary terminal that may be specified within property sets used to define sanitary terminals (WCs, basins, sinks, etc. A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections.; A floor mounted sanitary terminal that has an integral base.; A sanitary terminal that is installed into a horizontal surface that is installed into a horizontal surface.When applied to a wash hand basin, the term more normally used is vanity. See also Wash Hand Basin [[Type]] specification.; A sanitary terminal cantilevered clear of the floor." ;
    meta:allowedValue "{'Code': 'BACKTOWALL', 'Value': 'BACKTOWALL', 'Description': 'A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections'}",
        "{'Code': 'COUNTERTOP', 'Value': 'COUNTERTOP', 'Description': 'A sanitary terminal that is installed into a horizontal surface that is installed into a horizontal surface'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'PEDESTAL', 'Value': 'PEDESTAL', 'Description': 'A pedestal mounted sanitary terminal that fits flush to the wall at the rear to cover its service connections'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}",
        "{'Code': 'WALLHUNG', 'Value': 'WALLHUNG', 'Description': 'A sanitary terminal cantilevered clear of the floor'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "PanMounting" .

