    skos:definition "Enumeration that identifies the methodology to be used to size system components." ;
    meta:allowedValue "{'Code': 'CONSTANTFRICTION', 'Value': 'CONSTANTFRICTION', 'Description': 'Constant Friction'}",
        "{'Code': 'CONSTANTPRESSURE', 'Value': 'CONSTANTPRESSURE', 'Description': 'Constant [[Pressure]]'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'STATICREGAIN', 'Value': 'STATICREGAIN', 'Description': 'Staticregain'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "DuctSizingMethod" .

