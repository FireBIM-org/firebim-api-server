    rdfs:range xsd:decimal ;
    skos:definition "Quantity characterizing the variation with thermodynamic temperature T of the distance l between two points of a body, under given conditions (IEC 113-04-27). The ratio is defined per Kelvin." ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "ThermalExpansionCoefficient" .

ifc:ThermalIrEmissivityBack a owl:DatatypeProperty ;
