        "{'Code': '100', 'Value': '100', 'Description': '100'}",
        "{'Code': '1000', 'Value': '1000', 'Description': '[[1000]]'}",
        "{'Code': '30', 'Value': '30', 'Description': '30'}",
        "{'Code': '300', 'Value': '300', 'Description': '300'}",
        "{'Code': '500', 'Value': '500', 'Description': '500'}",
        "{'Code': 'NOTKNOWN', 'Value': 'NOTKNOWN', 'Description': 'Not Known'}",
        "{'Code': 'OTHER', 'Value': 'OTHER', 'Description': 'Other'}",
        "{'Code': 'UNSET', 'Value': 'UNSET', 'Description': 'Unset'}" ;
    meta:propertyValueKind "Single" ;
    meta:sourceCode "TrippingUnitReleaseCurrent" .

