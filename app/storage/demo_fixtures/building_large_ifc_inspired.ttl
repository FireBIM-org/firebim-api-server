@prefix fbo: <http://example.org/fbo/1.0/> .
@prefix ex: <https://firebim.org/examples/buildings/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:site-large a fbo:Site ;
    fbo:Name "Large Test Site" ;
    fbo:FireExit true ;
    fbo:hasBuilding ex:building-large-1, ex:building-large-2, ex:building-large-3, ex:building-large-4 .

ex:building-large-1 a fbo:Building ;
    fbo:Name "Large Building 1" ;
    fbo:FireRating "R90" ;
    fbo:BuildingHeight "24.0"^^xsd:decimal ;
    fbo:hasStorey ex:storey-large-1-01, ex:storey-large-1-02, ex:storey-large-1-03, ex:storey-large-1-04 .

ex:storey-large-1-01 a fbo:Storey ;
    fbo:Name "Building 1 Storey 1" ;
    fbo:StoreyNumber 1 ;
    fbo:hasZone ex:zone-large-1-01-a, ex:zone-large-1-01-b ;
    fbo:hasStair ex:stair-large-1-main, ex:stair-large-1-escape ;
    fbo:hasRoom ex:room-large-1-01-01, ex:room-large-1-01-02, ex:room-large-1-01-03, ex:room-large-1-01-04 .

ex:zone-large-1-01-a a fbo:Zone ;
    fbo:Name "Office Zone B1S1A" ;
    fbo:FireCompartmentId "LB1-S1-ZA" ;
    fbo:hasRoom ex:room-large-1-01-01, ex:room-large-1-01-02 ;
    fbo:adjacentToZone ex:zone-large-1-02-a .

ex:zone-large-1-01-b a fbo:Zone ;
    fbo:Name "Mixed Zone B1S1B" ;
    fbo:FireCompartmentId "LB1-S1-ZB" ;
    fbo:hasRoom ex:room-large-1-01-03, ex:room-large-1-01-04 .

