    fbo:OccupancyType "office" ;
    fbo:NumberOfOccupants 3 ;
    fbo:locatedInStorey ex:storey-large-1-01 ;
    fbo:boundedByWall ex:wall-large-1-01-01-a, ex:wall-large-1-01-01-b ;
    fbo:hasWindow ex:window-large-1-01-01-a, ex:window-large-1-01-01-b ;
    fbo:hasFloor ex:floor-large-1-01-01 ;
    fbo:hasCeiling ex:ceiling-large-1-01-01 ;
    fbo:containsSensor ex:sensor-large-1-01-01 .

ex:wall-large-1-01-01-a a fbo:Wall ; fbo:FireRating "EI60" ; fbo:LoadBearing true .
