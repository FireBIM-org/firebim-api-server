@prefix ex1: <https://firebim.org/test-data/dk/three-storey-office-v2/> .
@prefix fbo: <https://firebim.org/ontologies/fbo#> .
@prefix fbo-dk: <https://firebim.org/ontologies/fbo/dk#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex1:adjacency-first a fbo-dk:Adjacency ;
    fbo-dk:adjacencyFrom ex1:fc-f-west ;
    fbo-dk:adjacencyTo ex1:fc-f-east ;
    fbo-dk:adjacencyVia ex1:wall-f-west .

ex1:adjacency-ground a fbo-dk:Adjacency ;
    fbo-dk:adjacencyFrom ex1:fc-g-west ;
    fbo-dk:adjacencyTo ex1:fc-g-east ;
    fbo-dk:adjacencyVia ex1:wall-g-west .

ex1:adjacency-second a fbo-dk:Adjacency ;
    fbo-dk:adjacencyFrom ex1:fc-s-office ;
    fbo-dk:adjacencyTo ex1:fc-s-canteen ;
    fbo-dk:adjacencyVia ex1:wall-s-office .

ex1:dataset rdfs:label "Denmark: three-storey office v2 synthetic graph"@en ;
    fbo:hasDescription "Synthetic graph; it does not represent a real building."@en ;
    fbo:hasRemarks "For software testing only. The office unit is deliberately declared AK2 although its facts derive AK1."@en .

ex1:ground-exit a fbo-dk:Exit ;
    rdfs:label "Ground-floor final exit"@en ;
    fbo-dk:SystemIndependentExit ex1:door-west-exit .

ex1:hose-reel a fbo-dk:HoseReel ;
    rdfs:label "Central stair hose reel"@en ;
    fbo-dk:LengthHosepath "30.0"^^xsd:float .

ex1:office-building a fbo:Building ;
    rdfs:label "FireBIM Harbour Office"@en ;
    fbo:ActiveFireProtection ex1:alarm-system,
        ex1:sprinkler-system,
        ex1:warning-system ;
    fbo:PassiveFireProtection ex1:passive-protection-package ;
    fbo:hasSubitem ex1:bffu-assembly,
        ex1:bffu-office,
        ex1:first-storey,
        ex1:ground-storey,
        ex1:second-storey ;
    fbo-dk:BuildingFireCompartmentDaytimeoccupancy true ;
    fbo-dk:BuildingsectionOffices true ;
    fbo-dk:DistanceToOtherBuildings 14.0 ;
    fbo-dk:DistanceToPropertyLine 8.0 ;
    fbo-dk:HeightBuilding "10.8"^^xsd:float ;
    fbo-dk:PeopleKnowledgeEscaperoutes true ;
    fbo-dk:RiskClass "RK2" ;
    fbo-dk:SystemEvacuationroute ex1:route-first,
        ex1:route-ground,
        ex1:route-second ;
    fbo-dk:TypeProject ex1:project-new-office .

ex1:smoke-alarm-system a fbo-dk:FireSafetyInstallationSmokeAlarmsystem ;
    rdfs:label "Smoke alarm installation"@en .

ex1:smoke-ventilation-system a fbo-dk:AutomaticFireVentilationsystem ;
    rdfs:label "Stair and canteen smoke ventilation system"@en .

ex1:bffu-assembly a fbo-dk:BuildingFunctionalFireUnit ;
    rdfs:label "Assembly section (AK3)"@en ;
    fbo:hasSubitem ex1:fc-g-east,
        ex1:fc-s-canteen,
        ex1:fc-s-office ;
    fbo-dk:AreaBuildingFunctionalFireUnit 501.0 ;
    fbo-dk:BuildingFireCompartmentDaytimeoccupancy true ;
    fbo-dk:ComparableFireRiskConditions true ;
    fbo-dk:CompartmentSleeping false ;
    fbo-dk:HasAutomaticFireAlarmsystem true ;
    fbo-dk:HasAutomaticFireSprinklersystem true ;
    fbo-dk:HasAutomaticFireVentilationsystem true ;
    fbo-dk:HasAutomaticWarningsystem true ;
    fbo-dk:NumberOfBuildingStoreys 3 ;
    fbo-dk:PeopleKnowledgeEscaperoutes false ;
    fbo-dk:PeopleSelfRescueAbility true ;
    fbo-dk:UseCategory "AK3" .

ex1:bffu-office a fbo-dk:BuildingFunctionalFireUnit ;
    rdfs:label "Office section (declared AK2)"@en ;
    fbo:hasSubitem ex1:fc-f-east,
        ex1:fc-f-west,
        ex1:fc-g-west ;
    fbo-dk:AreaBuildingFunctionalFireUnit 477.0 ;
    fbo-dk:BuildingFireCompartmentDaytimeoccupancy true ;
    fbo-dk:ComparableFireRiskConditions true ;
    fbo-dk:CompartmentSleeping false ;
    fbo-dk:HasAutomaticFireAlarmsystem true ;
    fbo-dk:HasAutomaticFireSprinklersystem true ;
    fbo-dk:HasAutomaticFireVentilationsystem false ;
    fbo-dk:HasAutomaticWarningsystem true ;
    fbo-dk:NumberOfBuildingStoreys 3 ;
    fbo-dk:PeopleKnowledgeEscaperoutes true ;
    fbo-dk:PeopleSelfRescueAbility true ;
    fbo-dk:UseCategory "AK2" .

