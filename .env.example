# FireBIM API Server - Local Development Environment Variables
# Copy this file to .env and adjust as needed.

# -- PostgreSQL ---------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firebim

# -- S3 / MinIO --------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=firebim
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=eu-central-1

# -- Celery ------------------------------------
CELERY_BROKER_URL=amqp://firebim:firebim@rabbitmq:5672/firebim
CELERY_RESULT_BACKEND=rpc://

# -- Ontology registry sync --------------------
# Public registry that POST /ontologies/sync pulls from by default (no credentials needed to read it).
# Any URL serving the same JSON format can be passed per request as source_url.
ONTOLOGY_REGISTRY_URL=https://firebim.org/documentation/ontologies/index.json
ONTOLOGY_SYNC_TIMEOUT_SECONDS=120

# -- CORS --------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

CHECKS_SOLVER=standard

# -- Demo content ------------------------------
# Local only: publish the bundled demo graphs and rules at every startup (they overwrite same-id graphs).
# Set to false for a clean, hand-curated workspace: nothing is seeded and deleted items stay deleted.
SEED_DEMO_CONTENT=true

# -- Authentik (OIDC) --------------------------
# This must match the issuer URL configured in the Authentik blueprint
AUTHENTIK_ISSUER_URL=http://localhost:9080/application/o/firebim/
