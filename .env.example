# FireBIM API Server - Local Development Environment Variables
# Copy this file to .env and adjust as needed.

# ── PostgreSQL ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=firebim

# ── S3 / MinIO ─────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=firebim
S3_ACCESS_KEY_ID=minioadmin
S3_REGION=us-east-1

# ── Celery ──────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://

# ── CORS ────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Fuseki / Graph ──────────────────────────────
FUSEKI_HOST=http://graph-demo.firebim.org:3030

# ── Authentik (OIDC) ───────────────────────────
# This must match the issuer URL configured in the Authentik blueprint
AUTHENTIK_ISSUER_URL=http://localhost:9090/application/o/firebim/
