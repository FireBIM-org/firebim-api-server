# FireBIM API Server - Local Development Environment Variables
# Copy this file to .env and adjust as needed.

# -- PostgreSQL ---------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firebim

# -- S3 / MinIO --------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=firebim
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# -- Celery ------------------------------------
CELERY_BROKER_URL=amqp://firebim:firebim@rabbitmq:5672/firebim
CELERY_RESULT_BACKEND=rpc://

# -- Ontology registry sync --------------------
# Public registry that POST /ontologies/sync pulls from by default (no credentials needed to read it).
# Any URL serving the same JSON format can be passed per request as source_url.
ONTOLOGY_REGISTRY_URL=https://firebim.org/documentation/ontologies/index.json
ONTOLOGY_SYNC_TIMEOUT_SECONDS=120

# -- CORS --------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

CHECKS_SOLVER=standard

# -- Demo content ------------------------------
# Local only: publish the bundled demo graphs and rules at every startup (they overwrite same-id graphs).
# Set to false for a clean, hand-curated workspace: nothing is seeded and deleted items stay deleted.
SEED_DEMO_CONTENT=true

# -- Authentik (OIDC) --------------------------
# This must match the issuer URL configured in the Authentik blueprint
AUTHENTIK_ISSUER_URL=http://localhost:9080/application/o/firebim/

# -- Limits and hardening ----------------------
# Request bodies: multipart file uploads (IFC/IDS) and every other body. Larger requests get 413 PAYLOAD_TOO_LARGE.
MAX_UPLOAD_BYTES=524288000
MAX_JSON_BODY_BYTES=52428800
# In-memory rate limits ("<count>/<second|minute|hour|day>"), per process. Requests with a bearer token are
# limited per token (DEFAULT on all routes, EXPENSIVE in addition on uploads, check runs, publish and sync);
# requests without a token per client IP (ANON). Exceeding a limit gives 429 RATE_LIMITED with Retry-After.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_EXPENSIVE=20/minute
RATE_LIMIT_ANON=60/minute
# X-Forwarded-For is only trusted when the direct peer is in one of these networks (k3s pod/service CIDRs).
TRUSTED_PROXY_CIDRS=10.42.0.0/16,10.43.0.0/16,127.0.0.1/32
# Serve /docs, /redoc and /openapi.json.
ENABLE_API_DOCS=true
# Optional allowlist for user-supplied ontology sync source_url hosts (comma list; ".example.org" also matches
# subdomains). Empty = any public host; private, loopback and link-local addresses are always refused.
ONTOLOGY_SYNC_ALLOWED_HOSTS=
# Maximum number of graphs kept in the in-process check execution cache.
CHECK_CACHE_MAX_ENTRIES=32
# Celery task limits in seconds (soft limit must be lower than the hard limit).
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# -- Storage ------------------------------------
# Hard cap on total bytes in the bucket (507 STORAGE_LIMIT_EXCEEDED); 0 disables. Optional per-user cap (0 = off).
STORAGE_HARD_LIMIT_BYTES=1000000000000
STORAGE_USER_QUOTA_BYTES=0
STORAGE_WARN_RATIO=0.8

# -- Admin --------------------------------------
# Authentik group (JWT "groups" claim) that grants admin, plus an optional comma-separated email fallback.
ADMIN_GROUP=firebim-admins
ADMIN_EMAILS=
